{
  "quest.5EDFD69BB6601872.quest_desc": [
    "新气血装配室只能处理I级配方.&a命血祭坛等级卡&r可提高其能制作的祭坛配方等级, 最高IV级.",
    "",
    "&c需要V级祭坛的配方, 例如超凡生命宝珠, 无法用这种方式自动化.",
    "",
    "每张&a并行处理卡&r增加一个同时合成的任务, 最多4个."
  ],
  "quest.2D254A8045093FED.title": "狱火锻炉",
  "quest.191E3A2225AD70FA.title": "感知之躯",
  "quest.5E12FC7FD8720FBA.title": "监工",
  "quest.3F637FF7658CCA33.quest_desc": [
    "&eAnimus&r在已有印记之外增加大量新印记, 同样由各自的&c试剂&r制作.",
    "",
    "先认识几个值得了解的:",
    "",
    "- &c影链印记&r: 将生物捕获为&c生物灵魂&r, 保留生命, 装备, 自定义名称和AI,是搬运重要生物的方便方式.",
    "- &c移位印记&r: 完整拿起方块, 再放到其他位置.",
    "- &c消耗印记&r: 将8格内方块变成扩散的&c反生命&r, 每块25 EV.请远离基地使用.",
    "",
    "影链印记的&c注魂石板&r需要II级祭坛, &c链之试剂&r则要求锻炉宝石中有128点&d灵质&r, 超过微型灵质宝石容量.",
    "",
    "&7&o完整目录请查看术典, 这里不可能列完所有内容.&r"
  ],
  "quest.2507A7FD69022F2C.quest_desc": [
    "在&c灵质坩埚&r中燃烧灵质, 区块空气中的意志就会浓厚起来.用&c灵域测量仪&r读取."
  ],
  "quest.3EC0F38A5F8D01E2.quest_desc": [
    "成为&b命血术士&r后的第一步, 是建造&a命血祭坛&r.",
    "",
    "放在四周都方便靠近的平坦石地上.祭坛自身没有生命源质时, 会从附近未携带&2生命宝珠&r的人身上抽血, 精炼成&bEV&r.它只取所需, 不会致死.",
    "",
    "[\"\",\"进行仪式与献血也会提升你的\",{\"text\":\"魔法技能树\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"action\":\"custom\",\"id\":\"ftbquests:docs\",\"payload\":{\"location\":\"guideme,ftb:skills,ftb:magic.md\"}},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开技能树指南\"}},\".\"]"
  ],
  "quest.19A36A138537D911.quest_desc": [
    "每种神圣仪式都是已有仪式的强化形式, 在原环阵外加一圈&c神圣仪式石&r.它们接受的灵质与原版相同.",
    "",
    "搭建任意神圣仪式, 用圣师激活水晶唤醒, 下一页列出各自功能.",
    "{@pagebreak}",
    "- &c神圣苦难之井&r: 范围32格, 每次伤害产生两倍生命源质.",
    "- &c神圣磨难枢纽&r: 寻找64格内刷怪笼, 战利品判定三次, 每次模拟击杀消耗不到一半EV.",
    "- &c神圣无尽矿场&r: 每次脉冲搬运四倍矿石, 可用仪式配置杖选择精准采集或时运III.",
    "- &c神圣结晶碎裂&r: 在31格宽区域内让晶体以四倍速度生长, 每次收获自带时运III,无需灵质消耗.",
    "- &c神圣促长&r: 未加入灵质时, 范围即为三倍, 脉冲频率两倍.",
    "- &c神圣石匠&r: 每次脉冲放置八倍方块, 体积四倍, 作用距离两倍.",
    "- &c神圣伐林&r: 在41格宽区域内每次最多砍512个方块, 同时补种.",
    "- &c神圣陨星&r: 召唤与陨星仪式相同的陨石, 但所有填充石材都替换为纯矿石."
  ],
  "quest.3198863667151E85.quest_desc": [
    "完整的&c主仪式石&r需要布局图, 大量符文和认真规划, 而&c不完善的仪式石&r只需要上面一块方块和一次右击.",
    "",
    "在石头顶部放一个方块, 再右击, 方块种类决定触发的仪式.仪式石保留, 可重复使用.",
    "",
    "&c远古残骸&r触发&c无垠天空的不完善仪式&r, 每次&c10,000 EV&r换十五分钟创造模式飞行, 可在结束前随时补充.",
    "",
    "约有十几种, 覆盖飞行, 饥饿, 天气, 强化等用途.",
    "",
    "&7&o搭建便宜, 启动昂贵.调用前先检查储备.&r"
  ],
  "quest.22AE6BD2B6F44124.title": "&c血染矫流器",
  "quest.1FB8BF0898FD99D9.quest_desc": [
    "二十四个符文, 四根顶部为&b染血玻璃&r的柱子, 将祭坛升至&cII级&r, 可以制作&c巫师生命宝珠&r.",
    "",
    "II级后, 祭坛从一件工具变成运转的引擎."
  ],
  "quest.6C79D3E7AD6D6766.quest_desc": [
    "用&c升级手册&r将升级铭刻到感知之躯.右击增加一级, 潜行使用则一次加至最大.",
    "",
    "强劲身躯, 修复, 猛烈击打, 矮人之力, 塑造你需要的身体."
  ],
  "quest.3EC0F38A5F8D01E2.title": "提升命血祭坛",
  "quest.1E2F0E34FF11233F.quest_desc": [
    "&c地狱之路&r仪式撕开一道通往&c无尽领域&r的永久大门.",
    "",
    "带齐武器盔甲, 这片领域不会宽容毫无准备的人.",
    "",
    "随着推进, 会出现裂隙开启或深处生物躁动的消息, 意味着矿井入口等新门类型开始可用.开门时若出现对应钥匙选项, 记得选择."
  ],
  "quest.11284BF46CEB2F12.title": "矿物炼金",
  "quest.6639F7B976053020.title": "气血样板",
  "quest.1A22280295ED9A42.title": "坩埚之贪欲",
  "quest.40B51E2F7CFBF442.quest_desc": [
    "将一颗&b钻石&r放在初建祭坛上, 让EV将其转化为第一颗&c见习生生命宝珠&r.",
    "",
    "手持右击绑定自己, 之后就能自愿献出血液.右击已绑定宝珠, 祭坛附近时血进入祭坛, 远处则存在宝珠中, 带回后再倒入."
  ],
  "quest.50941BEEA38BE2C9.quest_desc": [
    "终极命血祭坛, 以&c晶体簇&r冠于柱顶, 巨大的符文环围绕基座.容量和制作能力无与伦比, 由&c圣师生命宝珠&r掌握.",
    "",
    "你曾问力量的代价, 如今已经明白: 一切, 一滴一滴支付, 直到索取与回应成为同一件事."
  ],
  "quest.53F28C95FE1BAF29.quest_desc": [
    "祭坛周围铺八个符文, 升至&cI级&r.从&c空白符文&r起步, 再赋予增容, 速度或献祭等用途.",
    "",
    "I级时, 可将宝珠拿在副手, 击杀生物直接把EV收进自身魂网, 免去割伤自己的血管."
  ],
  "quest.191E3A2225AD70FA.quest_desc": [
    "在束缚阵列上, 用充能宝石绑定铁盔甲, 金属就会苏醒.&c感知盔甲&r起初平凡, 却有一百点成长空间和长久记忆.",
    "",
    "胸甲记录你的一切, 从承受攻击到行走距离和破坏方块."
  ],
  "quest.3F637FF7658CCA33.title": "&cAnimus印记",
  "quest.7CB8720F0CADDD66.quest_desc": [
    "初等宝石容量是微型的四倍, 而下一级几乎需要它全部装满.",
    "",
    "用它锻造&c常见灵质宝石&r, 容量1,024点灵质.",
    "",
    "&e注意&r: 配方要求锻炉宝石中有240点灵质, 几乎等于初等宝石满容量, 实际消耗50点."
  ],
  "quest.457CAD80D2F1DAF4.title": "不朽工具",
  "quest.3FF43BAE10A1FE28.quest_desc": [
    "每种铭文工具都能改变已放仪式石的符文, 这一种制造&c神圣仪式石&r.",
    "",
    "在V级命血祭坛中灌注&c五彩灵质宝石&r, 得到&c铭文工具: 神圣&r, 消耗50,000 EV."
  ],
  "quest.60CD135658A813E5.quest_desc": [
    "&c脆弱激活水晶&r是II级命血祭坛制作的一次性水晶.",
    "",
    "像普通水晶一样绑定, 对主仪式石使用, 启动后即破碎, 很适合只需启动一次的仪式."
  ],
  "quest.31BF04D4FDB8DC2F.quest_desc": [
    "&c命血台桌&r是第一张炼金工作台.放入生命宝珠后, 从自身魂网抽取EV,制作&c奥秘铭刻工具&r, 印记试剂, 早期油膏, 以及两倍矿物加工配方.",
    "",
    "建好它, 后续工艺便从这里展开."
  ],
  "quest.5F8C0F8D4270F154.quest_desc": [
    "灵质调制的黑火药.",
    "",
    "在&c狱火锻炉&r中锻造&c灵粉&r并装进枪械.命中的生物会陷入灵魂受缚, 怪物在圈套中死亡时掉落灵质.",
    "",
    "子弹也会随宝石灵质增强, 以最强要素计算, 从16点灵质时伤害+20%,到4,000点时+80%.",
    "",
    "&e注意&r: 配方要求锻炉宝石至少300点灵质, 因此需要常见灵质宝石或更高等级."
  ],
  "quest.124509FFC6717603.title": "感知魂网",
  "quest.393324AF2EE55949.title": "拆解附魔",
  "quest.0D0A1E61C2384E37.title": "五种要素",
  "quest.0E3D0533331945A1.quest_subtitle": "迟缓的心脏, 只能支撑渺小的身躯.",
  "quest.5E9540650EA59208.title": "&c血弹",
  "quest.2C9A224C8B8436BB.title": "矿井",
  "quest.22AE6BD2B6F44124.quest_desc": [
    "一个整合包里有两套血液系统, 实在不必让它们各自为政.",
    "",
    "在&c狱火锻炉&r中锻造&c血染矫流器&r, 将两者连起来.放上已绑定生命宝珠后, 它将网络EV转为&e邪恶工艺血液&r, 而输入的邪恶工艺血液会直接进入&c命血祭坛&r.",
    "",
    "&7&o如果你一直同步推进邪恶工艺章节, 两条路线终于在此相会.&r",
    "{@pagebreak}",
    "- 将矫流器放在命血祭坛10格内, 它会自动连接; 空手潜行右击重新搜索.",
    "- 手持&c已绑定&r生命宝珠右击, 宝珠会浮在方块上; 空手右击取回.",
    "- 旁边放任意模组流体罐, 即可将网络EV转为血液输入其中, 比例为1 EV/mB,基础速度100 mB/t,祭坛速度符文可加快.",
    "- 反向使用时, 将邪恶工艺血液用管道输入矫流器, 以祭坛正常速率四倍的速度供入相连祭坛."
  ],
  "quest.714730CCF0AC9FD6.quest_desc": [
    "石板本无意义, 直到祭坛赋予它用途.在命血祭坛中将&7深板岩&r转化为&c空白石板&r.",
    "",
    "它是以后几乎所有印记的基底."
  ],
  "quest.0154D0F30F095E63.quest_desc": [
    "晶体触媒可以加快相同要素晶簇的生长, 例如原生触媒用于原生晶簇, 会大幅加速.使用带其他要素的触媒, 则会把生长中的晶体转为对应要素类型."
  ],
  "quest.19E98C84733A5532.title": "早期血液自动化",
  "quest.7CB8720F0CADDD66.title": "共同基础",
  "quest.5DE88B0427A5B039.title": "III级: 法师宝珠",
  "quest.3198863667151E85.title": "&c不完善的仪式",
  "quest.208FAEEF1560A473.title": "&c感知之弓&c与盾",
  "quest.3FF43BAE10A1FE28.title": "铭文工具: 神圣",
  "task.2A007083FA537679.title": "感知进化",
  "quest.3BB1A111D7035936.title": "学徒宝珠",
  "quest.6639F7B976053020.quest_desc": [
    "&eBloodMagic Additions&r让AE2网络执行命血祭坛和命血台桌配方.首先制作&a气血样板&r, 像其他样板一样在样板编码终端中编码.",
    "",
    "每份样板保存一个祭坛或炼金台配方, 制作时从网络流体存储抽取生命源质."
  ],
  "quest.7CB9F4716DEA240C.quest_desc": [
    "灵质浓厚之处, &c恶念结晶坛&r会孕育晶簇.新晶簇随时间吸收灵域中同类灵质生长.形成后可移走, 让结晶坛继续长出更多.",
    "",
    "灵域中该类灵质必须完全饱和, 达到100点, 否则不会生长!"
  ],
  "quest.1DF25DE313F5EA9D.quest_desc": [
    "由牺牲孕育的树.&a气血树苗&r长成&2气血原木&r, 而真正的目标是果实.",
    "",
    "吃下&c气血苹果&r会产生&b生命源质&r, EV进入自身&c魂网&r, 或直接进入附近范围内的&c命血祭坛&r.因此果园虽慢, 却能完全被动地为祭坛补充.",
    "",
    "&c气血核心&r是整套系统的心脏.右击开启, 它会寻找附近草方块和泥土, 种树苗并强制长大, 逐渐铺开一片气血森林.",
    "",
    "每棵成熟气血树都有一个, 用&b精准采集&r开采, 否则只掉普通气血原木.",
    "",
    "&7&o吃苹果时携带已绑定的绑定钥匙, EV会流向钥匙主人, 给队友充魂网最方便.&r"
  ],
  "quest.4E97A41B8084EC3C.title": "圣师激活水晶",
  "quest.402B2E08A12381D4.quest_desc": [
    "&c微型灵质宝石&r只存64点灵质, &c狱火锻炉&r的强力配方需要更多.",
    "",
    "锻造&c初等灵质宝石&r, 容量256点.之后每一级都由前一级锻造.",
    "",
    "&e注意&r: 配方要求锻炉宝石至少60点灵质, 实际消耗20点."
  ],
  "quest.58503249A5084026.title": "激活结晶碎裂仪式",
  "quest.4DD1E69D596D190F.title": "气血装配室",
  "quest.40B51E2F7CFBF442.title": "绑定见习生宝珠",
  "quest.2E5484E8811384DA.quest_desc": [
    "饱和血命果经炼金炉加工, 凝结为&c虚弱气血碎片&r.",
    "",
    "每片可制作四个&c血石砖&r, 作为III级柱顶.碎片还用于更强的油膏和药水触媒, 是后续发展的关键."
  ],
  "quest.4FB5C89723323FA1.quest_desc": [
    "&c感知之剑&r收集灵质远比投掷匕首高效, 并随你提供的意志增多而变强.",
    "",
    "可选, 但很有价值的早期投资."
  ],
  "quest.1AB874D6EADDB75D.title": "空白符文",
  "quest.0AF4B9B8EABB8F9B.quest_desc": [
    "投掷匕首适合已能轻松取胜的战斗, 而&c标枪&r是更重的选择, 有铁, 钻石, 感知和绑定版本.",
    "",
    "&c绑定式标枪&r是顶点.未激活时相当于钻石标枪, 潜行右击唤醒.",
    "",
    "激活后, 每次攻击或投掷消耗50 EV,换来5格半径的近战伤害, 不可损坏和防火, 并会&c献祭&r死在&c命血祭坛&r附近的敌人, 将其直接击杀, EV回流祭坛.",
    "",
    "&7&o在自己祭坛旁战斗, 不再是负担, 而成为目的本身.&r"
  ],
  "quest.1CE38D8CD1B5CA50.title": "印记目录",
  "quest.76CE17956D6DA7A1.title": "意图之环",
  "quest.50941BEEA38BE2C9.quest_subtitle": "如何使用这份力量, 由你决定.",
  "quest.0A7737571F027A95.title": "IV级: 枢机法师宝珠",
  "quest.53F28C95FE1BAF29.title": "I级: 符文之环",
  "quest.3CA9125C16DD3124.quest_desc": [
    "节点放下时自动连接, 若想改连其他主路由节点, 可用节点路由杖手动重连."
  ],
  "quest.2D254A8045093FED.quest_desc": [
    "&c狱火锻炉&r以&c灵质&r为燃料, 那是用匕首从受伤生物身上撕下的残余意志.",
    "",
    "它能制作&c灵质宝石&r, &c感知工具&r, 炸药等, 会不断索取."
  ],
  "quest.4F21AE8F87333085.quest_desc": [
    "血命油是精炼试剂, 可将炼金炉的切削液从基础升为中级, 也是延时和强效油膏的基底, 让刀剑与弓更长久地保持威力.",
    "",
    "它还能制作灵质触媒, 引导灵质结晶生长."
  ],
  "quest.557EBAB98F32B85F.quest_desc": [
    "不必让一切都缓慢死去.&c投掷匕首&r是早期远程武器, 也是灵质体系的起点.",
    "",
    "被匕首伤过的生物死亡时会掉落&c原生灵质&r, 留好."
  ],
  "quest.78481F52005467B2.title": "高等宝石",
  "quest.2E5484E8811384DA.title": "虚弱气血碎片",
  "quest.143B171B2AE08145.quest_desc": [
    "执行&c突破恶魔领域边界&r仪式, 便在帷幕上撕开一次性裂口, 在另一侧建成&c前厅&r.",
    "",
    "走进去, 带上钥匙, 或寻找钥匙的手段."
  ],
  "quest.7C9C13B714FC8ADA.quest_desc": [
    "神圣环阵需要手工摆放大量仪式石.",
    "",
    "制作&c仪式占卜杖[神圣]&r, 它会布置神圣仪式, 并同时铭刻&c神圣仪式石&r."
  ],
  "quest.3BDF260175FFE44F.quest_desc": [
    "恶魔金属精炼为&c狱锻锭&r, 是终局一切造物的骨架."
  ],
  "quest.48784773302B05B5.title": "血命果收获",
  "quest.1AB874D6EADDB75D.quest_desc": [
    "第一阶之后, 每一级&c祭坛&r都按符文数量计算, 而它们全从空白开始.",
    "",
    "&9II级&r需二十四个围绕祭坛, 之后数量不断增加.现在就建立稳定供应, 别每次只做一小把."
  ],
  "quest.1CE38D8CD1B5CA50.quest_desc": [
    "每种命血台桌试剂, 都等待成为一枚印记: 永不枯竭的水, 随取随用的熔岩, 吞噬流体的虚空, 急迫, 磁力和加速生长.",
    "",
    "铭刻适合你的能力."
  ],
  "quest.2507A7FD69022F2C.title": "世界之间的灵域",
  "task.553A5E5210050F3F.title": "空白石板",
  "quest.6181B4122A7D40D9.quest_desc": [
    "感知进化仪式的升级点数上限为500,神圣版本还能更进一步.",
    "",
    "穿着已拥有500升级点数的感知盔甲, 站在&c神圣感知进化&r仪式上, 容量会提高到600,身上每件感知盔甲还会附上&c气血修复&r."
  ],
  "quest.393324AF2EE55949.quest_desc": [
    "附魔是编织之物, 而编织之物也能拆解.",
    "",
    "在炼金炉中放一组普通书, 以及一件附魔物品, 例如盔甲, 工具, 甚至附魔书.坩埚每次将一个附魔干净地剥离, 转移到新书上.",
    "",
    "回收浪费的附魔, 或将珍宝拆开, 随心重新锻造."
  ],
  "quest.7C9C13B714FC8ADA.title": "仪式占卜杖[神圣]",
  "quest.530F5E2E4ADB1BA4.quest_desc": [
    "建造祭坛开始乏味时, I级即可开启&b药水制作&r系统.酿造&c炼金药水瓶&r, 或为&d紫水晶投掷匕首&r添加数十种效果.",
    "",
    "腰间药瓶充足的命血术士, 永远不会真正陷入绝境!"
  ],
  "quest.0AF4B9B8EABB8F9B.title": "&c标枪",
  "quest.5EDFD69BB6601872.title": "提升装配器",
  "quest.5A2BA6A54F83E1BB.title": "&c血染占卜杖",
  "quest.1DF25DE313F5EA9D.title": "&c气血树",
  "quest.1FB8BF0898FD99D9.title": "II级: 巫师宝珠",
  "quest.143B171B2AE08145.title": "突破帷幕",
  "quest.297703FC2EBF8CD8.quest_desc": [
    "晶体不会凭空生长, 而是汲取灵质灵域, 那是按区块计量的无形瘴气, 每种要素上限100.",
    "",
    "在灵质坩埚中燃烧灵质, 可填充区块灵域.投入充能宝石, 散装灵质或任意要素晶体都行.",
    "",
    "用灵域测量仪读取当地浓度, 潜行可查看每种要素0至100的准确数值."
  ],
  "quest.5A2BA6A54F83E1BB.quest_desc": [
    "在I级命血祭坛中灌注仪式占卜杖, 得到&c血染占卜杖&r.",
    "",
    "右击命血祭坛查看等级, 生命源质和加成.手持并看向祭坛时, 会显示下一级所需方块, 潜行右击则从物品栏中放置.",
    "",
    "对主仪式石使用, 可显示仪式名称和状态, 潜行右击关闭仪式."
  ],
  "quest.124509FFC6717603.quest_desc": [
    "第一个印记来自炼金阵列.&c占卜印记&r读取体内魂网, 以及面前祭坛中的EV.",
    "",
    "&c先知印记&r详细读取祭坛, 显示进度, 每刻EV及充能储备, 建设高级祭坛时很有价值.",
    "",
    "无法测量, 就无法管理."
  ],
  "quest.5DE88B0427A5B039.quest_desc": [
    "五十二个符文, 加上四根以&c血石砖&r封顶的柱子, 将祭坛升为&cIII级&r.",
    "",
    "此时可制作&c法师生命宝珠&r, 以及&c仪式占卜杖[暮色]&r."
  ],
  "quest.1A885C9475D37138.title": "五彩灵质宝石",
  "quest.1CE38D8CD1B5CA50.quest_subtitle": "任意一种即可, 之后再逐一收集.",
  "quest.4DD1E69D596D190F.quest_desc": [
    "&d气血装配室&r是气血样板的AE2合成供应设备.放入样板后, 网络即可像普通自动合成一样请求祭坛与炼金配方.",
    "",
    "每次合成200刻, 速度卡可缩短至最低20刻, 一张&a气血加速卡&r相当于四张加速卡."
  ],
  "quest.1A885C9475D37138.quest_desc": [
    "原生, 残毁, 虚无, 复仇和刚毅, 同时围绕一颗下界之星绑定.",
    "",
    "在&c炼金炉&r中制作&c五彩灵质宝石&r, 工具槽放&c圣师生命宝珠&r, 引导加工但不消耗.",
    "",
    "区块中每种灵质必须各有30点, 完成宝石时全部消耗.每件神圣物品都以此宝石为起点, 而且大多消耗一个, 因此准备多做几颗."
  ],
  "quest.5F8C0F8D4270F154.title": "&c灵粉",
  "quest.4FB5C89723323FA1.title": "感知钢铁",
  "quest.2C9A224C8B8436BB.quest_desc": [
    "空间扭曲之后是&c矿井&r入口, &c矿井地城钥匙&r开启深入恶魔金属矿脉的道路.",
    "",
    "盘踞厅堂的恶魔绝非换皮村民, 在战斗中认识它们."
  ],
  "quest.2CB3745D96885DED.title": "注幽石板",
  "quest.19A36A138537D911.title": "&6神圣仪式",
  "quest.470284891D9DBE29.title": "感知长矛",
  "quest.58503249A5084026.quest_desc": [
    "结晶碎裂很适合灵质自动化, 将所有类型晶体的生长速度翻倍, 并自动采收成熟晶体.",
    "",
    "对范围内每个能支付消耗的成熟晶体, 收获时会根据区块原生灵质, 施加逐步提高的时运."
  ],
  "quest.0D0A1E61C2384E37.quest_subtitle": "任意一种要素, 都足以证明工艺.",
  "quest.067E4D25501B94F3.title": "祭礼与仪式",
  "quest.60CD135658A813E5.title": "&c脆弱激活水晶",
  "quest.3BB1A111D7035936.quest_desc": [
    "见习生宝珠很快就耗尽, &c学徒生命宝珠&r容量更高, 抽取更快, 适合切割时不再颤抖的手."
  ],
  "quest.1A22280295ED9A42.quest_desc": [
    "让矿石方块走完炼金炉加工链, 再用命血台桌中的腐化之粉, 将矿石碎块翻倍成矿砂.若把灵质和腐化之粉的加工循环都提升至最高, 矿石到锭的产量可超过普通烧炼的八倍!"
  ],
  "quest.165A563C9EFE232B.quest_desc": [
    "药瓶为你储存效果, &b浸药投掷匕首&r则将效果送进别人的喉咙."
  ],
  "quest.25E6EEE74D627857.quest_desc": [
    "&c狱火锻炉&r的每种神圣锻造, 都要求宝石中有5,000灵质, 超出高等宝石容量.",
    "",
    "锻造&c卓越灵质宝石&r, 容量16,384灵质.",
    "",
    "&e注意&r: 配方要求宝石有4,000灵质, 接近装满的高等宝石, 实际消耗400."
  ],
  "quest.3F263702F010167A.quest_desc": [
    "每位命血术士的造物中心, 都有魔法路由节点构成的脉络, 作为流体, 物品甚至能量的管线与传输控制.一切始于掌控整个网络的主路由节点.",
    "",
    "制作一些中转路由节点和输入/输出节点, 先放主路由节点, 再放其他节点, 它们会自动相连."
  ],
  "task.7089A01D8E2F8FE4.title": "任意附魔书",
  "quest.0D0A1E61C2384E37.quest_desc": [
    "原生意志屈从于目的.使用触媒及魂结恶魔掉落的&c魂结斑粒&r, 原生晶簇可转为四种要素之一, 各有残酷之处, 也各自改变感知工具的行为.",
    "",
    "- &c残毁&r",
    "- &c虚无&r",
    "- &c复仇&r",
    "- &c刚毅&r"
  ],
  "quest.6181B4122A7D40D9.title": "神圣感知进化",
  "quest.25E6EEE74D627857.title": "卓越灵质宝石",
  "quest.4E97A41B8084EC3C.quest_desc": [
    "神圣仪式用&c圣师激活水晶&r启动.",
    "",
    "先在IV级命血祭坛, 用40,000 EV将虚弱激活水晶灌注为&c觉醒激活水晶&r, 再在&c狱火锻炉&r中与五彩灵质宝石一起锻造.",
    "",
    "&e注意&r: 觉醒水晶保留原虚弱水晶的绑定."
  ],
  "quest.402B2E08A12381D4.title": "更大的容器",
  "quest.3BDF260175FFE44F.title": "狱锻钢铁",
  "quest.24E04D4C7C3E7CA4.quest_desc": [
    "开采监工守护的矿脉.&c恶魔金属&r是狱锻金属真正的来源, 也是终极祭坛等级的顶级材料."
  ],
  "quest.76CE17956D6DA7A1.quest_desc": [
    "在命血台桌中酿制&c奥秘铭刻工具&r.",
    "",
    "用它敲击地面, 唤醒力量之环--&c炼金阵列&r.它接受两份供物, 有些组合产出物品, 有些立即改变世界."
  ],
  "quest.5E12FC7FD8720FBA.quest_desc": [
    "某个东西掌控着矿井, 而且从不下班.&c监工&r是被权威膨胀的苦痛恶魔, 拥有六百颗心的怨恨, 以及别人没有的钥匙.",
    "",
    "从它身上拿走&c矿井入口钥匙&r."
  ],
  "quest.7CB9F4716DEA240C.quest_subtitle": "结晶摇篮",
  "quest.11284BF46CEB2F12.quest_desc": [
    "在命血台桌中酿制&c切削液&r, 再溶解矿石.台桌将金属从石头中磨出, 每块矿石得到两份粉, 再烧成成品锭."
  ],
  "quest.6C79D3E7AD6D6766.title": "穿着成长",
  "quest.263045D3780542C0.title": "炼金炉",
  "quest.3C6ED87712D41C45.quest_desc": [
    "&eAnimus&r是&eNeo Vitae&r的附属模组, 不替代已有内容, 而是在同一个&c命血祭坛&r及你已生产的&a生命源质&r之上, 扩展更多命血术.",
    "",
    "&2仇念术典&r记录全部内容, 从新印记, 不完善的仪式, 到气血树, 标枪和感知装备.",
    "",
    "&7&o尽早制作, 后续大多数内容都默认你正翻着它.&r"
  ],
  "quest.0154D0F30F095E63.title": "引导晶体",
  "quest.50941BEEA38BE2C9.title": "V级: 巅峰",
  "quest.78481F52005467B2.quest_desc": [
    "狱火锻炉的某些配方, 例如晶体簇, 所需灵质超过常见宝石容量.",
    "",
    "锻造&c高等灵质宝石&r, 容量4,096灵质.",
    "",
    "&e注意&r: 配方要求宝石有1,000灵质, 因此先充满常见宝石, 实际消耗100."
  ],
  "quest.229B331555E15B4A.quest_desc": [
    "有了暮色占卜杖, &c感知进化仪式&r能将盔甲上限从100提高到300点.&c感知提取&r仪式将升级剥离为手册, 可存入&c感知训练手镯&r."
  ],
  "quest.557EBAB98F32B85F.title": "投掷匕首",
  "quest.48784773302B05B5.quest_desc": [
    "前厅生长着奇异果实, &c虚弱血命果&r是恶魔领域生命力的种子.",
    "",
    "带回家, 培育它.",
    "",
    "虚弱血命果经培育, 饱和后, 成熟为&c饱满血命果&r, 浓郁得足以精炼.",
    "",
    "必须让动物在作物上走动, 它们会持续受伤, 每次受伤都有概率让血命果饱和, 并进化为饱满血命果."
  ],
  "quest.263045D3780542C0.quest_desc": [
    "血命果本身只是潜能, &c炼金炉&r将其精炼, 榨出&c血命油&r, 并将饱和果实转为高级祭坛要求的碎片.",
    "",
    "建造耐心炼金术士的熔炉."
  ],
  "quest.3F263702F010167A.title": "铺设脉络",
  "quest.470284891D9DBE29.quest_desc": [
    "并非每件感知武器都是刀刃.",
    "",
    "在&c狱火锻炉&r中锻造&c感知长矛&r, 像下界合金长矛一样突刺和冲锋, 伤害低半点.与感知之剑一样, 会随携带的灵质增强."
  ],
  "quest.5E9540650EA59208.quest_desc": [
    "弹药会用完, 你的网络通常不会.",
    "",
    "在 I 级命血祭坛上灌注&c附魔子弹改装件&r, 制成&c血弹&r并装入枪械. 每发子弹消耗网络中的 50 EV, 替代实体弹药, 因此即使没有子弹也能装填枪械.",
    "",
    "网络无法支付消耗时, 枪械会改用你持有的实体子弹装填."
  ],
  "quest.24E04D4C7C3E7CA4.title": "恶魔金属",
  "quest.0A7737571F027A95.quest_desc": [
    "一百个符文, 四角放狱锻块, 将祭坛升至&cIV级&r, 解锁&c枢机法师生命宝珠&r及命血术中最具破坏力的仪式."
  ],
  "quest.0E3D0533331945A1.quest_desc": [
    "锻造主路由节点核心, 拓宽网络脉络, 提高每次传输的物品, 流体和能量; 速度核心则提高频率.装入主路由节点, 按需要叠加, 足够强的网络转瞬便能搬空海洋."
  ],
  "quest.067E4D25501B94F3.quest_desc": [
    "仪式需要一颗心.中央放&c主仪式石&r, 用&c仪式占卜杖&r标记周围次级仪式石, 再用&c虚弱激活水晶&r点燃仪式.",
    "",
    "从苦难之井, 促长到无尽矿场, 环阵代替你完成原本需要献血的劳作.",
    "",
    "&a仪式配置杖&r设置仪式的作用距离与区域."
  ],
  "quest.53F28C95FE1BAF29.quest_subtitle": "祭坛升级",
  "quest.2CB3745D96885DED.quest_desc": [
    "后期命血术需要更强的石板.",
    "",
    "在IV级命血祭坛中, 将注灵石板转为&c注幽石板&r, 消耗30,000 EV.",
    "",
    "V级柱顶的晶体簇, 卓越灵质宝石, 神圣工具和仪式占卜杖[神圣],都需要它."
  ],
  "quest.1E2F0E34FF11233F.title": "地狱之路",
  "quest.19E98C84733A5532.quest_desc": [
    "尖刺陷阱在命血祭坛8格内伤害实体时, 会为祭坛供血.制作一个开始被动收集, 再用刷怪笼等方式提供敌人.",
    "",
    "顶部放涡流阵列很适合聚怪, 附近的收集阵列则可拾取掉落物."
  ],
  "quest.208FAEEF1560A473.quest_desc": [
    "&c狱火锻炉&r能制作的不止一把剑.",
    "",
    "&c感知之弓&r每次击杀都会掉落与你调谐类型相符的&d灵质&r, 从远处加入与剑相同的收集循环.",
    "",
    "&c感知之盾&r耐久是普通盾牌四倍, &c1,344&r对比&c336&r; 格挡时还会根据可用&d灵质&r施加效果.",
    "",
    "只要主手或副手持有, 还能将来自&a所有&r来源的&d灵质&r获取提高&c30%&r, 因此即使没人向你射击, 也值得携带."
  ],
  "quest.3C6ED87712D41C45.title": "&c仇念术典",
  "quest.457CAD80D2F1DAF4.quest_desc": [
    "炼金炉会磨损工具, 但每种都有永不磨损的神圣版本.",
    "",
    "用同类最高级工具, 五彩灵质宝石和注幽石板, 在&c狱火锻炉&r中锻造任意&c神圣工具&r.锻炉宝石至少需要5,000灵质, 因此要卓越灵质宝石.",
    "",
    "神圣工具不消耗耐久, 每完成一次炼金炉或命血台桌操作, 从主人网络抽取50 EV."
  ],
  "quest.6F13D27CE61DC87A.quest_desc": [
    "狱锻零件可将符文提升至最高, 升级后提供给祭坛的效果翻倍."
  ]
}
