{
  "quest.7F0A4B19ED4DF750.quest_desc": [
    "Incendium八种生物群系中的五种, 分别前往探访."
  ],
  "quest.18DE042E91A96693.quest_desc": [
    "陵墓, 黑色螺旋塔, 闹鬼废墟, 凋灵洞窟和腐朽神庙中, 都藏着&c鲜血商人&r.",
    "",
    "出售: Neo Vitae符文与试剂, 邪恶工艺的暗黑宝石和血蜡煤炭, 以及血能传送珍珠.",
    "{@pagebreak}",
    "&b位置: &r陵墓, 黑色螺旋塔(Explorify),闹鬼废墟, 凋灵洞窟, 腐朽神庙(ATI)",
    "",
    "&d解锁: &r获得Ara Vitae"
  ],
  "quest.167F48E2584A3022.title": "&c莫格与古尔格",
  "quest.506CE8202884EF43.quest_desc": [
    "共鸣模组的末地生物群系, 遍布巨大的晶洞和紫水晶尖塔."
  ],
  "quest.7638D24AFD676A7F.quest_desc": [
    "Moog的丛林神庙比原版大得多, 宝库前还有一道谜题.",
    "",
    "解开谜题, 就有不小的机会获得不死图腾或附魔金苹果."
  ],
  "quest.15DA8CCB11B85EA6.quest_desc": [
    "寻找地表的石头神庙, 其下的竖井通往约47格深处的大型地牢.",
    "",
    "战利品箱分为五个等级, 传说级有机会开出神级盔甲和工具, 附魔等级远超通常上限.",
    "",
    "&c有些箱子连接了TNT陷阱."
  ],
  "quest.170CF50988CB58E6.quest_desc": [
    "天空竞技场漂浮在y=120至y=170之间.它们类似试炼密室, 试炼刷怪笼会掉落用于开启宝库的试炼钥匙.",
    "",
    "宝库中有钻石装备和涡流盔甲纹饰, 并且必定有不祥之瓶."
  ],
  "quest.5AB13D8A178233DD.quest_desc": [
    "这里的要塞经过重建, 遍布刷怪笼, 图书馆和军械库, 末地传送门房间仍然在底部等待着你.",
    "",
    "和往常一样, 末影之眼会引导你前往."
  ],
  "quest.388CACAF16133436.quest_desc": [
    "黄色, 橙色和黑色地面环绕湖泊, 其间分布着岩浆和喷气孔.小心脚下."
  ],
  "quest.409A27E9A4A6941D.quest_desc": [
    "抽到逆位的死神塔罗牌后, 每次夜幕降临都有15%的概率迎来&c死神&r本人.",
    "",
    "他有1,000点生命, 每次受到的伤害最多16点, 掉落死神兜帽, 长袍, 鞋子和镰刀."
  ],
  "quest.34FF9A882AA4ABCB.title": "&3远古城市",
  "quest.55B3900E2E519129.quest_desc": [
    "小型船只和远古船舰中住着&9豪侠&r.",
    "",
    "出售: Iron的武备与巧械的枪械, 弹药和枪械改装件, 以及TNT和战利品箱.",
    "{@pagebreak}",
    "&b位置: &r小型船只(MVS),远古船舰(ATi)",
    "",
    "&d解锁: &r击败枪手, 或赢得枪手决斗事件"
  ],
  "quest.7F59F90B1B6F9A67.title": "&b冰龙",
  "quest.7AE9316511656205.quest_subtitle": "旅人, 珠宝商和驯兽师",
  "quest.4E77F883F5F8C4E7.quest_subtitle": "军需官, 机械师, 杂货商和养蜂人",
  "quest.20393692539B1184.quest_desc": [
    "悚怖陵墓矗立在积雪生物群系中, 内部遍布悚怖生物刷怪笼.带来钥匙之前, 大门始终紧锁."
  ],
  "quest.19ADE41D01CF22B7.title": "&d电龙",
  "quest.7465320331494BD7.title": "&6龙穴",
  "quest.6B87A87B53F85BD4.title": "&9月光针叶林",
  "quest.21D5042B16907B90.quest_desc": [
    "石头地牢的水下版本, 位于海床下方y=-24至y=24之间, 由守卫者, 溺尸和流浪者刷怪笼守护.",
    "",
    "它的战利品箱在通常五个等级的基础上, 额外加入海洋装备."
  ],
  "quest.269CA7E3614C0826.quest_desc": [
    "海蟒在开阔海域狩猎, 会跃起攻击船只, 远古海蟒的生命可达270点."
  ],
  "quest.5758A01C78625749.quest_desc": [
    "在女巫小屋, 红树林小屋, 小型沼泽房屋和黑森林聚落中寻找&2隐居女巫&r.",
    "",
    "出售: 巫术和根源魔法的用品, 包括巫术植物种子, 巫媒, 巫毒娃娃, 仪式粉笔和转生粉.",
    "{@pagebreak}",
    "&b位置: &r女巫小屋(Terralith),红树林小屋(Explorify),小型沼泽房屋(MVS),黑暗聚落(Explorify)",
    "",
    "&d解锁: &r获得巫术指南或翠绿嫩枝"
  ],
  "quest.2965565D68C9761B.quest_desc": [
    "一艘载有监守者的沉船, 还有十一个箱子可供搜刮."
  ],
  "quest.7B828C91840C23A5.quest_desc": [
    "&c悬浮烈狱&r是一只拥有700点生命, 20点护甲的烈焰人, 还携带不死图腾, 因此要做好击杀两次的准备.",
    "",
    "它会掉落两件&eIncendium&r神器."
  ],
  "quest.4FE64D008CCF0CA2.title": "&b空岛",
  "quest.250945907CE6EA9D.quest_desc": [
    "龙死亡时不会直接掉落物品.右击尸体收获, 每次都会获得新的东西.",
    "",
    "先是龙鳞和龙血, 所以记得带玻璃瓶; 随后是龙骨和龙心, 最后一次收获会得到龙头骨."
  ],
  "quest.693BD17350005AC9.title": "&d蛇发女妖首级",
  "quest.15DA8CCB11B85EA6.title": "&a石头地牢",
  "quest.1F842D40F39C5763.quest_desc": [
    "深海中最大的废墟, 溺尸试炼刷怪笼守卫着装有三叉戟, 钻石装备和海岸盔甲纹饰的箱子."
  ],
  "quest.1F842D40F39C5763.title": "&3水下城市",
  "quest.409A27E9A4A6941D.title": "&c死神",
  "quest.7D5121F9B867A99D.quest_desc": [
    "&c雷霆君王&r拥有350点生命和10点护甲, 召唤风暴期间受到的伤害减半.",
    "",
    "他会掉落整套王室盔甲和雷霆王戟."
  ],
  "quest.42348582DFB34EA1.quest_desc": [
    "Incendium重塑了下界, 保留原版五种生物群系, 并加入八种新群系."
  ],
  "quest.7AE9316511656205.quest_desc": [
    "Explorify的酒馆是旅途中最热闹的落脚点, 里面有四位店主.",
    "",
    "- &6旅人&r: 旅行装备, 包括传送石碑, 传送卷轴, 指南针, 滑翔伞和跑鞋.",
    "- &d珠宝商&r: 神化的印记, 宝石盒, 典籍和工匠卷轴.",
    "- &c驯兽师&r: 刷怪场部件, 实用塔, 刷怪笼符文和刷怪笼.",
    "",
    "旅人出售&a自然罗盘&r和&2结构罗盘&r, 能帮你找到本章其他地点.",
    "{@pagebreak}",
    "&b位置: &r酒馆(Explorify)",
    "",
    "&d解锁: &r",
    "&6旅人&r--获得传送石, 滑翔伞, 自然罗盘或结构罗盘",
    "&d珠宝商&r--建造珠宝饰品工作台",
    "&c驯兽师&r--制作异兽手记"
  ],
  "quest.73127D9218A217CB.title": "&c九头蛇",
  "quest.7F209ECB076B2B30.quest_desc": [
    "世界中遍布建筑, 本章列出值得专程探访的地点.准备迎接地牢, 首领竞技场, 以及别处找不到的战利品.",
    "",
    "&a结构罗盘&r能指向你选择的建筑类型中, 10,000格范围内最近的一座.本章大多数任务只需进入对应建筑即可完成.",
    "",
    "&c龙, 塞壬, 独眼巨人及其他危险的冰火传说生物, 都不会在世界出生点2,000格内生成."
  ],
  "quest.30C87E5D353137F6.quest_desc": [
    "主世界大多数区域的地下都藏着恶魔雕像.用绿宝石和&a精华&r与其交易, 可获得&2耐力容器&r, 提高滑翔伞耐力上限.",
    "",
    "如果改变主意, 它也会回购容器."
  ],
  "quest.42348582DFB34EA1.title": "&c下界",
  "quest.6EFD9C957BD47563.quest_desc": [
    "悚怖尸巫游荡在积雪生物群系中, 有十分之一概率掉落&b陵主之钥&r, 用来打开陵墓的锁孔.",
    "",
    "内部箱子有机会装着冰龙心脏."
  ],
  "quest.6933686D0F959FAA.title": "&c火龙",
  "quest.6933686D0F959FAA.quest_desc": [
    "栖息地中的龙约有1,100至1,200点生命, 火龙吐息还会点燃你周围的地面."
  ],
  "quest.7638D24AFD676A7F.title": "&a丛林神庙",
  "quest.569357C95D1210AA.quest_desc": [
    "海床上已经存在一些&eNautec&r传送门, 各自坐落在开阔海洋中的小型海晶石平台上, 全部使用相同的四色地址.",
    "",
    "空手右击鳍片可查看地址.建造自己的传送门, 并染成相同颜色, 就能传送过去."
  ],
  "quest.15C698B306B3B577.title": "&c独眼巨人",
  "quest.24D8E1226694FEED.title": "&c半羊人",
  "quest.506CE8202884EF43.title": "&d结晶末地",
  "quest.1BF72D9D4ECB46B8.quest_desc": [
    "下界神庙的稀有箱子必定有下界合金升级模板, 能省去大量寻找堡垒遗迹的时间."
  ],
  "quest.1D86C25D8DDA3F1E.title": "&c下界竞技场",
  "quest.1D96D2FF800AE80A.title": "&3海洋神庙",
  "quest.15C698B306B3B577.quest_desc": [
    "&c独眼巨人&r有250点生命, 攻击力很高.箭射中眼睛可使其失明, 穿着整套拟羊伪装潜行时, 它也无法发现你."
  ],
  "quest.4FE64D008CCF0CA2.quest_desc": [
    "漂浮在海洋上方的岛屿, 带有湖泊和瀑布.Terralith有春, 夏, 秋, 冬四种版本, 任意一种都算数.",
    "",
    "&a自然罗盘&r可按名称寻找任意生物群系, 旅人出售它."
  ],
  "quest.693BD17350005AC9.quest_desc": [
    "&c蛇发女妖&r的凝视会将你石化.下去之前, 戴上&a眼罩&r或喝下失明药水, 镜子没有用.",
    "",
    "她有120点生命, 并且必定掉落首级."
  ],
  "quest.2C3ED0622537D3DD.title": "&c巨型要塞",
  "quest.6B9AD6056DC2E540.quest_desc": [
    "独眼巨人洞穴生成在沙滩上, 独眼巨人也会在平原和草甸游荡."
  ],
  "quest.1FF99FC384C22A24.quest_desc": [
    "末地最大的藏宝地, 由潜影贝驻军守卫, 内有十四个末地城宝箱."
  ],
  "quest.40892A92CA977BA0.quest_desc": [
    "火山斜坡上分布着熔岩泉, 岩浆沿山体流下."
  ],
  "quest.502E257ED1246812.quest_desc": [
    "九头蛇洞穴位于沼泽和红树林沼泽中."
  ],
  "quest.7465320331494BD7.quest_desc": [
    "最古老的龙沉睡在地下深处y=-24至y=5之间的洞穴中, 守着远超地表巢穴的宝藏.",
    "",
    "&c洞穴中的龙可能有近2,500点生命."
  ],
  "quest.21D5042B16907B90.title": "&3深板岩地牢",
  "quest.2B5ECE4CD3F8412B.title": "&3鱼贩",
  "quest.170CF50988CB58E6.title": "&a天空竞技场",
  "quest.2913824ED3340F93.title": "&3海蓝科技废墟",
  "quest.1A235CAF42A6F6A0.title": "&5遥远末地",
  "quest.34FF9A882AA4ABCB.quest_desc": [
    "这里的远古城市是重制后的大型版本, 箱子中有回响碎片, 附魔金苹果和幽静盔甲纹饰.",
    "",
    "幽匿尖啸体会召来监守者."
  ],
  "quest.342991AE8AC9BC34.title": "&c禁忌城堡",
  "quest.5EBF7DD6E28CBBCD.quest_desc": [
    "Dungeon 爬行的地牢向下延伸五层, 最深层为下界主题.刷怪笼生成的生物带有武装, 而密室中藏着一些最好的箱子.",
    "",
    "宝库会提供成组的黄金, 偶尔还有附魔金苹果."
  ],
  "quest.124F536BB57E1365.quest_desc": [
    "&c塞壬&r的歌声会把你引向她, 戴上&a耳塞&r就能免受影响.",
    "",
    "塞壬掉落塞壬之泪和闪光鳞片."
  ],
  "quest.342991AE8AC9BC34.quest_desc": [
    "灰烬荒原深处矗立着&eIncendium&r最大的建筑, 由猪灵蛮兵和烈焰哨兵驻守, 展台上陈列着猩红匕首或献祭巨剑."
  ],
  "quest.1BF72D9D4ECB46B8.title": "&c下界神庙",
  "quest.569357C95D1210AA.title": "&3沉没的传送门",
  "quest.49A2DD994F720F84.quest_desc": [
    "石头地牢的下界版本, 位于y=24至y=90之间.烈焰人, 凋灵骷髅和猪灵蛮兵刷怪笼, 守卫着独有的高价值战利品."
  ],
  "quest.203E01E473B7DCFA.title": "&c角魔狩猎者",
  "quest.33D0A75727D9CB58.quest_subtitle": "守门人与赌徒",
  "quest.656B7E686D7EBBE4.title": "&b雷霆王庭",
  "quest.49A2DD994F720F84.title": "&c下界地牢",
  "quest.7F59F90B1B6F9A67.quest_desc": [
    "冰龙吐息会冻结接触的一切, 也包括你.保持移动, 别让它将你冻在原地."
  ],
  "quest.5758A01C78625749.title": "&2隐居女巫",
  "quest.57A55BDA10B81ACB.title": "&d末地",
  "quest.57A55BDA10B81ACB.quest_desc": [
    "主岛之外, 大多数末地外岛属于Nullscape和共鸣的生物群系."
  ],
  "quest.5A03706C37C733CE.title": "&d奥术师",
  "quest.5AB13D8A178233DD.title": "&a要塞",
  "quest.4E77F883F5F8C4E7.quest_desc": [
    "店主会在适合各自身份的地点营业.进入村庄时, 最多会有四位店主到来, 每位都会在聊天栏发一条消息.空手右击店主即可打开商店.",
    "",
    "- &b军需官&r: 背包与存储升级, 抽屉, 以及AE2和精致存储的入门部件.",
    "- &c机械师&r: 科技模组的机器部件, 以及无限存储元件.",
    "- &a杂货商&r: 种子, 作物, 农场动物刷怪蛋和厨房工具.",
    "- &6养蜂人&r: 蜜蜂笼, 蜂巢和蜂箱升级.养蜂人只会出现在平原, 向日葵平原, 草甸和热带草原生物群系的村庄.",
    "{@pagebreak}",
    "&b位置: &r村庄",
    "",
    "&d解锁: &r",
    "&b军需官&r--升级一个背包或存储箱",
    "&c机械师&r--制作任意基础电路",
    "&a杂货商&r--吃任意食物",
    "&6养蜂人&r--用蜜蜂笼捕获一只蜜蜂"
  ],
  "quest.1754F4058CB200D4.title": "&d寻龙杖",
  "quest.19ADE41D01CF22B7.quest_desc": [
    "电龙吐息会召下闪电.它们是三种龙中分布最广的, 因此你很可能最先遇到."
  ],
  "quest.33D0A75727D9CB58.title": "&6庄园商人",
  "quest.46EEC36A2FA7A0D0.title": "&d蜃楼群岛",
  "quest.388CACAF16133436.title": "&6黄石国家公园",
  "quest.250945907CE6EA9D.title": "&6收获巨龙战利品",
  "quest.203E01E473B7DCFA.quest_desc": [
    "用染血干草搭建柳条人, 再用打火石点燃, &c角魔狩猎者&r就会应召而来.",
    "",
    "他有150点生命, 掉落狩猎者之矛."
  ],
  "quest.1754F4058CB200D4.quest_desc": [
    "&d寻龙杖&r指向最近的龙, 升级后范围会从150格提高到300格.",
    "",
    "它只能找到已加载区块中的龙, 因此应边移动边使用."
  ],
  "quest.656B7E686D7EBBE4.quest_desc": [
    "雷霆王庭生成于平原, 草甸和森林, 每座都有一位&c雷霆君王&r."
  ],
  "quest.7F0A4B19ED4DF750.title": "&c下界荒野",
  "quest.7EE3B916522A9170.title": "&a蛇发女妖神庙",
  "quest.5EBF7DD6E28CBBCD.title": "&aDungeon 爬行",
  "quest.2B5ECE4CD3F8412B.quest_desc": [
    "水下神庙中有&3鱼贩&r的商店.",
    "",
    "出售Starcatcher渔具和鱼饵, 海蓝科技部件和细菌培养物, 以及鱼缸.",
    "",
    "记得带上水下呼吸手段.",
    "{@pagebreak}",
    "&b位置: &r水下村庄神庙, 完整, 破损或废墟版本均可",
    "",
    "&d解锁: &r钓到一条鱼"
  ],
  "quest.7AE9316511656205.title": "&6酒馆常客",
  "quest.1D86C25D8DDA3F1E.quest_desc": [
    "下界版试炼密室, 由凋灵骷髅, 烈焰人和岩浆怪试炼刷怪笼守护宝库.",
    "",
    "稀有的巨龙竞技场中, 宝库可能装有沉重核心."
  ],
  "quest.7B828C91840C23A5.title": "&6悬浮烈狱",
  "quest.7D5121F9B867A99D.title": "&6雷霆君王",
  "quest.2C3ED0622537D3DD.quest_desc": [
    "可能出现在下界任意位置的巨型要塞, 箱子中有机会获得下界合金锭和升级模板."
  ],
  "quest.319428452110100A.quest_desc": [
    "Moog的巨型船只漂浮在末地外岛, 由凋灵骷髅船长掌舵.",
    "",
    "它们的物品展示框中有鞘翅, 因此是末地城之外的另一种鞘翅来源."
  ],
  "quest.6EFD9C957BD47563.title": "&b陵主之钥",
  "quest.120E37CE2AB140FA.title": "&c炼狱祭坛",
  "quest.7063420D36849583.quest_desc": [
    "塞壬岛从开阔海面升起, 往往还没看见岛, 就先听见了歌声."
  ],
  "quest.120E37CE2AB140FA.quest_desc": [
    "炼狱祭坛位于炼狱沙丘, 向上扔一颗下界之星即可召唤其守护者."
  ],
  "quest.269CA7E3614C0826.title": "&c海蟒",
  "quest.6A7DB2334016638A.quest_desc": [
    "成年龙会在地表的宝藏堆上筑巢.火龙生活在沙漠和火山地带, 冰龙在积雪生物群系, 电龙则在丛林, 恶地, 热带草原和沼泽.",
    "",
    "火龙和冰龙夜间睡觉, 电龙则在白天睡觉, 第一次攻击会将它们唤醒."
  ],
  "quest.1A235CAF42A6F6A0.quest_desc": [
    "Nullscape在虚空中的三种生物群系.",
    "",
    "- &0暗影之地&r: 黑石和玄武岩地面, 生长骨树.",
    "- &7虚空荒原&r: 几乎只有裸露的末地石.",
    "- &b水晶山峰&r: 遍布水晶结构."
  ],
  "quest.24D8E1226694FEED.quest_desc": [
    "&c半羊人&r通过需要女巫帽的炼锅药酿召唤.他有500点生命, 战斗分为三个阶段, 掉落半羊人之瓮."
  ],
  "quest.502E257ED1246812.title": "&a九头蛇洞穴",
  "quest.25975DB5C7ADE870.quest_desc": [
    "每座海洋神庙和海底神殿都有&c远古守卫者&r守护.它的诅咒会降低挖掘速度, 因此拆墙前先杀掉它."
  ],
  "quest.18DE042E91A96693.title": "&c鲜血商人",
  "quest.30C87E5D353137F6.title": "&a恶魔雕像",
  "quest.33D0A75727D9CB58.quest_desc": [
    "庄园和大理石城堡中, 有本包最昂贵的商店.",
    "",
    "- &6守门人&r: 传送门珍珠, 试炼钥匙和Apothic入侵者召唤器.",
    "- &6赌徒&r: 出售25至750硬币的战利品箱, 只有你自己开过一个战利品箱后, 他才会交易.",
    "",
    "{@pagebreak}",
    "&b位置: &r庄园, 大理石城堡(ATi)",
    "",
    "&d解锁: &r",
    "守门人--获得一个传送门,",
    "赌徒--打开一个战利品箱"
  ],
  "quest.6A7DB2334016638A.title": "&6龙巢",
  "quest.20393692539B1184.title": "&b悚怖陵墓",
  "quest.7F209ECB076B2B30.title": "&6探索",
  "quest.167F48E2584A3022.quest_desc": [
    "向大地精守护者雕像献上下界之星, &c莫格&r和&c古尔格&r就会一同到来, 各有400点生命.",
    "",
    "它们掉落莫格箭袋和古尔格腰带."
  ],
  "quest.7EE3B916522A9170.quest_desc": [
    "蛇发女妖神庙位于沙滩上, 女妖藏在地下室中, 要通过机关活板门进入."
  ],
  "quest.2965565D68C9761B.title": "&3远古船舰",
  "quest.2913824ED3340F93.quest_desc": [
    "海床上散布着小型暗海晶石废墟, 每个拱门中都留有可工作的&a海蓝催化器&r.它就是你的第一束激光, 也是&eNautec&r激光合成的起点.",
    "",
    "将其拆下带回家.旁边的&a生锈的板条箱&r装有&2海晶石激光中继器&r等部件, 但锁已锈死.将箱子丢进&2蚀刻酸&r中清理, 再像普通箱子一样打开干净的&a板条箱&r.刷扫废墟周围的&a可疑的沙砾&r也能找到相同部件."
  ],
  "quest.1FF99FC384C22A24.title": "&d末影堡庭院",
  "task.6BADEBBA351BFE5C.title": "任意飞龙颅骨",
  "quest.4E77F883F5F8C4E7.title": "&6村庄商人",
  "quest.6B87A87B53F85BD4.quest_desc": [
    "一片蓝色花朵组成的森林, 地面上生长着紫水晶."
  ],
  "quest.1D96D2FF800AE80A.quest_desc": [
    "Moog的海洋神庙坐落在深海海床, 宝库有四分之一概率装着海洋之心."
  ],
  "quest.7063420D36849583.title": "&a塞壬岛",
  "quest.46EEC36A2FA7A0D0.quest_desc": [
    "远在深海中的岛屿, 长满魔法树木和巨型蘑菇."
  ],
  "quest.25975DB5C7ADE870.title": "&c远古守卫者",
  "quest.6B9AD6056DC2E540.title": "&a独眼巨人洞穴",
  "quest.124F536BB57E1365.title": "&c塞壬",
  "quest.55B3900E2E519129.title": "&9豪侠",
  "quest.40892A92CA977BA0.title": "&c火山山峰",
  "quest.5A03706C37C733CE.quest_desc": [
    "Terralith的法师塔和法师建筑群中住着&d奥术师&r.",
    "",
    "出售魔法艺术的试剂, 符文, 法师盔甲和亲和典籍, 以及一些心之容器的生命物品.",
    "{@pagebreak}",
    "&b位置: &r法师塔, 法师建筑群(Terralith)",
    "",
    "&d解锁: &r获得温特姆粉"
  ],
  "quest.319428452110100A.title": "&d巨型船只",
  "quest.73127D9218A217CB.quest_desc": [
    "&c九头蛇&r有550点生命.每砍掉一个头, 会长回两个, 最多九个; 只要没在燃烧, 它就会恢复生命.",
    "",
    "点燃它, 并让它持续燃烧."
  ],
  "task.52CD1A19C7C03226.title": "前往任意空岛生物群系"
}
