{
  "task.723B25C8404ECDE6.title": "击杀任意&5魔法艺术守护者&r或&5巫术首领&r",
  "quest.74EBD1E63235A9E7.title": "&d束缚精华",
  "quest.686C88AC0EAC0580.quest_desc": [
    "通过&6FTB天际号&r发射&a星图&r.&a巨兽心智&r也需要它们."
  ],
  "quest.0F00A9F0A7B3E5AB.title": "&9反物质",
  "quest.271D33449195EF70.title": "&c第四阶段: 巨兽之心",
  "quest.3AD6C1611BE808AC.title": "&cFeed The Beast",
  "quest.6AA6C01368D6E51F.quest_desc": [
    "&a符文板&r在&2工作台&r制作, 每次两个, 需要&a艾斯尼姆锭&r, &a纯净温特姆粉&r, &a生长粉末&r, 一个&a暗黑能量宝石&r和一个&a日光石&r.",
    "",
    "&a纯净温特姆粉&r需要&2蓝色兰花&r和沙漠新星.可用&eLTX&r的&a生物科技园艺机&r, 或&eFTB工业奇械&r的&2水培加速器&r种植, 避免手工采集."
  ],
  "quest.207C8D7ECDE970C7.title": "&b逻辑晶格",
  "quest.0F00A9F0A7B3E5AB.quest_desc": [
    "燃料核心在&eLTX&r的&2组装机&r制作, 每次都需要&a反物质&r.",
    "",
    "反物质来自&eFTB工业奇械&r的&a反物质制造机&r, 每个都消耗大量能量.加入&a废料&r或&2废料盒&r可以加速."
  ],
  "quest.3ED3A5C17426409C.quest_desc": [
    "通过&6FTB天际号&r发射&a存储矩阵&r.&a认知阵列&r也需要它们."
  ],
  "quest.75377F96CF3D0542.quest_desc": [
    "&a束缚精华&r在&eNeo Vitae&r的&2狱火锻炉&r制作, 每次两个.锻炉会消耗恶魔意志, 记得在附近准备充足储备."
  ],
  "quest.3424B583F08C904E.title": "&9充能电池",
  "quest.43254C6DA652CD80.quest_desc": [
    "制作&a巨兽之魂&r需要&2灵魂契约&r, 因果锚和奥术秘典.通过&6FTB天际号&r发射一个."
  ],
  "quest.6AA6C01368D6E51F.title": "&d雕刻符文",
  "quest.28F13C084F290510.title": "&b因果锚",
  "quest.0F938273B444DCC6.quest_desc": [
    "通过&6FTB天际号&r发射&a活体培养物&r.&a巨兽核心&r也需要它们."
  ],
  "quest.3865D1981A6C504A.quest_desc": [
    "&a猎人印记&r在&e末影接口&r的&2头颅装配机&r制作, 每次两个.",
    "",
    "&c警告&r: 请使用空的&a虚空之泪&r.装有物品的虚空之泪会连同内部所有物品一起被消耗."
  ],
  "quest.2BE12C77F5A3B217.title": "&9充能完毕",
  "quest.66DA6CCD0EE57AF2.title": "&d奥术秘典",
  "quest.378515D4213D1BA9.quest_desc": [
    "&a狩猎旗帜&r是狩猎路线的分支组件.完成首领试炼后, &6FTB制造机&r每次可制作两个.",
    "",
    "之后的&a星图&r和&2深渊透镜&r会用到它, &c巨兽之心&r也会再次需要."
  ],
  "quest.53B6E5AE4FF4A857.title": "&c巨兽心智",
  "quest.596C7FC9FD418D10.quest_desc": [
    "&a龙之遗物&r在&eHephaestus&r的&2焦黑铸件台&r上浇铸.将&a龙骨&r作为一次性铸模, 浇入&2熔融炎龙钢&r; 龙骨会被消耗.",
    "",
    "在冶炼炉中熔化&a炎龙钢锭&r, 即可得到熔融金属."
  ],
  "quest.58087F42E353F1A7.title": "&d灵魂工业",
  "quest.58087F42E353F1A7.quest_desc": [
    "&a灵魂契约&r同时运用五个魔法模组的内容, 从&eNeo Vitae&r的血液仪式到&eAnima&r的水晶.",
    "",
    "升级后的&a诺言&r无法堆叠, 每次制作都要单独准备一个."
  ],
  "quest.11523CC5811E7A35.quest_desc": [
    "第一种装配组件&a巨兽核心&r, 需要&2活体培养物&r, 深渊透镜和超致密反物质.通过&6FTB天际号&r发射一个."
  ],
  "quest.2754B03A1C3C9790.quest_desc": [
    "通过&6FTB天际号&r发射&a燃料核心&r.&a动力矩阵&r也需要它们."
  ],
  "quest.524F093A735BE7DD.quest_desc": [
    "&6FTB制造机&r是迈向整合包主要目标的第一步.",
    "",
    "它能制作&6FTB天际号&r, &o以及&r一路通向&c巨兽之心&r的所有Feed The Beast组件.",
    "",
    "它需要能量, 最多同时接收九种材料和两种流体.无需选择配方, 只要放入材料, 制造机就会启动匹配的配方.",
    "",
    "与依赖内部储能的其他机器不同, 制造机每刻都需要外部供能.断电时暂停制作, 恢复供电后继续.因此后期配方要准备足够的线缆和储能来维持输入."
  ],
  "quest.6657769447DCC151.quest_desc": [
    "&a逻辑晶格&r在&eAE2扩展&r的&2晶体组装机&r制作, 每次两个.",
    "",
    "&e精致存储&r的&a高级处理器&r和&eAE2&r的&2工程处理器&r都可使用.如果你已在使用AE2,建议选它, 因为处理器用量只有另一种的一半."
  ],
  "quest.1AF9F40BC39B15E7.title": "&d灵魂契约",
  "quest.783B31D7CB5FECF3.quest_desc": [
    "第二项试炼要求击败&a雷霆之王&r或&2霜熊&r, 任选一个即可.",
    "",
    "霜熊不会在野外自然生成, 而是在雪地或冰冻生物群系生成的&b冰之竞技场&r中等待.用&e探险者指南针&r搜索&9Ice Arena&r, 即可寻找最近的一座."
  ],
  "quest.1680E39D555B6F9D.quest_desc": [
    "&a因果锚&r需要&eJust Dire Things&r的时间水晶与机器, &e奥瑞科技&r的&2速子吸收器&r, 以及&eLTX&r的新星.",
    "",
    "&a时间水晶&r生长于时间水晶母岩, 记得尽早布置."
  ],
  "task.530E9F4F71784E0C.title": "击败&a雷霆之王&r或&2霜熊&r",
  "quest.303158D55BB8EB0A.quest_desc": [
    "最后一项试炼是魔法首领.任意&e魔法艺术&r守护者都算, &e巫术&r的死神, Gulg,有角猎人, Leonard和Mog也算.",
    "",
    "完成此任务, 将解锁&6FTB制造机&r中的&a狩猎旗帜&r配方."
  ],
  "quest.32BF6878128A4A41.quest_desc": [
    "&a认知阵列&r是物流路线的分支组件, &6FTB制造机&r每次制作两个.",
    "",
    "后续&a星图&r, &2活体培养物&r和巨兽心智都需要它."
  ],
  "quest.53B6E5AE4FF4A857.quest_desc": [
    "&a巨兽心智&r需要&2星图&r, 因果锚和认知阵列.通过&6FTB天际号&r发射一个."
  ],
  "quest.547E150FD212CE6A.quest_desc": [
    "&a存储矩阵&r在&eAdvancedAE&r的&2反应室&r中用门瑞欧树脂制作, 每次两个.",
    "",
    "可使用&e精致存储&r的&a64k存储组件&r, 或&eAE2&r的&216k ME存储组件&r.AE2配方一次产出三个."
  ],
  "quest.32BF6878128A4A41.title": "&b认知阵列",
  "quest.28F13C084F290510.quest_desc": [
    "通过&6FTB天际号&r发射&a因果锚&r.&a巨兽心智&r和&2巨兽之魂&r都需要它们, 记得多做一些."
  ],
  "quest.75377F96CF3D0542.title": "&d火中束缚",
  "quest.783B31D7CB5FECF3.title": "&3雷霆或冰霜",
  "quest.4E1BD5A8A30FD48F.quest_desc": [
    "通过&6FTB天际号&r发射&a猎人印记&r, 并为&a狩猎旗帜&r多备一些."
  ],
  "quest.378515D4213D1BA9.title": "&3狩猎旗帜",
  "quest.3CEEE30B0E586B61.title": "&6量子合金晶格",
  "quest.303158D55BB8EB0A.title": "&3魔法强敌",
  "quest.27EC7598ED066BB9.title": "&c第二阶段: 组合组件",
  "quest.337013B1E6098B0F.title": "&9飞出大气层",
  "quest.51090593521196EA.title": "&d符文板",
  "quest.7B97384DD7B5F13A.quest_desc": [
    "队伍通过三场首领试炼后, &a狩猎旗帜&r配方才会解锁.第一场是&a凋灵&r.",
    "",
    "击败一只凋灵.下一项试炼会在本任务下方依次解锁."
  ],
  "quest.51090593521196EA.quest_desc": [
    "通过&6FTB天际号&r发射&a符文板&r.&a奥术秘典&r也需要它们."
  ],
  "quest.3CEEE30B0E586B61.quest_desc": [
    "通过&6FTB天际号&r发射&a量子合金晶格&r.&a地脉锭&r也需要它们."
  ],
  "quest.74EBD1E63235A9E7.quest_desc": [
    "通过&6FTB天际号&r发射&a束缚精华&r.&a奥术秘典&r也需要它."
  ],
  "quest.41767899815ED603.title": "&9动力矩阵",
  "quest.11523CC5811E7A35.title": "&c巨兽核心",
  "quest.524F093A735BE7DD.title": "&6FTB制造机",
  "quest.4E1BD5A8A30FD48F.title": "&3猎人印记",
  "quest.68CD3FB4B9D3E73C.title": "&6深海高压",
  "quest.67653968F82D7015.quest_desc": [
    "&a复合外壳板&r在&e奥瑞科技&r的&2组装机&r制作, 每次两块.所有材料都是完整金属块或合金, 记得为它们准备存储."
  ],
  "quest.369A794CDF251519.title": "&3龙之遗物",
  "quest.68CD3FB4B9D3E73C.quest_desc": [
    "&a深渊透镜&r的大部分材料来自&eNautec&r的深海探索.",
    "",
    "&a激光引导线圈&r由&2烧焦的线圈&r经激光转化获得.&a海妖壳甲&r无法堆叠, 因此配方每次只要求一个."
  ],
  "quest.2BE12C77F5A3B217.quest_desc": [
    "&a充能电池&r在&ePowah&r的&2充能台&r制作, 每个需要20,000,000 FE,周围充能棒决定制作速度."
  ],
  "quest.56B9F00E1A03D9E5.quest_desc": [
    "&a地脉锭&r是材料路线的分支组件, &6FTB制造机&r每次制作两个.",
    "",
    "多备一些: 三种组合组件和&c巨兽之心&r都需要它, 用量比分支组件中的其他种类更多."
  ],
  "quest.369A794CDF251519.quest_desc": [
    "通过&6FTB天际号&r发射&a龙之遗物&r, 并为&a狩猎旗帜&r留些备用."
  ],
  "quest.6657769447DCC151.title": "&b晶格工程",
  "quest.1AF9F40BC39B15E7.quest_desc": [
    "通过&6FTB天际号&r发射&a灵魂契约&r.&a巨兽之魂&r也需要它们."
  ],
  "quest.7E2819AC0B02950E.quest_desc": [
    "&a量子合金晶格&r在&eLTX&r的&2电弧炉&r中配合熔岩制作, 每次两个."
  ],
  "quest.763DA227802CAF6B.quest_desc": [
    "五种组合组件全部完成.领取本任务, 即可解锁&a巨兽核心&r, &2巨兽心智&r和巨兽之魂配方.",
    "",
    "每种装配组件都需要每刻5,000,000 FE,持续一分钟."
  ],
  "quest.686C88AC0EAC0580.title": "&9星图",
  "quest.57A4691609E10D24.quest_desc": [
    "巨兽永远不会满足太久.通过&6FTB天际号&r发射每种分支组件各两个, 每种组合组件各一个, 即可选择一份奖励.",
    "",
    "本任务可重复完成, 让持续运行的工厂不断带来回报."
  ],
  "quest.67653968F82D7015.title": "&6外壳储备",
  "quest.7E2819AC0B02950E.title": "&6电弧合金",
  "quest.56B9F00E1A03D9E5.title": "&6地脉锭",
  "quest.523CFE289E14A7F4.title": "&6复合外壳板",
  "quest.27EC7598ED066BB9.quest_desc": [
    "五种分支组件全部完成.领取本任务, 即可解锁&6FTB制造机&r中的五种组合组件配方.",
    "",
    "每种组合组件都需要每刻1,000,000 FE,持续一分钟."
  ],
  "quest.596C7FC9FD418D10.title": "&3龙之遗物",
  "quest.66DA6CCD0EE57AF2.quest_desc": [
    "&a奥术秘典&r是魔法路线的分支组件, &6FTB制造机&r每次制作两个.",
    "",
    "后续&a灵魂契约&r, &2因果锚&r和巨兽之魂都会用到它."
  ],
  "quest.0F938273B444DCC6.title": "&a活体培养物",
  "quest.523CFE289E14A7F4.quest_desc": [
    "通过&6FTB天际号&r发射&a复合外壳板&r.&a地脉锭&r也需要它们."
  ],
  "quest.271D33449195EF70.quest_desc": [
    "三种装配组件全部完成.领取本任务, 即可解锁&c巨兽之心&r配方.",
    "",
    "巨兽之心需要每刻40,000,000 FE,持续三分钟."
  ],
  "quest.3ED3A5C17426409C.title": "&b存储矩阵",
  "quest.6DDEFBD9C262AA0B.title": "&a供养工厂",
  "quest.3AD6C1611BE808AC.quest_desc": [
    "&a巨兽之心&r汇聚了所有任务路线.",
    "",
    "交付巨兽之心, 向流体舱和能量舱补足资源, 再按&a发射&r完成本章.",
    "",
    "队伍会获得&a巨兽奖杯&r和第一批创造物品, 每位成员还能领取一顶尚未拥有的帽子.",
    "",
    "&7&o恭喜通关, 感谢游玩FTB Evolution 2.&r"
  ],
  "quest.6DDEFBD9C262AA0B.quest_desc": [
    "&a活体培养物&r将三种分支组件, 与&eLTX&r的&2真实虚拟处理器&r及其他模组的合金结合.",
    "",
    "&a超导体&r需要&2结晶青金石&r.&6FTB制造机&r每次能制作32个, 比自然生长快得多, 但成本也更高."
  ],
  "quest.531E1581CAA5AF16.title": "&6深渊透镜",
  "quest.531E1581CAA5AF16.quest_desc": [
    "通过&6FTB天际号&r发射&a深渊透镜&r.&a巨兽核心&r也需要它们."
  ],
  "quest.207C8D7ECDE970C7.quest_desc": [
    "通过&6FTB天际号&r发射&a逻辑晶格&r.&a认知阵列&r也需要它们."
  ],
  "quest.41767899815ED603.quest_desc": [
    "&a动力矩阵&r是能源路线的分支组件, &6FTB制造机&r每次制作两个, 并需要更多&a反物质&r.",
    "",
    "后续&a活体培养物&r, &2灵魂契约&r和巨兽核心都会用到它."
  ],
  "task.15CF6042AC24DDB1.title": "&a高级处理器&r或&a工程处理器&r",
  "quest.2905D04F590BAC36.title": "&6FTB天际号",
  "quest.43254C6DA652CD80.title": "&c巨兽之魂",
  "quest.3424B583F08C904E.quest_desc": [
    "通过&6FTB天际号&r发射&a充能电池&r.&a动力矩阵&r也需要它们."
  ],
  "quest.547E150FD212CE6A.title": "&b矩阵零件",
  "quest.3865D1981A6C504A.title": "&3狩猎战利品",
  "quest.763DA227802CAF6B.title": "&c第三阶段: 装配组件",
  "quest.7B97384DD7B5F13A.title": "&3第一场试炼",
  "task.26E9F8319109DD27.title": "&a64k存储组件&r或&a16k ME存储组件&r",
  "quest.1680E39D555B6F9D.title": "&b逆转因果",
  "quest.2905D04F590BAC36.quest_desc": [
    "这是&6FTB Evolution 2&r的终局内容.",
    "",
    "要为&6天际号&r完成全部挑战&c发射&r, 你几乎需要体验整合包中的每个模组.",
    "",
    "所有交付都通过向&6天际号&r输入资源完成.它需要一片5乘5,高6格的空地, 上方可见天空, 且只有你的队伍能使用.",
    "",
    "- &a物品&r: 控制台一侧和背面的舱口.",
    "- &a流体&r: 带蓝色符文的侧面舱口.",
    "- &a能量&r: 带绿色符文的侧面舱口.",
    "",
    "{@pagebreak}",
    "右键打开, 选择任务, 再用管道输入所需资源.送入的资源都会被消耗, 任务不需要的则会拒收.材料齐全后按&a发射&r.",
    "",
    "五条任务路线可以分配给不同玩家.每个阶段下方的解锁任务, 会在其上方所有任务完成后, 开放下一阶制造机配方."
  ],
  "quest.337013B1E6098B0F.quest_desc": [
    "&a星图&r需要月球零件, 以及两种全新的高耗能资源.",
    "",
    "- &aFortron&r: 由&eMFFS&r的&2Fortron衍生器&r将能量转换而成.",
    "- &a超致密反物质&r: &eFTB工业奇械&r的&2压缩机&r将64个反物质压成一个."
  ],
  "quest.2754B03A1C3C9790.title": "&9燃料核心",
  "quest.57A4691609E10D24.title": "&5持续进贡"
