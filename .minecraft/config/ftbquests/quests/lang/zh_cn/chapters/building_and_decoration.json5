{
  "quest.607211F8C680B88A.title": "&a门",
  "quest.45979A90BFA03AA6.title": "&a照明灯具",
  "task.19CEA73CCF4221E2.title": "任意吊床",
  "quest.672FEF37D5F5783C.title": "&3虹晶手杖",
  "quest.6AECB7C2DF87D34F.quest_desc": [
    "&e精致玻璃&r加入了具有特殊性质的玻璃.&a缥缈玻璃&r会阻挡除玩家之外的所有目标, 因此你能穿墙, 生物却不能.",
    "",
    "&a反向缥缈玻璃&r恰好相反, 只阻挡玩家.Glassential还让本整合包中的原版玻璃能够无缝连接."
  ],
  "quest.1914278B9065D883.title": "&a屋顶",
  "quest.2030D1D78E2AA7DE.quest_desc": [
    "这个方块能替你凿刻.给&a自动凿刻机&r放入凿子, 代表目标变种的模板方块, 以及待加工方块, 它就会逐个转换.",
    "",
    "无需能量, 一个漏斗持续供料, 就能准备好整面墙需要的方块."
  ],
  "quest.45979A90BFA03AA6.quest_desc": [
    "右键点击灯具可开关, 用任意染料可改变颜色.提基火把还能向上堆高."
  ],
  "quest.12A77A3CB31A42F4.quest_desc": [
    "木桥在工作台制作, 石桥在切石机制作.对至少两格宽的桥使用&a钳子&r右键, 即可切出入口."
  ],
  "task.575442B006482AD9.title": "任意凿子",
  "quest.377E6E387004CA7E.quest_desc": [
    "本整合包的大多数建筑模组都通过&a切石机&r加工变种.&eBetterBlockZ&r, &e装饰木格栅&r和多个&eMacaw&r模组都使用它.",
    "",
    "本页各任务路线分别介绍建筑的一种方向, 均不限制整合包其他内容.选择适合当前基地的部分开始即可.",
    "",
    "在&eJEI&r查看方块, 即可看到它能切割成的全部变种."
  ],
  "quest.4307A169AF52A267.title": "&a发光玻璃与红石玻璃",
  "quest.7F55F51B79B150FB.quest_desc": [
    "&eDecorZ&r用BetterBlockZ的&a赛博灯&r方块制作灯具.先制成面板, 再通过切石机加工为灯罩, 灯, 灯笼, 薄板和灯带."
  ],
  "quest.6AECB7C2DF87D34F.title": "&e精致玻璃",
  "quest.1F9D424E8172A112.title": "&a鱼缸",
  "quest.6D8E5365B422735D.quest_desc": [
    "&eBetterBlockZ&r的方块按系列分类, 切石机能将每种基础方块切成最多十五种变体.每个系列都先需要一个&a方块核心基底&r.",
    "",
    "无需切石机也能切换手持方块的变种, 但需要绑定两个默认未设置的按键: &b变种选择界面&r和&b鼠标滚轮修饰键&r, 位于控制中的Z-核心分类."
  ],
  "quest.23BAF609BE4D464F.quest_desc": [
    "本整合包的原版玻璃已经能无缝连接, 因此&eConnected Glass&r主要提供其他样式.&a连接玻璃&r没有边框, 进一步合成可得到&2透明玻璃&r, 再制成刮痕玻璃."
  ],
  "quest.23B44ACF78688229.quest_desc": [
    "六个&eMacaw&r模组各自负责一种建筑元素, 合起来包括屋顶, 窗户, 桥梁, 门, 小径和灯具.",
    "",
    "多数方块在工作台或切石机制作, 每个模组又有值得了解的工具或技巧, 周围任务会分别介绍."
  ],
  "quest.3F05300BC56B409C.quest_desc": [
    "铺路方块由切石机制作.对已放置的铺路方块, 用镐右键可雕刻, 用锹右键可压平."
  ],
  "quest.672FEF37D5F5783C.quest_desc": [
    "对虹晶玻璃使用&3虹晶手杖&r, 即可应用设置.使用时潜行, 可一次修改所有相连方块.",
    "",
    "魔杖设置通过&b打开魔杖编辑器&r按键打开, 本整合包默认未绑定.请在控制的Crystalix分类中设置."
  ],
  "quest.29FE9DA4102EBB42.quest_desc": [
    "&e框架方块&r的各种形状可以采用其他方块的外观.手持方块物品右键点击框架, 即可应用为伪装.",
    "",
    "应用伪装会消耗该方块, 用&a框架锤&r敲掉伪装时会返还.&a框架扳手&r可原地旋转框架方块."
  ],
  "quest.1749497FC966AEFB.quest_desc": [
    "手持&a鱼袋&r右键点击鱼, 可以活捉.每袋容纳一条."
  ],
  "quest.22BB5B95E316458D.quest_desc": [
    "&a红石建筑师魔杖&r能一次放置完整形状, 包括箱体, 圆形和三角形, 各自可选实心, 空心或仅墙壁.",
    "",
    "本整合包中这些按键默认未绑定.使用前, 请在控制的Architectural Building Wand分类中, 设置&b魔杖模板&r及其他操作键."
  ],
  "quest.3C3703F7BC1BE459.quest_desc": [
    "&ePlonk&r允许你把任意物品摆在表面作为装饰.主手拿着物品, 看向方块, 按下&b放置物品&r键即可.",
    "",
    "该键默认未绑定, 先到控制的Plonk分类设置.空手潜行并按该键, 可以旋转已摆放的物品."
  ],
  "quest.5A1DA2B60986EAF9.quest_desc": [
    "&a虹晶玻璃&r放置后仍可修改.颜色, 纹理, 亮度, 红石输出, 隐形, 以及允许哪些生物通过, 都是方块上的设置."
  ],
  "quest.4676483E1F4B7CA5.quest_desc": [
    "Macaw的窗户从&a窗框&r开始制作.&a窗户锤&r改变已放置窗户的形状, &2窗户钥匙&r用于锁定."
  ],
  "quest.1CBCDBA892A21481.quest_desc": [
    "&a凿子&r可将一个方块转成装饰变种.右键打开界面, 把方块放进槽中, 按一比一换成任意变种.",
    "",
    "在槽里保留一个方块, 然后左键点击世界中已放置的方块, 可将其转为该变种."
  ],
  "quest.493D3F41AFD2AF3F.title": "&a单向玻璃",
  "quest.7ED0B679AA8D8F35.title": "&a吊床",
  "quest.22BB5B95E316458D.title": "&a建筑师魔杖",
  "quest.3774C5D696778FF4.title": "&a木格栅",
  "quest.4307A169AF52A267.quest_desc": [
    "&a发光玻璃&r提供照明, &2红石玻璃&r输出红石信号, 让窗户兼作灯具或信号源.",
    "",
    "&a幽灵玻璃&r允许所有生物通过, 包括玩家."
  ],
  "quest.1F9D424E8172A112.quest_desc": [
    "先用水桶装满&a鱼缸&r, 再拿着装鱼的鱼袋潜行右键点击, 将鱼放入.",
    "",
    "&e更好的鱼缸&r禁用了Starcatcher的水族箱, 因此应制作本任务中的鱼缸."
  ],
  "quest.5D61821B89B22271.quest_desc": [
    "本整合包中, 缸里的鱼需要食物, 开始挨饿时会发出警告.食物在&a水族师工作台&r制作, JEI列出了所有配方.",
    "",
    "将食物放入鱼缸的&b鱼食&r槽."
  ],
  "quest.6D8E5365B422735D.title": "&eBetterBlockZ",
  "quest.7F55F51B79B150FB.title": "&a赛博灯面板",
  "quest.3C9556B5DA05C0CE.quest_desc": [
    "&a玻璃告示牌&r是透明告示牌.手持&a幻翼膜&r右键点击任意已放置告示牌, 牌板会消失, 只剩文字悬浮在空中.幻翼膜会被消耗.",
    "",
    "&c牌板之后无法恢复."
  ],
  "quest.12A77A3CB31A42F4.title": "&a桥梁",
  "quest.1749497FC966AEFB.title": "&a鱼袋",
  "quest.4676483E1F4B7CA5.title": "&a窗户",
  "task.6700672FB0E2B3E3.title": "任意睡袋",
  "quest.2030D1D78E2AA7DE.title": "&a自动凿刻机",
  "quest.34EE10F62A7C95EA.quest_desc": [
    "&a精致玻璃刷&r用于设置&2可染色玻璃&r.手持刷子右键选择颜色, 并切换发光, 红石, 玩家穿透和实体穿透, 再对玻璃使用."
  ],
  "quest.34EE10F62A7C95EA.title": "&a可染色玻璃",
  "quest.3F05300BC56B409C.title": "&a小径与铺路",
  "quest.29FE9DA4102EBB42.title": "&e框架方块",
  "quest.493D3F41AFD2AF3F.quest_desc": [
    "这种玻璃只能从一侧看穿.用任意方块右键点击&a单向玻璃&r的一个面, 可伪装这一面, 从外侧看就像普通墙壁."
  ],
  "quest.23BAF609BE4D464F.title": "&eConnected Glass",
  "quest.3C9556B5DA05C0CE.title": "&a全息告示牌",
  "quest.5A1DA2B60986EAF9.title": "&e虹晶玻璃",
  "quest.66FD982E02F0014A.quest_desc": [
    "&a睡袋&r让你远离家园时也能睡过夜晚.潜行右键放下后, 就会立即躺进去.",
    "",
    "&c睡袋不会设置重生点."
  ],
  "quest.5D61821B89B22271.title": "&a喂养你的鱼",
  "quest.1914278B9065D883.quest_desc": [
    "用&a屋顶锤&r右键点击屋顶顶部, 可切换形状.石质和混凝土屋顶由切石机制作."
  ],
  "quest.6E0B8B406E7D94CA.title": "&a无线开关",
  "quest.3774C5D696778FF4.quest_desc": [
    "&e装饰木格栅&r为每种木材提供90种格栅图案, 全都可在切石机中用木板或去皮原木加工, 适合制作屏风, 栏杆和窗格."
  ],
  "quest.607211F8C680B88A.quest_desc": [
    "每种门样式都由对应的&a门图纸&r制作, 制作时会消耗图纸.",
    "",
    "&c金属门只能通过红石能量开启."
  ],
  "quest.1EEA91FF83950090.title": "&a框架锯",
  "quest.3C3703F7BC1BE459.title": "&aPlonk",
  "quest.1EF4458125E12666.title": "&eMalisis Doors",
  "quest.1EEA91FF83950090.quest_desc": [
    "其他框架形状都由&a框架锯&r制作.它将&a框架块&r切成斜坡, 楼梯, 面板, 柱子等, JEI的框架锯分类列出了全部样式."
  ],
  "quest.7ED0B679AA8D8F35.quest_desc": [
    "吊床悬挂在两个相向放置的&a绳与钉&r之间, 用于睡过白天, 而非夜晚.",
    "",
    "与睡袋一样, 吊床不会设置重生点."
  ],
  "quest.377E6E387004CA7E.title": "&6切石机",
  "quest.66FD982E02F0014A.title": "&e舒适用品",
  "quest.1EF4458125E12666.quest_desc": [
    "&a门工厂&r可以制作自定义门.你能选择材料, 15种运动方式之一, 声音和开关时间, 以及自动关闭, 靠近开启, 红石控制或密码锁等附加功能.",
    "",
    "&c气密门, 监狱门, 车库门和滑动铁门只能使用红石."
  ],
  "quest.1CBCDBA892A21481.title": "&e凿子",
  "quest.6E0B8B406E7D94CA.quest_desc": [
    "&eMalisis Switches&r提供无线红石功能.用&a能量连接器&r选择开关, 再对它应控制的方块使用, 即可连接.手持连接器滚动滚轮可以切换模式."
  ],
  "quest.23B44ACF78688229.title": "&eMacaw&r系列模组"
}
