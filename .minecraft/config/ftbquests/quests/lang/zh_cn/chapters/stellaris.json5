{
  "quest.4F33BBD62C89D3D1.title": "&6月神之心",
  "quest.7246368D781AF664.title": "&3重力操纵器",
  "quest.751C9ACFF61D9B4A.title": "&a氧气模块",
  "quest.2AB8372D4923EB79.title": "&6发射台塔架",
  "quest.48793376ABF73D9D.title": "&6火箭部件",
  "quest.7E33FAE9B28F310C.quest_desc": [
    "钛工具有3,122点耐久和9.6采掘速度, 两项都超过钻石工具, 也能开采钻石镐能采的一切.",
    "",
    "套装也包括剑.如果你准备长时间在地下寻找更多钛, 值得制作."
  ],
  "quest.353A4A8D9B1F1535.title": "&a伤害防护",
  "quest.1FD2A6DDDD6FC1DC.title": "&a搅拌器",
  "quest.6B965F82617C0CBB.title": "&3石油探测器",
  "quest.7E33FAE9B28F310C.title": "&a钛工具",
  "quest.050D217525CEB718.title": "&3货物卸载器",
  "quest.29B8507F3604F167.title": "&3天线",
  "quest.381894100844F900.title": "&3太空农场",
  "quest.4FE1E26A7C5491C4.title": "&b平板电脑",
  "quest.115BB85719D018FA.quest_desc": [
    "存储16,000 FE,无需特殊设置即可充当缓冲.发电过剩时储能, 需求增加时再供出.",
    "",
    "将&a航天服头盔&r放进输出槽, 可为夜视和石油探测模块使用的电池充能.",
    "",
    "&7&o破坏后保留电量, 便于将充满的电源带到其他基地.&r"
  ],
  "quest.21619170E62020C5.title": "&3燃料精炼厂",
  "quest.7908A372EC4E1475.title": "&d实验室",
  "quest.4F33BBD62C89D3D1.quest_desc": [
    "&z月神之心&r在深层实验室底部等待着你.它有550点生命, 造成14点伤害, 几乎不需要移动也极其危险.",
    "",
    "战斗中有两次, 它会进入无敌状态, 直到完成应对动作.这些阶段中攻击不会造成伤害.",
    "{@pagebreak}",
    "它会防守面朝的方向.正面攻击会被弹开, 并让它保持防御数秒, 但它无法防住背后攻击.",
    "",
    "咆哮时, 伤害翻倍15秒, 并留下使接触者感染的云雾.&c真正危险的是射线.&r盾牌能吸收大部分射线伤害."
  ],
  "quest.6DA7B8D6730BA6E5.quest_desc": [
    "&3记忆芯片&r由先前抵达的任务队留下, 按顺序阅读, 了解月球上发生了什么.",
    "",
    "可在地球的卫星和行动基地箱子, 陨石, 以及月球村庄, 球体建筑, 地牢和废弃空间站中找到, 研究也会奖励.",
    "",
    "用&b平板电脑&r读取.自己合成的空白卡不含数据."
  ],
  "quest.239E5D0B9EB0DC98.title": "&3流体胶囊",
  "quest.09982FE8CD1BAB6F.title": "&6深空空气",
  "quest.21619170E62020C5.quest_desc": [
    "同时将10 mB原油精炼为5 mB&a燃料&r和5 mB&2柴油&r, 消耗50 FE/t.",
    "",
    "两种流体从相反方向输出: &a燃料&r在右, &2柴油&r在左.确保管道接到真正需要的一侧.",
    "",
    "火箭使用&a燃料&r, &a柴油&r则供发电机和月球车使用."
  ],
  "quest.72FC7BAA5713948A.title": "&3氧气扩散器",
  "quest.099D3C63BA8A85D9.quest_desc": [
    "将食物密封进罐头.在可呼吸房间之外, 罐头是唯一能吃的食物.",
    "",
    "一格放食物, 另一格放空罐.每罐消耗100 FE,每点营养需要20刻.机器可由上方或下方的漏斗装卸.",
    "",
    "装罐会从食物中提取100 mB水, 存入机器的4,000 mB储罐.罐满时机器停止, 因此需要接管排水."
  ],
  "quest.115BB85719D018FA.title": "&a储能电池",
  "quest.2224FF79816EE5A1.quest_desc": [
    "放下物品时, 整个&73×3&r平台会一次搭好; 破坏中心, 则会拆下整个平台.",
    "",
    "手持火箭右击中心, 即可将火箭放上去.",
    "",
    "发射台接受两种升级, 安装方式相同: &6发射台塔架&r和&3天线&r."
  ],
  "quest.3AE1DC8405E8B7BE.title": "&6工程站",
  "quest.6EB0B9691B5A733B.quest_desc": [
    "&e群星&r几乎什么都需要&a钛&r, 机器, 火箭部件和航天服组件都不例外.",
    "",
    "地球上, 矿石从基岩生成到约&ey=60&r, 中间高度最丰富.月球&ey=32&r以下也有矿藏, 但到达那里之前就需要钛.",
    "",
    "&7&o钛工具的采掘等级与钻石相同, 但更加耐用.&r"
  ],
  "quest.11DCEA26B9BA0EC2.title": "&a水泵",
  "quest.6D3E46EA2429C2B6.title": "&a太阳能板",
  "quest.66D1271DB83E2207.quest_desc": [
    "地球轨道的重力为0.5,没有可呼吸空气, 昼夜温度都是-270度, 也是唯一能建造空间站的地方.",
    "",
    "空间站自带&3天线&r, 因此建成后立刻就成为一个导航点.",
    "",
    "带上&6氧气分配器&r让空间站可以呼吸, 再带一个&3重力操纵器&r方便活动, 两者都不包含在站内.这里可用的发电设备是&6星光板&r."
  ],
  "quest.427907D696C3BAF6.quest_desc": [
    "1级储罐一次容纳5,000 mB同种流体, 可用管道, 桶或&3流体胶囊&r装填和排出.",
    "",
    "抽油机的产量高于精炼厂的消耗速度, 在旁边放储罐存余量, 否则很快就没有空间继续抽油."
  ],
  "quest.09982FE8CD1BAB6F.quest_desc": [
    "在头盔中储存3,600 mB氧气, 真空中静止站立时约够一小时.3级提高到6,000 mB,约100分钟.",
    "",
    "同类模块会互相替换.在&6工程站&r安装此模块, 即可升级头盔已有的氧气罐."
  ],
  "quest.6B965F82617C0CBB.quest_desc": [
    "右击显示脚下区块的石油储量, 快捷栏上方以mB显示: &a绿色&r表示丰富, &6橙色&r表示少量, &c红色&r表示没有.",
    "",
    "石油以隐藏的区块储量存在, 而非能开采的方块.约每32个区块有一个含油, 储量为10至50,000 mB.",
    "",
    "每次扫描消耗1,000 FE电池中的1 FE和2点耐久.勘探间隙可放进&a太阳能板&r充能."
  ],
  "quest.381894100844F900.quest_desc": [
    "普通耕地在地球之外无法工作.没有空气, 作物既不会生长, 也无法种下.",
    "",
    "手持泥土右击可建立泥土农场.在一格范围内再放一个, 然后用水桶右击, 周围&73×3&r范围内的泥土农场都会变成耕地.",
    "",
    "手持锄头右击成熟作物收获, 掉落物出现在上方, 作物自动补种, 锄头消耗一点耐久.",
    "",
    "&7&o太空农场有独立生长计时, 因此即使附近没有分配器, 整排农场也能在真空中运行.&r"
  ],
  "quest.5AFF8C443EA3B023.quest_desc": [
    "燃烧煤炭或木炭, 产生3 FE/t.一块约提供530 FE,煤炭块约5,300 FE,内部缓冲为48,000 FE.",
    "",
    "直接向相邻机器输出能量, 因此发电机和机器并排即可工作, 无需线缆."
  ],
  "quest.60992E5D06C1A1C7.title": "&c月球寄生虫",
  "task.240601914FC4D949.title": "任意&a罐头&r",
  "quest.0E87E42788050B42.title": "&3电解器",
  "quest.5D751D7FE140340D.title": "&6氧气分配器",
  "quest.7246368D781AF664.quest_desc": [
    "以1 FE/t将自身所在的整个区块重力设为0至20之间的任意值.",
    "",
    "跳跃高度, 下落速度和摔落伤害都会随设置改变, 箭, 投掷药水, 掉落物, 船, 矿车和已点燃TNT也受影响.",
    "",
    "断电后恢复区块自然重力: 地球9.81,月球1.62,轨道0.5.同区块多个操纵器的设置会取平均."
  ],
  "quest.3BD96A538ABED8BB.title": "&b蓝色液体",
  "quest.4A227306FB8A083A.title": "&3喷气模块",
  "quest.00498F1DCBF49DEB.quest_desc": [
    "戴斯矿石只在月球y=32以下生成, 因此必须先到月球才能开采.",
    "",
    "戴斯解锁钛无法提供的设备, 包括&3重力操纵器&r, 2和3级氧气罐, 更好的喷气模块, 自动驾驶仪和货舱模块."
  ],
  "quest.353A4A8D9B1F1535.quest_desc": [
    "根据模块等级, 为单件航天服提供铁, 钻石或下界合金级防护.",
    "",
    "每个模块只保护一件, 因此全套防护需要四个模块."
  ],
  "quest.72FC7BAA5713948A.quest_desc": [
    "扩大分配器能供气的区域, 需要供电, 但不需要自己的氧气来源.",
    "",
    "通电时, 只要放在已供气区域内, 就会将自身周围3×3区块加入允许供气的范围.这些区块中的空气不占用分配器的50,000方块上限, 因此可以无限延伸走廊.",
    "",
    "断电的扩散器不会扩展任何范围."
  ],
  "quest.009F038271462E29.title": "&a管道",
  "quest.108F8B84B41B78DD.title": "&a线缆",
  "quest.4972AB9FD8CE627E.title": "&3月球车",
  "quest.00498F1DCBF49DEB.title": "&6戴斯",
  "quest.2224FF79816EE5A1.title": "&6火箭发射台",
  "quest.26652F9A9F60025A.title": "&6月球",
  "quest.11DCEA26B9BA0EC2.quest_desc": [
    "必须放在水源方块的&c正上方&r.旁边的水源, 或再低一格的水源, 都不会生效.",
    "",
    "每次工作消耗正下方水源, 存入1,000 mB,再从顶面输出水.管道请接在那里.",
    "",
    "因为会消耗水源方块, 应放在无限水源上方, 否则最终会抽干."
  ],
  "quest.36F9ED9391019396.quest_desc": [
    "模组中最强的发电机, 从10,000 mB储罐供油, 产生5 FE/t.每5刻消耗1 mB,也就是每mB产生25 FE.",
    "",
    "5 FE/t足够运行一个氧气分配器, 一个扩散器和几盏灯.更大的基地需要多台发电机, 而非更高级版本."
  ],
  "quest.0D72E2956CD421AB.quest_desc": [
    "航天服共四件, 缺一不可.单独穿着其中三件, 不会提供完整保护.",
    "",
    "航天服首先是生命支持设备, 其次才是盔甲.安装&a伤害防护&r模块前不会减伤, 可用钛修复.",
    "",
    "头盔的氧气模块提供空气, 因此进入真空前先装一个.充入氧气后, 航天服也能让你在水下呼吸.",
    "",
    "活动会增加耗氧, 疾跑为两倍, 喷气飞行为四倍."
  ],
  "quest.239E5D0B9EB0DC98.quest_desc": [
    "单个物品可储3,000 mB,也就是三桶, 使用后不会留下空容器.适用于本模组全部流体.",
    "",
    "放入机器流体槽可装填或排空.穿着航天服时, 手持右击可直接向胸甲储罐转移燃料, 在外面补充喷气燃料."
  ],
  "quest.103D7E501EA6144B.title": "&d疫苗",
  "quest.4A227306FB8A083A.quest_desc": [
    "装在靴子上启用飞行.1级每秒用8 mB燃料, 上升速度每刻0.35格; 3级每秒用3 mB,上升速度0.7格, 因此等级越高, 越快也越省.",
    "",
    "燃料来自胸甲上的柴油或氢气罐模块, 因此靴子飞行前需要配好供油.飞行耗氧也为静止站立时的四倍."
  ],
  "quest.1FD2A6DDDD6FC1DC.quest_desc": [
    "&a搅拌器&r有九个输入槽, 搅拌按钮和6,000 FE缓冲.只有按下按钮才启动, 因此留在网格中的物品不会意外消耗.",
    "",
    "材料摆放位置和拆分堆叠不影响配方.按一次会处理配方允许的全部材料, 批量越大, 时间与能耗越高, 唯一限制是结果槽容量.",
    "",
    "它还能处理所有无序合成配方, 为手工合成提供电动替代."
  ],
  "quest.5D751D7FE140340D.quest_desc": [
    "向密闭房间填充可呼吸空气, 输入能量和氧气后, 空气会扩散到所有可通行方块中.",
    "",
    "房间必须同时满足三项条件, 否则分配器会清空其中空气:",
    "- &c不与露天天空连通&r: 只要有一处上方无遮挡, 空气就会全部消失; 玻璃屋顶仍算密闭.",
    "- &c3×3区块&r: 以房间而非机器为中心计算, 高度覆盖整个世界.",
    "- 最多&c50,000个方块&r的空气.",
    "",
    "只有呼吸才消耗氧气, 每次更新每只生物消耗1 mB.空房间不耗氧, 穿齐航天服的玩家则优先使用服内氧气."
  ],
  "quest.29B8507F3604F167.quest_desc": [
    "将发射台注册为着陆导航点, 让火箭能定点降落, 而非随机选择位置.",
    "",
    "手持天线右击建好的发射台中心, 天线会放在中心下方.该位置必须是松软方块, 泥土, 沙子, 空气, 水, 月沙和月石都可以, 石头和建筑方块不行.",
    "",
    "空手右击中心可命名导航点, 并设置公开或私有.私有点可供&a好友列表&r中的玩家使用."
  ],
  "quest.4FE1E26A7C5491C4.quest_desc": [
    "右击打开平板电脑, 其中有四种应用: 百科, SD卡读取器, 行星列表和个人统计.",
    "",
    "最常用的是百科, 列出&e群星&r的每种机器, 物品, 生物和火箭部件, 以及关键数值.",
    "",
    "潜行右击方块, 直接打开其页面.在物品栏中把物品拖到平板上, 可打开对应条目."
  ],
  "quest.7157F03A8C8B2F48.title": "&6火箭",
  "quest.6EB0B9691B5A733B.title": "&a钛",
  "quest.1FB6C3DDFB1760C3.quest_desc": [
    "夜间产生1 FE/t,白天不发电, 与&a太阳能板&r作息相反, 因此各放一个就能昼夜供电.它也是轨道上能工作的发电板.",
    "",
    "特殊材料是&a诺维特&r, 不在月球生成, 矿藏散布在地球表面, 因此得计划回家一趟.",
    "",
    "与太阳能板一样, 物品槽以10 FE/t充能."
  ],
  "quest.26652F9A9F60025A.quest_desc": [
    "&d月球&r重力为1.62,约地球六分之一, 没有可呼吸空气, 白天温度+123度, 夜间-233度.",
    "",
    "你会乘坐&a着陆舱&r抵达, 里面装着你, 火箭和货舱全部物品.&c撞地时会爆炸&r, 可能留下陨坑, 因此远离重要设施降落.&6自动驾驶模块&r能实现柔和着陆.",
    "",
    "想回家, 记得从着陆舱取出火箭.",
    "",
    "真空每秒对需要呼吸的生物造成半颗心伤害.使用头盔装有氧气的航天服, 或待在分配器供气的密闭房间中."
  ],
  "quest.48793376ABF73D9D.quest_desc": [
    "火箭需要三类部件: 顶部鼻锥, 底部四角的四片尾翼, 以及下方的引擎.",
    "",
    "部件不能单独工作, 需要在&6工程站&r中加钛制船体进行组装."
  ],
  "quest.0E87E42788050B42.quest_desc": [
    "供料后自动将水分解为&a氧气&r和&a氢气&r, 每刻消耗10 mB水及50 FE,产出10 mB氢气和5 mB氧气.",
    "",
    "&a氢气&r从右侧输出, 氧气从左侧输出.",
    "",
    "&2氧气&r送往分配器让基地可以呼吸, &a氢气&r可供&b月球车氢气引擎&r使用."
  ],
  "quest.6DA7B8D6730BA6E5.title": "&bSD卡",
  "quest.7908A372EC4E1475.quest_desc": [
    "插入装满的存储元件并按研究, 每次30秒, 无论成功失败都会清空元件.",
    "",
    "共有六个阶段.要保证成功, 各阶段分别需要1,100,200,300,400和500只寄生虫.",
    "",
    "每个成功阶段都会奖励记录殖民地历史的&bSD卡&r.阶段4揭示解药的最后一种材料, 并解锁疫苗页签; 阶段5只是结局."
  ],
  "quest.36F9ED9391019396.title": "&3柴油发电机",
  "quest.74FDEE7DD7AD56DA.quest_desc": [
    "放在有石油储量区块内的任意位置并供电, 每刻抽取5 mB,每mB消耗2 FE.",
    "",
    "抽出的是&6原油&r, 与&e奥瑞科技&r油泉产出的流体相同, 两种精炼厂都能处理.",
    "",
    "储量有限, 区块抽干后, 抽油机就会停机, 需要寻找新的地点.",
    "",
    "&c破坏时不会返还钻头.&r其他内部物品会回收, 因此请谨慎选址."
  ],
  "quest.5464B241C8AF9F7A.quest_desc": [
    "&a硅&r用于&e群星&r几乎所有电子部件, 线缆, 管道, SD卡, &3石油探测器&r, &b天线&r和&6工程站&r都需要.",
    "",
    "&a搅拌器&r使用下界石英时成本较低, 也能用&a月石粉&r, 但更耗电, 最好等到达月球后再考虑."
  ],
  "quest.050D217525CEB718.quest_desc": [
    "抵达后自动卸载着陆舱, 不用你爬进残骸.先卸火箭和燃料槽, 再处理其余货物.",
    "",
    "供电并放在着陆点5格内, 每秒搬运一组, 消耗100 FE.",
    "",
    "自身30个槽位全部清空后, 才会寻找下一艘着陆舱, 因此每次飞行之间要及时清理."
  ],
  "quest.751C9ACFF61D9B4A.quest_desc": [
    "此模块装在头盔中, 负责航天服供气.1级容纳1,200 mB,在真空中以每秒1 mB的耗氧静止站立, 约够20分钟.",
    "",
    "在&6氧气分配器&r处补充, 或手持装满氧气的&3流体胶囊&r使用.",
    "",
    "2和3级容量为3,600及6,000 mB,都需要戴斯, 因此先从月球带回材料."
  ],
  "quest.39A64273C8627542.title": "&d病原体存储元件",
  "quest.009F038271462E29.quest_desc": [
    "管道最多传输250 mB/t,内部容纳1,000 mB.可运原油, 燃料, 柴油, 水, 氧气和氢气, 但不能运能量.",
    "",
    "用来给电解器送水, 分配器送氧, 以及精炼厂送油."
  ],
  "quest.39A64273C8627542.quest_desc": [
    "最多存500只寄生虫, 手持右击可将物品栏中全部&c寄生虫&r移入元件.",
    "",
    "&d实验室&r无论研究成功失败都会清空元件, 因此开始前尽量装满."
  ],
  "quest.66D1271DB83E2207.title": "&6地球轨道",
  "quest.2245CFED83908481.quest_desc": [
    "小罐容纳10点营养, 大罐20点.它们不只装一份饭, 可以在&3真空封装机&r中继续添加食物, 直到装满.",
    "",
    "食用时, 另一只手需拿一瓶&a药水&r, 普通水瓶也可以, 而且吃罐头时不会消耗药水.",
    "",
    "罐头有16种染料颜色, 之后也能重新染色."
  ],
  "quest.427907D696C3BAF6.title": "&a流体储罐",
  "quest.0D72E2956CD421AB.title": "&6航天服",
  "quest.1FB6C3DDFB1760C3.title": "&6星光板",
  "quest.099D3C63BA8A85D9.title": "&3真空封装机",
  "quest.4972AB9FD8CE627E.quest_desc": [
    "可驾驶的小车, 方便在地面旅行.容纳3,000 mB柴油, 每行驶20格消耗2 mB,因此一桶能开很久.",
    "",
    "在&6工程站&r安装模块: 货舱增加两行槽位, 储罐使燃料容量翻倍, 速度模块将最高速度乘以1.5,氢气引擎则更换燃料种类.",
    "",
    "&c换引擎前先排空储罐.&r月球车一次只能装一种燃料."
  ],
  "quest.5464B241C8AF9F7A.title": "&a硅",
  "quest.494E845D8A649A95.title": "&6星界爬行者首领",
  "quest.3BD96A538ABED8BB.quest_desc": [
    "蓝色液体在地下和月球形成湖泊, 其中有&b蓝鱼&r, 通常三至七只一群, 性情温和, 受到攻击时逃跑.",
    "",
    "用桶收集液体, 击杀鱼获取&b蓝色等离子体&r, 之后两者都需要.等离子体用于&d疫苗&r和&6星光板&r."
  ],
  "quest.494E845D8A649A95.quest_desc": [
    "&z星界爬行者&r在地表球体建筑周围徘徊, 你靠近48格内时, 它就会敌对.",
    "",
    "它有400点生命, 8点护甲和4点韧性, 几乎不受击退影响.缓慢而沉重的武器比快速武器更合适.",
    "",
    "攻击取决于距离: 近处砸地, 远处冲锋.战斗持续后, 它会获得更多攻击, 包括跃起砸向你.",
    "",
    "&7&o不存在完全安全的距离, 只有不同的风险.&r"
  ],
  "quest.726DF52FC142855E.title": "&a电灯",
  "quest.3AE1DC8405E8B7BE.quest_desc": [
    "你飞行, 驾驶和穿着的一切, 都在这里建造或升级.工程站有三页:",
    "",
    "- &a火箭站&r: 按火箭形状摆放部件, 成品出现在结果槽.",
    "- &a升级站&r: 左侧放火箭, 月球车或航天服部件, 中间放模块, 右侧取升级后的物品.这是安装模块的唯一方法.",
    "- &a空间站规划器&r: 选择空间站, 填好网格, 取出规划好的蓝图."
  ],
  "quest.41979A3605EC64E2.title": "&6空间站",
  "quest.2245CFED83908481.title": "&a罐头",
  "quest.74FDEE7DD7AD56DA.title": "&3抽油机",
  "quest.60992E5D06C1A1C7.quest_desc": [
    "&3月球寄生虫&r有8点生命, 不会正常攻击, 而是附着在你身上, 施加&c感染&r, 持续期间随机扣除一点生命.",
    "",
    "伤害随机, 因此感染很容易被低估.满血时只是麻烦, 受伤时就很危险, 牛奶不能治愈.",
    "",
    "月球上很常见, 地下更多, 也会攻击村民, 将受感染村民转化为&c寄生村民&r.",
    "",
    "必须亲手击杀才能获得&c寄生虫&r物品, 没有其他来源."
  ],
  "quest.108F8B84B41B78DD.quest_desc": [
    "机器间最多传输20 FE/t,足够四台柴油发电机, 再多线缆就会成为瓶颈.",
    "",
    "线缆只传能量, 流体请用&a管道&r."
  ],
  "quest.5AFF8C443EA3B023.title": "&a燃煤发电机",
  "quest.7157F03A8C8B2F48.quest_desc": [
    "在&3火箭站&r页签中, 按火箭形状排列部件进行组装: 鼻锥在顶, 钛构成船身, 尾翼在角落, 引擎在底部.",
    "",
    "储罐容纳3,000 mB&a燃料&r, 每次发射消耗1,000,因此满罐够三次.用桶或&3流体胶囊&r每次加入1,000.",
    "",
    "启动引擎开始十秒倒计时, 火箭随后以每刻0.8格爬升, 超过400格后打开目的地界面.",
    "",
    "&7&o发射台正上方有任何阻挡, 火箭都不会发射.&r"
  ],
  "quest.2AB8372D4923EB79.quest_desc": [
    "手持塔架右击发射台中心, 可在周围添加服务臂.它们纯属装饰, 不影响火箭.",
    "",
    "破坏发射台会将塔架作为物品返还, 因此搬运不会丢失."
  ],
  "quest.103D7E501EA6144B.quest_desc": [
    "不在合成网格, 而是在实验室的疫苗页签中制作, 而且研究必须先到阶段4.",
    "",
    "右击可治愈感染, 并获得永久免疫.这是安全接近&c进化寄生村民&r的唯一方式, 它无需攻击, 就会每1.5秒感染4格内所有目标.",
    "",
    "研究完成前使用, 只会提示尚未准备好."
  ],
  "quest.6D3E46EA2429C2B6.quest_desc": [
    "暴露在阳光下时产生1 FE/t,入夜不发电, 紧上方的方块必须能够直接看到天空.",
    "",
    "物品槽以10 FE/t充能, 是面板正常输出的十倍.可用来保持&3石油探测器&r电量."
  ],
  "quest.726DF52FC142855E.quest_desc": [
    "有16档亮度的灯, 0关闭, 1至7较暗, 8至15较亮.",
    "",
    "亮度越高耗电越快, 最低档每150刻用1 FE,最高档每10刻用1 FE.",
    "",
    "断电后记住亮度, 因此一条带开关的线路就能开关整个基地的灯."
  ],
  "quest.41979A3605EC64E2.quest_desc": [
    "空间站直接在轨道上围绕你组装, 不用逐块搭建.",
    "",
    "在&6工程站&r的空间站规划器页签中设计.网格放八种所需材料和一份空白蓝图, 鼠标悬停查看需求, 先按一次按钮检查, 再按一次制作方案.",
    "",
    "将规划好的蓝图放在火箭任意货舱槽, 选择地球轨道并按建造空间站.空间站建成时消耗蓝图."
  ]
}
