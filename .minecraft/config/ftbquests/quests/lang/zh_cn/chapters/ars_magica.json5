{
  "quest.460216B38525C483.quest_desc": [
    "四位守护者, 四件盔甲.",
    "",
    "制作&a战斗法师盔甲&r.每件都需要金, 黑曜石, 彩色符文和一种精华: 靴子用水, 胸甲用大地, 头盔用空气, 护腿用火焰."
  ],
  "quest.5032BB5B2E4CEC4A.quest_desc": [
    "新铭文台允许每个法术有两组形态, 每次升级增加一组, 最多五组.",
    "",
    "制作三种&a铭文台升级&r, 按顺序右键应用到铭文台.拆除后会保留等级.",
    "",
    "形态组让同一个法术以多种方式传递相同效果.例如治疗法术, 一组设为自身, 另一组设为投射物, 就能治疗自己或朋友."
  ],
  "quest.234EDABC4DC710EC.quest_desc": [
    "只有高空中的仪式才能召来空气守护者.",
    "",
    "召唤并击败&c空气守护者&r.在主世界Y 128或以上搭建&2金质镶嵌环&r, 向中央投入一根&a塔玛根&r.",
    "",
    "箭和其他投射物对它无效, 它也不受摔落伤害, 因此请用法术战斗, 闪电效果最好.它掉落能飞行的坐骑&2风之滑板&r."
  ],
  "quest.3ED3881C36561AFA.quest_desc": [
    "每种法术部件都要先学习, 才能使用.制作并放置&a洞察之眼&r, 就能在&a洞察之眼&r中学习.",
    "",
    "它提供进攻, 防御, 实用和天赋四棵技能树.每个部件消耗一个蓝, 绿或红技能点, 并且必须先学会其前置.",
    "",
    "初始3个点刚好够制作指南推荐的第一个法术: 先从进攻学习&2投射物&r, 再从实用学习&a触碰&r和挖掘."
  ],
  "quest.5CDB81EABD6385D0.quest_desc": [
    "更高级法术部件除了物品, 还要求祭坛提供源质.范围效果, 墙, 区域和各种应急触发都需要它.",
    "",
    "制作&a方尖碑&r和&2水晶扳手&r.给方尖碑装燃料, 再用扳手先右键方尖碑, 后点&2祭坛核心&r完成连接.祭坛拉杆开启时, 制作会抽取源质.",
    "",
    "每个发生器存储5000源质, 一座祭坛可以连接多个发生器.",
    "{@pagebreak}",
    "每种燃料提供固定数量的源质.",
    "",
    "- &a温特姆粉&r: 200源质.",
    "- &2温特姆块&r: 1800源质.",
    "- &a液态源质桶&r: 2000源质.",
    "",
    "以上是基础值.方尖碑周围围一圈&2巫师粉笔&r可将产量翻倍, 再加四根柱子则变为三倍.",
    "",
    "每根柱位于以方尖碑为中心的5x5正方形四角, 由两块&2石砖&r托着一块&a雕纹石砖&r.这个5x5,高3格空间中的其余位置必须是空气."
  ],
  "quest.3070FD15982582F5.title": "奥术纲要",
  "quest.5CDB81EABD6385D0.title": "源质",
  "quest.7C03B317E26A290C.quest_desc": [
    "像搭雪傀儡一样搭建, 就会召来冰霜守护者.",
    "",
    "召唤并击败&c冰霜守护者&r.在主世界寒冷生物群系摆放&2铁质镶嵌环&r, 中央叠两块&a雪块&r, 最后在顶上放雕刻南瓜.",
    "",
    "火焰对它伤害最高, 冰冻则无效.它掉落&2寒冬之握&r, 可以冻结命中目标, 投掷时还能将敌人拉近."
  ],
  "task.444799D362DAFEE9.title": "&e观察&r: &d天体棱镜",
  "quest.5B7AE500196A3035.title": "日光石",
  "quest.1FF93FE18E8F7EE4.title": "亲和典籍",
  "quest.6F50BE9EBF4E149D.title": "合成祭坛",
  "quest.5B7AE500196A3035.quest_desc": [
    "日光石在下界生成, 且只紧邻熔岩.",
    "",
    "开采&a日光石&r.它会替换Y 31至33之间接触熔岩源的下界石质方块, 请沿这个高度的熔岩湖岸寻找.",
    "",
    "&c警告&r: 这个方块不防熔岩."
  ],
  "quest.5E3BBD0F8D9946E3.title": "遗忘的魔法",
  "quest.1A850EA969AFE13C.title": "&d黑暗灵球",
  "quest.43B8B4ADA8187922.title": "奥术矿物",
  "quest.5032BB5B2E4CEC4A.title": "形态组",
  "quest.1F694D7302EBE072.title": "第一个法术",
  "quest.2A0AC5FFA464150C.title": "水之守护者",
  "quest.45CD833DF80BEAC3.quest_desc": [
    "每次施法消耗魔力并增加魔力过载, 两者任一无法满足要求, 法术就会失败.",
    "",
    "烤一个&a魔力蛋糕&r, 获得长时间魔力恢复加成.&2魔力马提尼&r可暂时降低过载; 魔力药水有六种强度, 都可在JEI中查看.",
    "",
    "每升一个魔法等级, 魔力上限增加25,因此升级才是长远之计."
  ],
  "quest.6F50BE9EBF4E149D.quest_desc": [
    "法术不是在工作台合成, 而是在一种逐件接收材料的结构中组装.",
    "",
    "制作&a祭坛核心&r和六块&2魔法墙&r, 搭建&3合成祭坛&r.任务上方的模型显示成品结构, 后面几页介绍规则.",
    "",
    "&e注意&r: 祭坛每秒检查一次形状.形成后, 核心会呈现建筑材料的外观.",
    "{@pagebreak}",
    "框架分四部分搭建.",
    "",
    "&a1)&r 用建筑材料铺5x5地板, 中心放一个顶饰方块.",
    "&22)&r 在相对两边各建一面宽3,高3的墙, 每层的&2魔法墙&r两侧各放一个建筑方块.",
    "&a3)&r 在两墙之间搭5x3屋顶, 中央为&b祭坛核心&r, 左右各放建筑方块; 每块魔法墙上方放楼梯, 两条长边各排3个楼梯, 四角各放顶饰方块.",
    "&24)&r 屋顶下方, 紧贴墙内侧放四个倒置楼梯.",
    "",
    "5x5x5空间内其余位置必须是空气.楼梯朝向见奥术纲要的祭坛页面.",
    "{@pagebreak}",
    "在一侧开口的地板角落放&2讲台&r, 同侧另一端的墙上高一格处安装&a拉杆&r.",
    "",
    "法术配方放在讲台上.拉杆控制祭坛抽取源质, 后期较大法术需要用到.",
    "{@pagebreak}",
    "法术所需的不同材料种类数, 不能超过祭坛强度.强度为建筑材料与顶饰材料的强度之和.整个框架须使用同一种建筑方块及对应楼梯, 五个顶饰也必须同种.",
    "",
    "- 建筑材料强度: 木板1,石头2,石砖或磨制石头3,&2女巫木板&r, 海晶石或石英4,下界砖或磨制黑石5,末地石砖或紫珀块6.",
    "- 顶饰强度: 玻璃1,铁4,金9,钻石11,最高&2日光石块&r15.",
    "",
    "石砖加金顶饰的强度为12,足够制作投射物加挖掘.最强祭坛可达21."
  ],
  "quest.7F82B80575A669AE.quest_desc": [
    "这次需要一场雷暴.",
    "",
    "召唤并击败&c雷电守护者&r.摆放&2金质镶嵌环&r, 中央叠两格&a铜栏杆&r, 顶上放避雷针, 等待雷击.",
    "",
    "闪电会治疗它, 溺水则能伤害它.它掉落&2雷电护符&r, 开启时吸引附近物品."
  ],
  "quest.6707C926C50776BD.quest_desc": [
    "每种法术部件都偏向十种亲和元素之一, 施放会提升你对该元素的亲和.",
    "",
    "持续施法, 获得第一种亲和.亲和越深, 得到的被动能力越强, 但超过50%后, 部分亲和也会有副作用.",
    "",
    "对立元素会相互压低.亲和完全确定后就会锁定, 只有&2亲和典籍&r能再次改变."
  ],
  "quest.5117E5A7B36F61FC.quest_desc": [
    "祭坛制作的每个法术, 都从&2空白符文&r开始, 以&a法术羊皮纸&r结束; 许多部件还要求在中间加入彩色符文.",
    "",
    "制作一些&a空白符文&r, 与任意染料合成彩色符文.例如挖掘需要&2棕色符文&r.",
    "",
    "&2符文袋&r可存每种颜色各一组, 让十六种符文不必占用物品栏."
  ],
  "quest.1F694D7302EBE072.quest_desc": [
    "配方放在讲台上后, 下一件所需材料会浮现在祭坛核心上方.",
    "",
    "制作第一个&a法术&r.按显示顺序, 将材料投入&2祭坛核心&r下方空腔, 从&a空白符文&r开始, 最后放法术羊皮纸.成品法术从核心下方掉出.",
    "",
    "首次使用时可选择图标和名称.施法消耗魔力, 每次成功施法都会获得魔法经验."
  ],
  "quest.7B5AE868BF763D43.title": "变得更强",
  "quest.2A0AC5FFA464150C.quest_desc": [
    "建议魔法等级10级后挑战第一位守护者.",
    "",
    "召唤并击败&c水之守护者&r.在主世界海洋, 河流, 沙滩或沼泽生物群系摆放&2红石镶嵌环&r, 中央投入一艘&a船&r和一桶水.",
    "",
    "它会分裂出承受攻击的分身, 最怕闪电.掉落&2水之宝珠&r, 让你在水下自由呼吸和游泳."
  ],
  "quest.7C03B317E26A290C.title": "冰霜守护者",
  "quest.4416B4374B2A0CE5.quest_desc": [
    "第一位守护者的掉落物, 是召唤这一位的材料.",
    "",
    "在下界召唤并击败&c火焰守护者&r.在3x3&a黑曜石&r上摆&2金质镶嵌环&r, 向中央投入水亲和精华.",
    "",
    "火焰和冰冻对它无效, 溺水则能造成伤害.掉落&2火焰触角&r, 一顶让你免疫火焰并能在熔岩中游泳的头盔."
  ],
  "quest.047392629FC030FF.quest_desc": [
    "技能点来自魔法升级, 魔法升级则靠施法.",
    "",
    "每次成功施法, 获得相当于法术中不同亲和种类数的经验, 混合元素升级更快.持续型法术只获得四分之一.",
    "",
    "每级获得蓝点.10级开始获得绿点, 之后每2级一次; 20级开始获得红点, 之后每3级一次.",
    "",
    "&e注意&r: 洞察之眼中的全部遗忘按钮, 消耗一个&2温特姆块&r即可返还全部点数."
  ],
  "quest.6707C926C50776BD.title": "亲和",
  "quest.4E5672F36E0FBD81.quest_desc": [
    "方尖碑消耗燃料, &d天体棱镜&r则从太阳产生光明源质.光束, 连锁和生命应急触发只接受这种源质.",
    "",
    "通过下一页的净化仪式, 将&2方尖碑&r转成&d天体棱镜&r.只有白天且上方可见天空时, 棱镜才会发电.",
    "{@pagebreak}",
    "放置方尖碑, 用&2巫师粉笔&r在周围画净化图案, 四角各放一根点燃的&a蜡烛&r.准确形状见纲要, 周围空间要清空.",
    "",
    "在4格内丢一个&2月光石&r, 站到方尖碑顶上, 施放同时含自身和光明的法术.月光石被消耗, 方尖碑变为棱镜.",
    "{@pagebreak}",
    "单独棱镜每6刻产生1源质.粉笔环可加速, 5x5四角的柱子进一步加速, 最高阶每刻产生1.",
    "",
    "每根柱由两个&2石英柱&r托着催化方块, 催化物决定等级: 依次为奇美拉石, 金, 钻石, 最高为&2日光石&r块."
  ],
  "quest.1FF93FE18E8F7EE4.quest_desc": [
    "亲和典籍出现在战利品箱中, 与地点的元素相关, 例如下界堡垒遗迹和要塞, 沉船中的水典籍, 废弃矿井中的大地典籍等.",
    "",
    "找到一本&a亲和典籍&r.阅读会使对应亲和增加10%,其他各项减少10%,也是改变已锁定亲和的唯一方法.",
    "",
    "&e注意&r: &3奥术师&r也出售典籍."
  ],
  "quest.53E89BAA247F2D81.title": "巫师粉笔",
  "quest.2779B1ED12A8A648.quest_desc": [
    "这套盔甲会照顾好自己.",
    "",
    "制作四件&a法师盔甲&r.每件都用羊毛, 皮革和符文制作, 会消耗你的魔力自动修复."
  ],
  "quest.5E3BBD0F8D9946E3.quest_desc": [
    "十一种法术部件无法用技能点购买, 需要通过实验学会.",
    "",
    "施放包含正确组合的法术, 学习银色法术部件.例如冰霜伤害, 冰霜和风暴组合, 可学会&2暴风雪&r.其他组合可根据纲要银色部件页面的提示推导.",
    "",
    "其中五种还要求施法时, 4格内地面有一块金属锭.&2陨星&r, 暴风雪和火雨需要&a精金锭&r, 日光与月升需要&a永恒金属锭&r.学会部件时会消耗该锭.",
    "",
    "银色部件之后仍需在祭坛中制作, 部分还需要守护者精华."
  ],
  "quest.716BACCDE07BB05E.quest_desc": [
    "发生器与祭坛的连接通常不可见.",
    "",
    "制作&a魔导护目镜&r, 装备在头盔或头部饰品槽后, 可看到所有源质连接, 方便发现断开的连接."
  ],
  "quest.64FB0BBFC60A0A4D.quest_desc": [
    "纲要中的所有仪式里, 这个最黑暗.",
    "",
    "召唤并击败&c生命守护者&r.主世界新月之夜, 用&2巫师粉笔&r画空心5x5方环, 每边中央外一格各放点燃的&a蜡烛&r.玩家在中央杀死一名幼年村民, 即可召唤.",
    "",
    "它无法直接受伤, 需要击杀它召来的仆从.掉落&2生命护符&r, 放在物品栏中时, 为你维持可再生的伤害吸收护盾.",
    "",
    "&e注意&r: 纲要写的是满月, 但仪式实际检查新月."
  ],
  "quest.43B8B4ADA8187922.quest_desc": [
    "初期需要三种矿物, 全部在主世界开采.",
    "",
    "开采&a温特姆&r和&2黄玉&r, 再挖深些寻找奇美拉石.祭坛核心, 魔法墙和方尖碑都需要温特姆, 多收集一些.",
    "",
    "- &a温特姆矿石&r: Y -16至80,较常见.&d魔力苦力怕&r也会掉落粉末.",
    "- &2奇美拉石矿石&r: Y -16至16,直接掉宝石, 精准采集得到的矿石不能熔炼.",
    "- &a黄玉矿石&r: Y -80至80,山地高处还有额外矿脉."
  ],
  "quest.04A54945082F9B5C.title": "末影守护者",
  "quest.4416B4374B2A0CE5.title": "火焰守护者",
  "quest.42CCD46AABFF6DAF.quest_desc": [
    "召唤并击败&c奥术守护者&r.",
    "",
    "摆放&2铁质镶嵌环&r, 沿一侧依次放&a书架&r, 朝向环的空讲台和另一座书架, 两座书架都叠到3格高.向中央投入一本&2奥术纲要&r.",
    "",
    "它掉落&2奥术法术书&r, 施法消耗魔力减少20%,威力提高40%.",
    "",
    "&c警告&r: 仪式会消耗纲要, 先做一本备用."
  ],
  "quest.1A9736775EA052B0.title": "守护者仪式",
  "quest.5EE9E2D553EC2130.title": "法术书",
  "quest.45CD833DF80BEAC3.title": "魔力与过载",
  "quest.04A54945082F9B5C.quest_desc": [
    "最后一位守护者在末地等待, 召唤需要&2黑暗灵球&r.纲要建议魔法等级达到100.",
    "",
    "召唤并击败&c末影守护者&r.在末地铺5x5&2煤炭块&r地板, 其上摆&a金质镶嵌环&r, 中央放黑暗灵球, 每边中央向外2格各点一处火, 再向灵球投入末影之眼.",
    "",
    "它最怕魔法和溺水.末影人击中它时会死亡并为其治疗, 因此先清理末影人.它掉落&2末影靴&r, 跳跃时会翻转重力."
  ],
  "quest.460216B38525C483.title": "战斗法师盔甲",
  "quest.1A9736775EA052B0.quest_desc": [
    "十位&c守护者&r挡在你和最强魔法之间.它们都不会自行生成: 九位通过仪式召唤, 第十位则在你激怒森林时出现.",
    "",
    "制作八个&a红石镶嵌&r, 摆成空心3x3环.这一圈就是水之守护者的完整仪式基础.",
    "",
    "每位守护者掉落一种解锁新法术部件的&2亲和精华&r, 以及自己的特殊物品.精华可用奥术灰和对应主题材料复制, 因此只需击杀一次.",
    "{@pagebreak}",
    "多数仪式先摆一种镶嵌环: &2红石镶嵌&r, &a铁质镶嵌&r或金质镶嵌.八个镶嵌围一个空格, 触发物品丢在中央.周围要保持空旷, 仪式要求的空位必须是空气.",
    "",
    "&c警告&r: 本整合包所有守护者都会作为&e神化&r首领生成, 带额外词缀, 伤害比纲要描述的更高."
  ],
  "quest.3EB5B2498F0B2A8A.title": "月光石",
  "quest.4BDB6F7BD54FE910.quest_desc": [
    "这池液体值得带走.在源质中浸泡可获得魔力恢复, 一桶也是&2方尖碑&r能使用的最高效燃料.",
    "",
    "&e注意&r: 炼药锅也能装液态源质, 方便在祭坛旁储备."
  ],
  "quest.53E89BAA247F2D81.quest_desc": [
    "从方尖碑首次升级, 到召唤生命守护者的法阵, 本模组的每种仪式都需要粉笔.",
    "",
    "制作&a巫师粉笔&r, 在地面绘制.方尖碑周围完整的8个粉笔印记环就是第一阶."
  ],
  "quest.2E24342B5A3D96C7.title": "大地守护者",
  "quest.7F82B80575A669AE.title": "雷电守护者",
  "quest.5117E5A7B36F61FC.title": "符文",
  "quest.5EE9E2D553EC2130.quest_desc": [
    "祭坛运行后, 法术很快就会堆积起来.",
    "",
    "制作&a法术书&r.潜行右键打开存储, 将法术放在快捷栏页面.手持法术书潜行滚轮, 即可切换法术."
  ],
  "quest.4E5672F36E0FBD81.title": "&d天体棱镜",
  "quest.2E24342B5A3D96C7.quest_desc": [
    "普通环无法召来大地守护者.",
    "",
    "在主世界召唤并击败&c大地守护者&r.在3x3&a黑曜石&r上摆&2铁质镶嵌环&r, 中央下面放雕纹石砖, 每边中央向外2格放一支温特姆火把.向中央投入&2绿宝石&r, &a奇美拉石&r和黄玉.",
    "",
    "火焰和闪电对它无效, 溺水和冰冻则能造成伤害.掉落&2大地盔甲&r, 一件增加攻击伤害并提供火焰免疫的胸甲."
  ],
  "quest.7935F6FE44D4CFD3.quest_desc": [
    "自然守护者无需仪式, 而是在你激怒森林时现身.",
    "",
    "击败&c自然守护者&r.在森林中一分钟内杀死20只&d树妖&r, 它就会出现在最后一只倒下处.树妖通常15至25只成群游荡, 会跟随树苗.",
    "",
    "火焰和冰冻能伤害它, 溺水则会治疗它.掉落&2自然镰刀&r, 一件投掷后会返回的重型武器."
  ],
  "quest.3EB5B2498F0B2A8A.quest_desc": [
    "月光石从天而降.",
    "",
    "找到陨石, 开采&a月光石&r.陨石是约5格宽的石堆, 散布在Y 56以上干燥地面, 较稀有, 平均约400个区块一处."
  ],
  "quest.2779B1ED12A8A648.title": "法师盔甲",
  "quest.716BACCDE07BB05E.title": "魔导护目镜",
  "quest.1A850EA969AFE13C.quest_desc": [
    "&d黑暗灵球&r吸取附近活物的生命, 产生黑暗源质.",
    "",
    "用下一页的仪式将&2方尖碑&r腐化为&d黑暗灵球&r, 并将活体生物圈在2格内.亡灵和首领免疫.召唤和死亡应急触发需要它的黑暗源质.",
    "{@pagebreak}",
    "用&2巫师粉笔&r在方尖碑周围画腐化图案, 四个标记位置各放点燃的&a蜡烛&r, 形状见纲要.在4格内丢一个&2日光石&r, 站到方尖碑上, 对自己施放包含火焰伤害的法术.",
    "",
    "升级使用与棱镜相同的柱式和催化物, 但以&2下界砖块&r替代石英.",
    "",
    "&e注意&r: &d灵球&r形成时会高于地面一格, 但升级环要求它处于地面高度, 可能需要拆下重新放置, 拆除会掉落自身."
  ],
  "quest.14DC3D850BC8283C.title": "第一个法术设计",
  "quest.3070FD15982582F5.quest_desc": [
    "&e魔法艺术: 传承&r的魔法内容, 要取得&a奥术纲要&r后才能开启.纲要没有普通合成配方.",
    "",
    "寻找&2液态源质&r池, 平原中约每50个区块生成一处.在墙上挂&2物品展示框&r, 使池子位于框前2格, 下方1至2格, 再放入一本普通&a书&r.数秒后就会转为&a纲要&r.",
    "",
    "{image:ftb:textures/quests/ars_magica/ars_book.png width:127 height:100 align:center}",
    "",
    "拾取后, 你会从魔法等级1开始, 获得3个蓝技能点, 并开放&3奥术师&r商店.",
    "",
    "[\"\",\"这里每次魔法升级, 也会提升整合包独立的\",{\"text\":\"魔法技能树\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"action\":\"custom\",\"id\":\"ftbquests:docs\",\"payload\":{\"location\":\"guideme,ftb:skills,ftb:magic.md\"}},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开技能树指南\"}},\",但它与本模组技能点是不同的系统.\"]"
  ],
  "quest.047392629FC030FF.title": "技能点",
  "task.6BD5C23831ED861B.title": "&e观察&r: &d黑暗灵球",
  "quest.14DC3D850BC8283C.quest_desc": [
    "纲要推荐用投射物加挖掘作为第一个法术, 可远距离破坏方块.",
    "",
    "编写&a法术配方&r: 在台中放入&2书与笔&r, 将投射物拖入形态组, 挖掘拖入法术语法行, 再手动把完成的书拖进物品栏.",
    "",
    "Shift点击取书会取消设计, 因此请手动拖出."
  ],
  "quest.234EDABC4DC710EC.title": "空气守护者",
  "quest.7935F6FE44D4CFD3.title": "自然守护者",
  "quest.5D40844A4B69B3E8.quest_desc": [
    "学习部件只是工作的一半, 另一半是写下法术.",
    "",
    "制作&a法术羊皮纸&r和&2铭文台&r.铭文台将&2书与笔&r变成法术设计; 每个实际制作的法术, 都以一张羊皮纸作为最后材料."
  ],
  "quest.42CCD46AABFF6DAF.title": "奥术守护者",
  "quest.3ED3881C36561AFA.title": "洞察之眼",
  "quest.4BDB6F7BD54FE910.title": "液态源质",
  "quest.64FB0BBFC60A0A4D.title": "生命守护者",
  "quest.7B5AE868BF763D43.quest_desc": [
    "绿色技能点要到魔法等级10级才出现.",
    "",
    "通过施法升到魔法等级10.绿点开放各技能树更强的一半, 纲要也建议10级后挑战第一位守护者."
  ],
  "quest.5D40844A4B69B3E8.title": "铭文台"
}
