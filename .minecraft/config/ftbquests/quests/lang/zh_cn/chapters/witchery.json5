{
  "quest.3E8FE865C4FAA360.quest_desc": [
    "蕴含变异魔法的枝条, 是建造本模组大多数活体装置的工具.",
    "",
    "&a擒拿草&r, &2生物捕手&r, 苦艾, 寄生虱和猫头鹰都从这里起步, 还能将少量方块转化为其他方块."
  ],
  "quest.511C982980D29F6B.title": "&b古代石板",
  "quest.2AAC5AE4E1520348.quest_desc": [
    "&d死灵之石&r由&a调谐之石&r经过夜间仪式重塑, 是&e禁忌魔法&r几乎所有内容的起点.",
    "",
    "仪式只在夜间运行.在&6金黄仪式粉笔&r周围画一小圈&a仪式粉笔&r, 并让范围内有1,000点&b祭坛能量&r.试剂见指南.",
    "",
    "多做几颗.下面的&a火盆&r, 死灵魂剂, &b绑定命匣&r仪式及&b断魂仪式&r都需要."
  ],
  "quest.4BBF3655536142E9.quest_desc": [
    "&b巫媒&r捕获生物或玩家的精髓, 成为魔法指向目标的联系, 本模组大部分绑定内容都依靠它.",
    "",
    "拿到书即可开启这条任务线, 也能从别人最近睡过的床上取得巫媒.",
    "",
    "生物容易, 玩家却不容易.玩家巫媒七天后失效, 明目张胆或亮光下采集通常失败.请从背后潜行接近, 或使用隐身.",
    "",
    "&7&o留一份自己的巫媒, 几种防护物品会需要.&r"
  ],
  "quest.354E14D2455E5317.title": "纺车",
  "quest.39F2353FFE78EA20.quest_desc": [
    "&d祭坛&r产生&b祭坛能量&r, 驱动本模组几乎所有设备.建在工坊附近, 范围内的一切都可取用.",
    "",
    "材料之一是一对&a山梨原木&r, 而山梨只能通过&d转生粉&r获得.先不断转化树苗, 直到得到山梨树苗, 再种大.",
    "",
    "最初两种烤炉熏气用于制作&d深板岩祭坛&r.将六块摆成3×1×2,多方块结构自动形成.",
    "",
    "能量取决于周围自然环境, 树, 花和草都算, 因此关在石屋中的祭坛很弱.",
    "",
    "顶部最多接受六种修饰:",
    "- &b头颅&r: 倍率和固定加成.",
    "- &b光源&r: 倍率.",
    "- &a圣餐杯&r: 固定加成.",
    "- &b范围修饰物&r: 扩大能量作用距离.",
    "- &d五芒星阵&r: 直接让能量翻倍."
  ],
  "quest.7B33A66F4C09D967.quest_desc": [
    "&a熏气延展件&r放在&2烤炉&r旁, 每个将熏气概率增加20个百分点, 并加快烹饪.两个可将每次的25%提高到65%.",
    "",
    "最多两个, 分别安装在烤炉正面的左右侧."
  ],
  "quest.4DC258DC240CB01A.quest_desc": [
    "&b聚会女巫&r是加入你巫师会的女巫. 用签署后的&a聚会合约&r招募女巫, 每招募一位, 都能计入大型仪式所需的人数.",
    "",
    "巫师会仪式会统计&6金黄仪式粉笔&r周围 16 格内的聚会女巫. 如果你携带&a先知之石&r, 已招募但尚未到场的女巫就会被召到法阵旁.",
    "{@pagebreak}",
    " 女巫聚会小屋很少见, 所以可以用&b召唤聚会女巫&r仪式直接召唤一位. 仪式需要牺牲一名普通女巫, 用&b召唤女巫&r仪式即可轻松将女巫召到身边.",
    "",
    "&c请使用空白合约.&r仪式会消耗放入的合约, 如果失去已签署的那份, 你的巫师会就会解散."
  ],
  "quest.5BE987F72F75E6B4.quest_desc": [
    "自定义药水从点燃的&2巫师炼药锅&r中加入&a下界疣&r开始, 范围内需有&d祭坛&r, 再逐个加入材料.",
    "",
    "&b容量&r限制一锅能叠加多少材料, 强力材料也消耗更多&b祭坛能量&r.JEI的炼药锅酿造配方显示各材料耗能, 成品提示则列出每种材料占用的容量.",
    "",
    "开始前想好完整顺序, 酿到一半无法撤销, 只能加&a木灰&r清空重来."
  ],
  "quest.75833FE4473ACD2F.title": "&d巫师炼药锅",
  "quest.44AFF4B7385115C5.title": "&6永恒巫妖",
  "task.23053105A5CEA741.title": "阅读一块古代石板",
  "quest.22D3C16250EAAB17.quest_desc": [
    "喝下后, 灵魂与身体分离.身体作为承载全部物品栏的躯壳留在原地, 你则化为自由漂浮的灵体.",
    "",
    "拥有&b灵魂形态&r的&5巫妖&r可以进入亡灵, 灾厄村民和僵尸村民体内.其他人需用&b灵魂绑定仪式&r返回身体, 且只在渐盈月或满月有效, 因此喝前先准备好.",
    "",
    "&b断魂仪式&r则通过巫媒作用于目标.对村民使用会杀死村民, 留下可被&d灵魂笼&r收容的虚灵副本.",
    "",
    "&c躯壳挨几下就会死.&r离开前先藏好."
  ],
  "quest.59F9E4D81168E7B6.title": "其他粉笔",
  "quest.3A6004A6F9AA8A10.quest_desc": [
    "手持任意玻璃方块右击&a火盆&r, 将其变为&d灵魂笼&r.破坏牢笼会返还火盆.",
    "",
    "牢笼吸入8格内最近的已复生村民或僵尸村民, 保存其灵魂.先杀村民, 再用&a女巫之爪&r复活尸体, 让牢笼捕获.",
    "",
    "绑定第一个灵魂后升至2级, 但绑定时必须站在牢笼8格内.每笼一魂, 因此最好建一排.",
    "",
    "2级获得&b召唤亡灵&r, 可不消耗灌注充能, 复活周围尸体."
  ],
  "quest.39F2353FFE78EA20.title": "&d祭坛",
  "task.329249CAA612F688.title": "任意铁或铜巫师炼药锅",
  "quest.59429D6ED1EBF212.title": "灵魂绑定",
  "quest.2AAC5AE4E1520348.title": "死灵之石",
  "quest.34FC6EDF6C1D4200.quest_desc": [
    "第二块石板覆盖6至8级, 阅读之前, 相关操作不计入进度.",
    "",
    "- &b6级&r: 对五只动物使用&b生命汲取&r.",
    "- &b7级&r: 用&b灵魂形态&r离体, 附身僵尸村民, 亡灵或灾厄村民, 并在附身时杀死一个村民.",
    "- &b8级&r: 击败&c凋灵&r.",
    "",
    "灵魂形态会留下携带全部物品栏的躯壳, &c挨几下就会死&r, 因此留在安全处."
  ],
  "quest.43D715B893372DC6.title": "女巫之爪",
  "quest.0D1C211E62DB361A.quest_desc": [
    "将两个生物绑定, 把第一个所受的大多数影响转移到第二个身上.",
    "",
    "可随身携带或放在世界中, 不像死亡守护娃娃那样必须占用物品栏."
  ],
  "quest.52B5ABFD7DA5E75A.title": "魂石吊坠",
  "quest.75833FE4473ACD2F.quest_desc": [
    "每位女巫的工坊都围绕它建立, 药酿, 药水和大部分合成都在其中完成.",
    "",
    "装水并用&a打火石&r点燃后使用, 更强配方还需范围内有&d祭坛&r, 后面几项任务会介绍.",
    "",
    "药酿做错时, 一撮&a木灰&r即可清空."
  ],
  "quest.3BC3912753C84805.title": "炼药锅灌注",
  "quest.129860E2C9082F1C.title": "&c巫毒娃娃",
  "quest.4DC258DC240CB01A.title": "巫师会",
  "quest.659C0BF1D4150E50.quest_desc": [
    "四条长期路线之一, 也是两种改变进食方式的路线之一.",
    "",
    "吸血鬼依靠血池而非饥饿值.&a鲜血坩埚&r用于储血, 由&2血瓶&r或玻璃酒杯装入, 你的吸血鬼子嗣也会把整夜收获带回来.",
    "",
    "饰品槽中的&a血石吊坠&r延长蝙蝠形态时间.阳光是最明显的问题, 其他细节见书.",
    "",
    "&7&o这是带独立血脉的完整成长路线, 请把书中吸血鬼部分当作真正的任务线.&r"
  ],
  "quest.2A53B680B919D776.title": "&d转生粉",
  "quest.69A98E479FA0D905.quest_desc": [
    "口袋里的心脏移植术, 牺牲自己, 为主人挡一次死亡, 之后消失.",
    "",
    "这一种不能放在世界中, 必须携带.",
    "",
    "同类娃娃也处理小问题: &a盔甲守护&r在盔甲损坏前完全修复, &2饥饿守护&r则不时补充食物条.",
    "",
    "所需&a幸运液滴&r要用&2蒸馏室&r产物, 还需要&a超级转生粉&r, 因此两条路线都得推进."
  ],
  "quest.25B6E92B02340718.quest_desc": [
    "&b召唤小恶魔&r仪式带来的小恶魔以灵魂交易, 右击可购买试剂和合约, 支付你周围的灵魂.",
    "",
    "它统计你16格内所有虚灵生物和装满的&d灵魂笼&r.笼中村民值200,合约价格500.",
    "",
    "&d石化合约&r教会&b石化&r符文, 短暂将一个生物变成石头.&b石化仪式&r则影响环阵周围所有目标, 包括你自己."
  ],
  "quest.354E14D2455E5317.quest_desc": [
    "&a纺车&r把收集来的古怪材料纺成魔法丝线与布料.",
    "",
    "多数配方消耗&b祭坛能量&r, 因此和其他设备一样, 应放在&d祭坛&r范围内."
  ],
  "task.6E08A194E248D650.title": "任意铁或铜熏气延展件",
  "quest.54C808CC43A93EC0.title": "蒸馏室",
  "quest.59F9E4D81168E7B6.quest_desc": [
    "更大的仪式需要更好的粉笔, 每种负责同一环阵中的不同圆环.",
    "",
    "- &6金黄仪式粉笔&r: 常规的第二圈.",
    "- &c炼狱粉笔&r: 与恶魔相关的仪式.",
    "- &d他处粉笔&r: 通往其他世界的仪式.",
    "- &a绑定粉笔&r: 将某种存在束缚的仪式."
  ],
  "quest.720DB36A13C6BBDC.quest_desc": [
    "这里的巫术是一门工坊技艺.种植奇异植物, 在&a巫师炼药锅&r里熬煮, 再将成果绑定到人和地点.",
    "",
    "一切从草开始.矮草或高草掉落&2小麦种子&r时, 还分别有二十分之一概率掉落每种巫术种子, 因此&a颠茄&r与&2曼德拉草&r各约每160丛草出现一次.&a雪铃花&r, &2水洋蓟&r和&a狼毒草&r也同样常见.",
    "",
    "&d隐居女巫&r出售全部五种, 每种20硬币, 携带任意一种即可解锁商店.她在女巫小屋, 沼泽房屋, 红树林小屋和黑森林聚落营业.",
    "",
    "先种&a颠茄&r, 花朵是&d指南书&r所需的一种材料.没有花园, 模组其他内容都无从开始.",
    "",
    "&a曼德拉草&r白天醒着, 醒着时拔成熟植株, 它会跳出地面逃跑, 需要追杀才能得根.夜间常在睡觉, 可直接收获根.",
    "",
    "[\"\",\"祭礼, 药酿, 符号法术和诅咒变身也会提升你的\",{\"text\":\"魔法技能树\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"action\":\"custom\",\"id\":\"ftbquests:docs\",\"payload\":{\"location\":\"guideme,ftb:skills,ftb:magic.md\"}},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开技能树指南\"}},\".\"]"
  ],
  "quest.0E9C90976C66641C.quest_desc": [
    "捕捉小型生物的植物, 史莱姆, 蝙蝠和蠹虫走进去就会被关住.",
    "",
    "用四棵&a赤杨树苗&r, 水, 蜘蛛网和一只僵尸培育.捕获对象之后很重要, 抓蝙蝠是制作&d猫头鹰&r魔宠的一步, 抓蠹虫则通向&a寄生虱&r."
  ],
  "quest.54C808CC43A93EC0.quest_desc": [
    "&a蒸馏室&r将熏气和试剂分离成更纯净的材料, 多数配方消耗空&2陶罐&r, 因此旁边常备一组.",
    "",
    "制作&d仪式粉笔&r的&a石膏&r和&2女神之泪&r都出自这里.",
    "",
    "它与&a纺车&r都要用&2调谐之石&r制作, 工作时抽取&b祭坛能量&r.石头需要&a魔力之息&r, 先烤些山梨树苗."
  ],
  "quest.4D2974A8DC0256BA.quest_desc": [
    "用&2仪祭匕首&r杀亡灵, 掉落大多数仪式所需的&d幽魂粉末&r."
  ],
  "quest.77FAC5980E0A7A5D.quest_desc": [
    "签署&a合约&r, 可召集玩家和女巫组成聚会.",
    "",
    "女巫加入前可能要求帮忙, 已有聚会越强, 下一位要求越高.",
    "",
    "&c保管好合约.&r摧毁会解散整个聚会."
  ],
  "quest.58BC157CB468BAD7.title": "&d仪式粉笔",
  "quest.2A53B680B919D776.quest_desc": [
    "&d转生粉&r将植物转化为其他植物, 对生长中的植物使用即可.",
    "",
    "需要在&d巫师炼药锅&r中用&a角魔之息&r酿制, 因此先运行&a烤炉&r获取熏气.",
    "",
    "JEI列出需要500点&b祭坛能量&r, 但附近没有&d祭坛&r时, 炼药锅也能制作.",
    "",
    "实用之处在冷却机制: 每次使用后短时间内, 只影响同种植物, 因此可不断使用, 依次遍历可能结果, 不必每次重来.",
    "",
    "花楸, 桤木和山楂树苗都由此获得, 这些树不会野生."
  ],
  "quest.5B9A6795C7A9747A.title": "炼狱粉笔火力全开!",
  "quest.59429D6ED1EBF212.quest_desc": [
    "第一块石板覆盖3至5级, 只有处于对应等级时操作才计入, 因此按顺序完成.",
    "",
    "- &b3级&r: 让你复生的一只僵尸击杀生物.",
    "- &b4级&r: 亲手杀五个傀儡, 雪傀儡也算, 仆从击杀不算.",
    "- &b5级&r: 再绑定两个村民灵魂, 共三个.",
    "",
    "每级获得能力, &b尸爆&r炸开自己的复生亡灵而不破坏方块, &b生命汲取&r持续伤害单个目标最多五秒, &b死亡传送&r在5级解锁.",
    "",
    "&c3级会失去一颗心的生命上限."
  ],
  "task.596AE248E0C0BB3C.title": "在灵魂笼中绑定一个灵魂",
  "quest.34FC6EDF6C1D4200.title": "断裂的灵魂",
  "quest.720DB36A13C6BBDC.title": "一切始于绿意",
  "quest.07C62222A3914CD9.quest_desc": [
    "第三条路线让身体留在原地.在主世界喝下&d沉睡之酿&r, 就会在另一个地方醒来.",
    "",
    "落点不固定, 可能是平静的&b美梦&r或敌意的&c噩梦&r.身体附近的&a纤细棉花&r, &2流动精神&r和梦魇织梦网, 都能提高进入美梦的概率.",
    "",
    "&c沉睡苹果&r跳过随机判定, 直接送你去噩梦."
  ],
  "quest.29656D8C06B7A2F7.title": "&c狼人化",
  "quest.0D1C211E62DB361A.title": "&c吸血娃娃",
  "quest.24ACDC2BB0A27070.title": "命匣的拥抱",
  "quest.1289B963EA711CAD.title": "寻路石",
  "quest.7F82D5208B9CB9C9.quest_desc": [
    "使用&c炼狱仪式&r可召唤&d恶魔&r, 其&d恶魔之血&r用于药酿和仪式.",
    "",
    "用&b绑定仪式&r防止恶魔逃跑, 你不会想让它跑掉.杀死后拿走心脏, 精炼为&d恶魔之血&r."
  ],
  "quest.0D831CA92D518208.quest_desc": [
    "更强的版本, 拥有普通&d转生粉&r全部功能, 还能影响植物之外的东西.",
    "",
    "适用于小麦, 仙人掌和甘蔗, 将草方块变成菌丝体, 把水下泥土转为黏土."
  ],
  "quest.4BBF3655536142E9.title": "&b巫媒",
  "quest.44B05983766D847B.quest_desc": [
    "&d娃娃&r最初是空的, 与&b巫媒&r合成后, 绑定到巫媒来源的对象.",
    "",
    "依赖前先读清每种娃娃的要求.有些必须留在主人身上才能工作, 其他则可放在世界中, 既省空间, 也不易被人拿到.",
    "",
    "娃娃需要&a松萝铁兰&r, 用&d转生粉&r转化藤蔓获得.&d隐居女巫&r也出售空白娃娃."
  ],
  "task.57B5F9A76FCB6A34.title": "阅读第二块古代石板",
  "quest.58BC157CB468BAD7.quest_desc": [
    "仪式靠绘制, 而非合成.用&d仪式粉笔&r在地面画圈, 放上试剂, 即可运行.",
    "",
    "粉笔痕迹会被仪式消耗, 因此要持续制作.&d指南书&r的仪式部分是目录, 也是书中最大一节."
  ],
  "quest.4E0BA295792F02DF.title": "苦艾",
  "quest.22D3C16250EAAB17.title": "灵魂分离之酿",
  "quest.2CF31599FE4D718C.quest_desc": [
    "这株植物替你拿物品, 仪式可以读取&a擒拿草&r所持材料, 因此不用站在旁边扔试剂.",
    "",
    "用四丛草, 一个箱子和水, 通过&a变异枝条&r培育."
  ],
  "quest.47F71E08732A4852.quest_desc": [
    "&a烤炉&r将树苗烧成&2木灰&r, 每次有25%概率产出熏气.没有容器就会逸散, 因此陶罐槽中要放烧好的&a陶罐&r.未烧制的黏土罐放进去也捕不到, 先烧好.",
    "",
    "树苗决定熏气种类, 白桦产&a女神之息&r, 橡树产&a角魔之息&r, 接下来的&d祭坛&r两种都需要.花楸产后续所需&a魔力之息&r, 其他见书.",
    "",
    "也有铜烤炉, 像其他铜一样氧化, 但功能相同."
  ],
  "quest.511C982980D29F6B.quest_desc": [
    "&b古代石板&r刻在深暗之域的&b远古城市&r中, 只有死灵法师能读.灌注后站在10格内, 看它七秒直到发光.",
    "",
    "第一块石板让你成为&5巫妖&r, 之后模组会在屏幕上显示下一要求.",
    "",
    "共三块可读, 每块只计一次.出门遇到都读, 6级进度等待第二块, 9级等待第三块.",
    "",
    "&c巫妖不再饥饿.&r食物条固定六个鸡腿且没有饱和度, 因此食物不再治疗, 常备治疗药水."
  ],
  "quest.77FAC5980E0A7A5D.title": "聚会合约",
  "quest.2CF31599FE4D718C.title": "擒拿草",
  "quest.5B9A6795C7A9747A.quest_desc": [
    "拥有&d炼狱粉笔&r后, 解锁多种仪式.",
    "",
    "- 召唤&c恶魔&r, 绑定并交易.",
    "- 召唤&a幽魂猪&r, 作为&b幽魂粉末&r的另一来源.",
    "",
    "这种粉笔还解锁许多其他仪式, 但相当危险."
  ],
  "quest.7F82D5208B9CB9C9.title": "召唤恶魔",
  "quest.62B1F0F9D5F9895A.quest_desc": [
    "触碰会受伤, 还会把接触者远远抛开的荆棘, 适合围墙, 不适合撞进去.",
    "",
    "在甘蔗四侧放&a松萝铁兰&r, 每片下方都是静水.四角放四株&2擒拿草&r, 合计持有四颗末影珍珠, 再对甘蔗使用变异枝条.",
    "",
    "&a野生荆棘&r是便宜版本, 用金工具破坏, 否则会蔓延."
  ],
  "quest.36038380E0C3F405.title": "&5巫妖化",
  "quest.36038380E0C3F405.quest_desc": [
    "第四条长期路线.&5巫妖&r复活亡灵为自己战斗, 还能死而复生, 但要放弃大部分自然恢复.",
    "",
    "先酿制&d死灵魂剂&r, 需要一个&a不死图腾&r.准备两个, 因为仪式还需要另一个.",
    "",
    "&b死灵灌注&r仪式需要4,000点&b祭坛能量&r, 中央&6金黄仪式粉笔&r和两圈普通粉笔, 消耗魂剂后, 对你造成100点魔法伤害.",
    "",
    "&c必须活下来.&r手持&a不死图腾&r或携带&6死亡守护娃娃&r.若死亡, 灌注不生效, 魂剂也没了."
  ],
  "quest.0C9BBC137D055B80.title": "命血",
  "quest.4D2974A8DC0256BA.title": "不只是一把仪式刀刃",
  "quest.43D715B893372DC6.quest_desc": [
    "灌注只有在手持&a女巫之爪&r时才工作.女巫约一半概率掉落, &b召唤女巫&r仪式可将女巫带到你面前.",
    "",
    "手持时, 附近死亡的亡灵, 村民和掠夺者尸体会显示灵魂粒子.按住右键再松开, 消耗500灌注充能, 复活所看位置8格内的全部尸体.",
    "",
    "复生者替你战斗, 最初只持续一分钟, 随等级延长, 10级永久存在.&b充能仪式&r补充充能."
  ],
  "quest.74CB218EFCB2185A.title": "&dJust Another 巫术 Remake",
  "quest.4E0BA295792F02DF.quest_desc": [
    "喝&d沉睡之酿&r前往&b梦境世界&r.&a纤细棉花&r只在&b梦境世界&r生成, &c噩梦世界&r找不到.",
    "",
    "&a苦艾&r是死灵术植物, &a火盆&r和大多数死亡主题仪式都需要.",
    "",
    "使用四份&a纤细棉花&r和四处水, 通过&2变异枝条&r将小麦培育而成."
  ],
  "quest.21812817F84A52D1.title": "火盆",
  "quest.3A6004A6F9AA8A10.title": "&d灵魂笼",
  "quest.25B6E92B02340718.title": "石化合约",
  "quest.3BC3912753C84805.quest_desc": [
    "几种具名药酿可直接给装备附魔.JEI的炼药锅灌注配方显示各药酿提供什么附魔, 适用什么物品.",
    "",
    "在点燃的&2巫师炼药锅&r中完成药酿, 确保范围内有&d祭坛&r, 先不装瓶, 投入要附魔的物品.取出即带附魔, 锅被清空, 一锅附一件.",
    "",
    "装瓶药酿无法倒回去, 但只装一部分没问题, 只要锅内还有剩余.每次灌注消耗2,500点&b祭坛能量&r, &2鬼婆之戒&r则需5,000.",
    "",
    "&c警告&r: 不符合配方, 已拥有同级或更高级目标附魔的物品, 或在&d祭坛&r能量不足时投入, 都会被当作酿造材料."
  ],
  "quest.0C9BBC137D055B80.quest_desc": [
    "&d命血&r是由活魂培育的藤蔓.吃浆果治疗一颗心, 若你还没有命血心, 还会获得一颗&d命血&r心, 优先承受伤害并随时间恢复.",
    "",
    "放蜘蛛网, 让村民站在里面, 或在旁边紧贴一个装满的&d灵魂笼&r.蛛网下方一格的四个对角放洞穴藤蔓, 上方一格四角放紫颂, 再用&a变异枝条&r对蛛网使用.",
    "",
    "村民或笼中灵魂会消耗.手摘浆果, 用剪刀拆藤蔓搬运."
  ],
  "quest.3E8FE865C4FAA360.title": "变异枝条",
  "quest.7B33A66F4C09D967.title": "更多熏气",
  "quest.1289B963EA711CAD.quest_desc": [
    "用&a寻路石&r对方块使用, 记录地点, 之后石头会指向那里.",
    "",
    "传送和远距离仪式都读取已绑定寻路石, 而非手动输入坐标."
  ],
  "quest.62B1F0F9D5F9895A.title": "&c末影荆棘",
  "task.21C294004DC52F4E.title": "达到巫妖5级",
  "quest.659C0BF1D4150E50.title": "&c吸血鬼化",
  "quest.21812817F84A52D1.quest_desc": [
    "&a火盆&r燃烧材料作为熏香, 将效果扩散到附近一切.用&a打火石&r或火焰弹点燃.",
    "",
    "制作需要&d死灵之石&r, 因此安排在对应仪式之后.",
    "",
    "&a香炉&r是药水版本, 用任意药水右击, 十六格内每只生物在药水持续期间都获得对应效果.",
    "",
    "多数火盆熏香需要&a苦艾&r, 强力配方还要数百点&b祭坛能量&r才能启动."
  ],
  "quest.69A98E479FA0D905.title": "&6死亡守护娃娃",
  "quest.52B5ABFD7DA5E75A.quest_desc": [
    "为&5巫妖&r增加一个灵魂槽, 使你能多用一个命匣保存灵魂.",
    "",
    "放在项链饰品槽, &c取下会清空一个命匣&r, 让你回到上限内.",
    "",
    "&7&o自身槽位随等级增加: 起初一个, 4级两个, 6级三个.&r"
  ],
  "quest.5BE987F72F75E6B4.title": "&b药酿与自定义药水",
  "task.2CCA016A76895907.title": "阅读第三块古代石板",
  "quest.47F71E08732A4852.title": "巫师烤炉",
  "quest.44AFF4B7385115C5.quest_desc": [
    "10级需要十分钟内三次命匣救命.准备三个装满的命匣, 以及短时间内三次死亡, 规划死亡要像规划灵魂一样认真.",
    "",
    "最后一级增加五颗心和四点护甲, 复生亡灵也永久存在.",
    "",
    "10级&5巫妖&r副手持&a玻璃瓶&r, 击杀村民, 女巫, 灾厄村民或猪灵即可捕获灵魂.喝下&6瓶中灵魂&r, 可为巫妖恢复两颗心."
  ],
  "quest.17FAD6B414738DC2.quest_desc": [
    "一副卡牌, 每张为你施加持久状态.有些是馈赠, 有些是惩罚, 有些兼而有之.",
    "",
    "每张牌的文字都准确说明效果, 抽前读清, 大多数不会自行过期.",
    "",
    "牌组没有合成配方, &d占卜师&r村民在大师级以24颗&a绿宝石&r出售.",
    "",
    "村民通过&2水晶球&r获得此职业, 球需要&6金黄仪式粉笔&r夜间仪式制作的&a先知之石&r."
  ],
  "quest.07C62222A3914CD9.title": "&d灵界",
  "quest.129860E2C9082F1C.quest_desc": [
    "伤害绑定目标的娃娃, 玩法正如你想象.",
    "",
    "扔水里让目标溺水, 扔火里烧伤, 从高处丢下摔伤, 或用针刺它.",
    "",
    "&c巫毒守护娃娃&r可以抵御, 别人也能制作."
  ],
  "quest.5459984CD8A172E5.quest_desc": [
    "&c炼狱仪式&r需要极邪恶的试剂, &3精炼邪恶&r可在",
    "蒸馏室中提炼.",
    "",
    "所有仪式布局请参阅&b模组指南书&r."
  ],
  "quest.0E9C90976C66641C.title": "生物捕手",
  "quest.24ACDC2BB0A27070.quest_desc": [
    "&d命匣&r替你保存灵魂, 死亡时消耗灵魂让你复生, 2级开始生效.",
    "",
    "&b创造命匣&r仪式需10,000点&b祭坛能量&r, 以及大圈&a绑定粉笔&r.",
    "",
    "用&b绑定命匣&r仪式填充.空命匣放在环阵中心四格内, 仪式会抽取16格内最近人形生物的灵魂.",
    "- &b高等灵魂&r: 村民和猪灵, 在死亡地点以半血复生.",
    "- &b低等灵魂&r: 灾厄村民, 僵尸村民和僵尸猪灵, 在命匣处以十分之一生命醒来.",
    "{@pagebreak}",
    "9级需要第三块石板, 以及一次由命匣挽救的死亡.",
    "",
    "每个命匣都放露天, 9级起, 无法看到天空的命匣会给你缓慢和挖掘疲劳."
  ],
  "quest.74CB218EFCB2185A.quest_desc": [
    "种大之前的&a颠茄&r并取花, &d指南书&r正等着这份材料.",
    "",
    "它才是真正的文档, 内容庞大, 十节五百多页.本章介绍主干, 并指引其他内容.",
    "",
    "&7&o随身带书, JEI显示多数配方, 只有书解释机器和仪式如何工作.&r"
  ],
  "quest.44B05983766D847B.title": "&d娃娃",
  "quest.29656D8C06B7A2F7.quest_desc": [
    "第二条长期路线, 在饰品槽佩戴&a月亮护符&r变成狼或狼人, 取下立即变回.",
    "",
    "&a月亮护符&r没有配方, 放下&2狼人雕像&r, 交给它三块&a金锭&r, 片刻后空手取下护符.",
    "",
    "推进血脉需要用&a染血干草&r搭柳条人并点燃, &c角魔狩猎者&r应召而来, 必须击败他.",
    "",
    "第二条血脉起, 护符还会给予血液嗅觉, 绘出通往附近活物的路径, 直到你关闭."
  ],
  "quest.17FAD6B414738DC2.title": "&6塔罗牌组",
  "quest.0D831CA92D518208.title": "&d超级转生粉",
  "task.4AE3B34BFEAE32D6.title": "任意铁或铜巫师烤炉"
}
