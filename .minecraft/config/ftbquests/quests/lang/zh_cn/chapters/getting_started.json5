    "[\"\",\"- \",{\"text\":\"匠神\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"5DCA31CA513EF27C\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开匠神\"}}]",
    "[\"\",\"- \",{\"text\":\"工业奇械\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"06E0165E2CC70DC3\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开工业奇械\"}}]",
    "[\"\",\"- \",{\"text\":\"动态联合\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"5B34FEF756C93961\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开动态联合\"}}]",
    "[\"\",\"- \",{\"text\":\"Just Dire Things\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"565AF0E2D4AB41BE\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开Just Dire Things\"}}]",
    "[\"\",\"- \",{\"text\":\"LTX工业\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"359C9BCF250CA832\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开LTX工业\"}}]",
    "[\"\",\"- \",{\"text\":\"模块化力场\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"1A1161EF6276767F\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开模块化力场\"}}]",
    "[\"\",\"- \",{\"text\":\"海蓝科技\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"77FFEC3A2289F5C2\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开海蓝科技\"}}]",
    "[\"\",\"- \",{\"text\":\"奥瑞科技\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"33E4C81B762892B2\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开奥瑞科技\"}}]",
    "[\"\",\"- \",{\"text\":\"Powah\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"659B9311FB49C425\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开Powah\"}}]",
    "[\"\",\"- \",{\"text\":\"群星\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"6EB0B9691B5A733B\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开群星\"}}]"
  ],
  "quest.3BDC1484FE89DE9D.quest_desc": [
    "制造机中存有10,000 mB的&2火箭燃料&r后, 才能开始制作&6FTB天际号&r.",
    "",
    "建造一个&a酿液桶&r, 发酵出第一批&2火箭燃料&r.这是天际号配方唯一需要的流体.",
    "",
    "&a酿液桶&r先把水发酵为&2烈酒&r, 再把烈酒转化为火箭燃料.每1,000 mB水只能产出250 mB烈酒, 因此制作10,000 mB火箭燃料需要先准备40,000 mB水."
  ],
  "quest.52AC92FEEDB40F4F.title": "初始住宅",
  "quest.795D11D12A8F53E2.quest_desc": [
    "几乎所有基地都会用到的系统, 都可以在这五个章节里找到.",
    "",
    "[\"\",\"- \",{\"text\":\"通用存储\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"049DE43A1B31C38F\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开通用存储\"}},\":背包, 箱子和数字化存储.\"]",
    "[\"\",\"- \",{\"text\":\"资源生产\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"234A09F196E91BDD\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开资源生产\"}},\":蜜蜂, 神秘农业和刷怪设施.\"]",
    "[\"\",\"- \",{\"text\":\"物流\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"64E34B2DA32D3586\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开物流\"}},\":运输物品, 流体和能量.\"]",
    "[\"\",\"- \",{\"text\":\"能源生产\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"754048401D3A6A7B\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开能源生产\"}},\":你的第一批发电机.\"]",
    "[\"\",\"- \",{\"text\":\"实用工具\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"54FE9DA77DED738D\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开实用工具\"}},\":好用的工具与小装置.\"]"
  ],
  "quest.1F42537BFD6A6F33.title": "初期供电",
  "quest.37BE5ED4CC6DCAB5.title": "&6FTB天际号",
  "task.0EDC849E2DE1FC29.title": "FTB事件",
  "quest.1DD27C056EB93771.title": "&c科技模组",
  "task.785029107A287E3E.title": "营养全餐",
  "task.576DCD301F8DCDB0.title": "任意煤炭",
  "task.310FCC3B1073BCE6.title": "压板设备",
  "quest.6DD06EC00EE795D9.title": "&a冒险",
  "quest.4C4B66375F395436.title": "&d共同成长",
  "task.1F103F09B7944A39.title": "初始住宅",
  "quest.3CF1870586E420DB.title": "晶莹剔透",
  "quest.14510C717D3834C1.title": "前往&c下界&r",
  "quest.25B2D69A3A827D18.quest_desc": [
    "&eKindred Spirits&r让你获得一位伙伴.它会与你并肩战斗, 帮你携带部分物品, 而且同行越久就越强.尽早开始吧, 因为羁绊需要时间来培养.",
    "",
    "制作一个&a羁绊护符&r, 再从奖励中选择三种灵伴刷怪蛋之一.",
    "",
    "这个蛋孵化出的灵伴已被你驯服, 因此第一位伙伴无需在野外寻找和驯服.",
    "{@pagebreak}",
    "潜行并对灵伴使用&a羁绊护符&r来结契.仅仅驯服, 只能得到一只宠物; 结契后才会开启等级, 能力和死亡复活机制.直接使用护符可打开羁绊界面, 在其中召唤, 休息, 重命名灵伴或下达命令.",
    "",
    "世界中还能找到另外四种灵伴: 霸王龙, 幼龙, 小妖精和迷你玩家.将鼠标移到&a羁绊护符&r上并按住Alt,可查看&2Oracle Index&r指南, 了解它们的出现地点和驯服方法.&6整装待发&r章节还介绍了每种灵伴及其装备."
  ],
  "quest.1F42537BFD6A6F33.quest_desc": [
    "获得&c红石&r后, 就能开始发电了!",
    "",
    "第一批机器需要能量, 以下任意一种初期发电机都能为它们供电.",
    "",
    "其中大多数发电机会燃烧燃料发电.如果你想试试新鲜独特的方式, 不妨使用&a马力&r, 让马来为你发电!",
    "",
    "或者让商人来.",
    "",
    "[\"\",{\"text\":\"能源生产\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"754048401D3A6A7B\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开能源生产\"}},\"章节介绍了之后的发电发展路线.\"]"
  ],
  "quest.0270ADB3945D2C1A.title": "扫描寻矿",
  "quest.3CF1870586E420DB.quest_desc": [
    "&a下界石英&r矿石只在下界生成, 因此穿过传送门后, 先去找它吧.",
    "",
    "挖一些&a下界石英&r, 熔炼成&2硅&r.&a硅&r很适合用来制造复杂机器所需的电路.",
    "",
    "如果已经开始玩&e应用能源2&r, 也可以将&a赛特斯石英粉&r熔炼成同一种&2硅&r."
  ],
  "quest.21246763BADC28E0.title": "科技起步",
  "quest.21246763BADC28E0.quest_desc": [
    "&6FTB制造机&r需要基础电路, 有三个模组能提供符合要求的电路.",
    "",
    "制作以下任意一种即可:",
    "- &eFTB工业奇械&r的&a电路板&r.",
    "",
    "- &e充能能源&r的&2基础电路&r.",
    "",
    "- &eLTX工业&r的&a基础电路&r."
  ],
  "quest.62A6EDE3018075BC.title": "石器时代",
  "quest.30BAA2AC524A2ACD.quest_desc": [
    "这个整合包中的食物不仅能填饱肚子.&e营养均衡&r会记录你摄入的水果, 谷物, 蛋白质, 蔬菜和乳制品; 饥饿时, 这五类营养值都会逐渐下降.",
    "",
    "[\"按\",{\"keybind\":\"key.nutritional.open_nutrition\",\"color\":\"yellow\",\"hover_event\":{\"action\":\"show_text\",\"value\":\"默认: N\"}},\"打开营养界面, 查看当前营养状况.食物提示中会列出它能补充哪些营养.\"]",
    "",
    "在本整合包中, 营养不足不会带来惩罚.营养系统只会&6提供增益&r, 所以初期可以暂时不管, 之后再慢慢改善饮食.",
    "{@pagebreak}",
    "烤一个&a南瓜派&r吧.它能同时补充&b水果&r, &b谷物&r和&b蔬菜&r三类营养, 非常适合作为起点.",
    "",
    "再补上两类食物, 就能覆盖全部营养:",
    "- &2熟肉或熟鱼&r: &b蛋白质&r.",
    "- &2奶桶&r: &b乳制品&r, 喝下时计入营养.",
    "",
    "[\"这些只是入门选择, 之后还有更好的餐食.\",{\"text\":\"傻瓜食品柜\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"5DBBF2E8AEFB4149\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"前往傻瓜食品柜任务\"}},\"任务中介绍的汉堡或意式腊肠披萨, 一次就能补充四类营养.\"]",
    "{@pagebreak}",
    "保持各项营养充足, 就能获得增益:",
    "",
    "- &3营养充足&r: 平均营养至少60,且没有任何一类低于40.增加1颗心, 各项营养消耗速度降低10%.",
    "- &3美食家&r: 平均营养至少85,且没有任何一类低于70.增加2颗心, 食物补充的营养增加10%,营养消耗速度降低20%.此效果会替代营养充足.",
    "",
    "- &3健康生活&r: 游玩达到7个游戏日后, 在营养充足或更好的状态下, 额外增加2颗心; 平均营养低于30时失去此增益.",
    "",
    "- &3力量&r: &b蛋白质&r营养达到85或以上时生效."
  ],
  "quest.14510C717D3834C1.quest_desc": [
    "有了&2钻石镐&r, 终于可以开采&a黑曜石&r, 打开通往&c下界&r的大门了!",
    "",
    "搭建一个至少宽4格, 高5格的空心矩形门框, 再用&a打火石&r点燃内部即可激活.",
    "{@pagebreak}",
    "&c下界&r有主世界没有的矿物, 例如&b下界石英&r和&d永恒金属&r.",
    "",
    "在下界行走1格相当于在主世界移动8格, 因此建造第二座传送门可以开辟快速通道.",
    "",
    "&c警告&r: 床在下界会爆炸.除非你打算用爆炸采矿, 否则别在那里睡觉."
  ],
  "quest.52243EEF2C055424.title": "黏液起步",
  "quest.30AD073D8434BE97.title": "压出一片天地",
  "task.404A8C08A7390D9C.title": "前往&c下界&r",
  "quest.4A892B55276CEEE3.quest_desc": [
    "该去寻找&b钻石&r, 制作一把&a钻石镐&r了.",
    "",
    "&2黑曜石&r需要钻石镐或更好的镐才能开采, 它也是搭建&c下界传送门&r的材料.",
    "",
    "除非你是速通玩家."
  ],
  "quest.4278C6A88AE6F6D4.quest_desc": [
    "接下来要制作钢.光是&6FTB天际号&r就要消耗32块钢板, 因此最好建立稳定的钢供应.",
    "",
    "建造合金设备, 制作一块&a钢锭&r.合金设备能将两种或更多材料合成一种, 这是普通熔炉做不到的.",
    "",
    "&e充能能源&r的&2合金炉&r像熔炉一样消耗燃料, 因此尚未供电时也能使用.",
    "",
    "&e注意&r: 本整合包中, &e末影接口&r的&2合金炉&r用一个铁锭和一个煤炭炼钢; &e充能能源&r的&2合金炉&r同样只需一个铁锭和一个煤炭."
  ],
  "quest.62A6EDE3018075BC.quest_desc": [
    "想获得金属, 就需要能开采它的工具.木制工具可不够用.",
    "",
    "破坏方块时按住&b`&r, 即可启用&b连锁采集&r, 初期一次最多采集16个方块.",
    "",
    "[\"\",{\"text\":\"连锁采集\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"6E7A3D79BEA2B8D6\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开连锁采集任务\"}},\"任务位于实用技巧章节, 介绍了方块数量限制与饥饿消耗.\"]"
  ],
  "quest.37BE5ED4CC6DCAB5.quest_desc": [
    "&6FTB天际号&r是完成整合包的主要机器, 用来发射&cFTB组件&r.",
    "",
    "无论接下来选择什么玩法, 你做的许多事情都能为&6天际号&r的&c发射&r贡献力量.",
    "",
    "[\"\",{\"text\":\"FTB天际号\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"2905D04F590BAC36\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开FTB天际号任务\"}},\"任务位于Feed The Beast章节, 列出了所需材料.\"]"
  ],
  "quest.3242DFBF0D574B6E.quest_desc": [
    "&e末影接口&r的许多机器都以&a虚空框架&r为基础.",
    "",
    "收集一些&a无限粉&r, 制作一个&2虚空框架&r.&6FTB制造机&r也需要一个机壳.",
    "",
    "在主世界的&2基岩&r上点火.火焰熄灭时可能掉落无限粉, 基岩有80%的概率产出1至3粒."
  ],
  "quest.01583CD13DE25A1C.quest_desc": [
    "&eHephaestus&r的&a冶炼炉&r是由焦黑砖构成的多方块结构, 可以熔化金属, 并将其浇铸成锭或块.",
    "",
    "熔炼粗矿石可得到普通熔炉两倍的金属, 也是制作其他模组所需合金的便捷方式.",
    "",
    "[\"\",\"关于\",{\"text\":\"匠神\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"5DCA31CA513EF27C\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开匠神\"}},\"的搭建方法, 请查看对应章节.\"]"
  ],
  "quest.30AD073D8434BE97.quest_desc": [
    "&6FTB天际号&r需要32块&a钢板&r和两个超频散热片, 而每个散热片又需要&2末影板&r.",
    "",
    "制作一块&a钢板&r和一块&2末影板&r.既然要做32块钢板, 现在就值得搭建压板机了.",
    "",
    "&e充能能源&r的&2锤子&r可以手工制作金属板, 但每块板要消耗两个锭.所有压板机都只需一个锭就能制作一块板.",
    "",
    "&e注意&r: &2合金炉&r不能制作末影锭.请改用&e末影接口&r的合金炉, &eFTB工业奇械&r的合金炉也可以."
  ],
  "task.254E5075B2383654.title": "原木"
}
