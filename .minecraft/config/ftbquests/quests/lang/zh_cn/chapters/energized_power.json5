{
  "quest.5F6D849BF0735415.quest_desc": [
    "口袋里放电池, 墙上装电池箱.",
    "",
    "用四个V级电池制作&a电池箱&r, 可存65,536 FE,每刻传输2,048 FE.高级和精英电池箱分别存储8,388,608和268,435,456 FE."
  ],
  "quest.2418AC7F8E4D0437.title": "动力炉",
  "quest.0004A2325D5DE642.title": "组装机",
  "quest.45AEC6C17B2D353C.quest_desc": [
    "脏水值得留下.",
    "",
    "建造&a过滤厂&r, 输入脏水和&2木炭过滤器&r.每100 mB有33%的概率产出一颗石子, 也有较低概率得到粗矿石.本整合包为产物列表加入了19种金属."
  ],
  "quest.6CD01296F218E3A9.title": "升级模块",
  "quest.4314E0DEC99B8C9C.quest_desc": [
    "极速传送带每2刻前进一步.",
    "",
    "制作一套&a极速物品传送带&r, 包括传送带, 装载机和分拣机."
  ],
  "quest.5C58946645097EBF.title": "结晶青金石",
  "quest.39454A3309E666EA.quest_desc": [
    "精英机器是各机器系列的最终等级.",
    "",
    "建造&a精英动力炉&r和&2精英自动合成器&r.动力炉同时熔炼七组物品, 每次用时仅为原版的二十分之一."
  ],
  "quest.39454A3309E666EA.title": "精英机器",
  "quest.0D6C804C2A6E9ECE.title": "金属压印机",
  "quest.537D4A1C121F9114.quest_desc": [
    "最大的电池箱.",
    "",
    "用四个X级电池制作&a精英电池箱&r, 可存268,435,456 FE,每刻传输16,777,216 FE."
  ],
  "quest.5FE464F00FF65F8E.quest_desc": [
    "经验可以以流体形式存储.",
    "",
    "在&2微型经验存储器&r上方建造&a经验汲取&r, 吸取站在上方玩家的经验和附近经验球, 存入下方."
  ],
  "quest.61B9CB144078F595.title": "传送器",
  "quest.535CC5C59EEBAEF1.quest_desc": [
    "流体需要独立网络.",
    "",
    "制作&a铜流体管道&r和&2小型流体储罐&r.铜管每个抽取面每刻传输100 mB,钢管2,500,加压管10,000.用&2扳手&r设置哪些面负责抽取.",
    "",
    "小型储罐容纳8桶, 中型32桶, 大型128桶."
  ],
  "quest.45AEC6C17B2D353C.title": "过滤厂",
  "quest.41381654B022CD0D.quest_desc": [
    "两种处理特殊工作的实用小机器.",
    "",
    "建造&a方块放置器&r和&2自动切石机&r.放置器能放置各种方块, 包括门和种子; 切石机内部放一把镐, 就能处理切石配方."
  ],
  "quest.22059B7A059A6295.title": "锯木厂",
  "quest.694B3717341A77D5.title": "超导体",
  "quest.6F21487103C2B864.quest_desc": [
    "两件用于查看机器状态的工具.",
    "",
    "制作&a能量分析仪&r和&2机器配置器&r.分析仪显示方块储能, 配置器可将机器的侧面与红石设置复制到另一台."
  ],
  "quest.61FB33A5F7FACDB9.title": "破碎与磨粉",
  "quest.22059B7A059A6295.quest_desc": [
    "木材经过锯切, 产量更高.",
    "",
    "建造&a锯木厂&r.每个原木变成6块木板和一堆锯末, 也能拆解木制物品."
  ],
  "quest.254F71CE27B713D8.quest_desc": [
    "第四阶框架解锁能改变世界的机器.",
    "",
    "用高级框架, 四个充能水晶矩阵和四个硅块制作&a强化高级机器框架&r."
  ],
  "quest.4726F0EF568479F8.quest_desc": [
    "第二阶框架开启流体和组装加工.",
    "",
    "用基础框架, 铁齿轮, 铁棒, 硅和钢制作&a硬化机器框架&r, 解锁流体机器, 热力发电机和组装机."
  ],
  "quest.7F452738E6DA6DE2.quest_desc": [
    "只要能捕获, 雷暴就是大量免费能量.",
    "",
    "在&a闪电发电机&r顶上放一根&2避雷针&r.每次雷击储存1,000,000 FE,最多每刻输出65,536 FE.",
    "",
    "把天气控制器设为雷暴, 就能召来产生闪电的天气."
  ],
  "quest.5F6D849BF0735415.title": "电池箱",
  "quest.39CF1A9F34B62EDD.quest_desc": [
    "本整合包使用的是&eFTB工业奇械&r的高级合金.",
    "",
    "在&2合金炉&r或感应熔炉中制作&a高级合金&r: 一个钢锭, 一个铝锭, 再加两个青铜锭, 一个琥珀金锭或两个殷钢锭."
  ],
  "quest.6AD61318102E2CEE.title": "精英升级",
  "quest.2418AC7F8E4D0437.quest_desc": [
    "第一台机器应当替代普通熔炉.",
    "",
    "建造&a动力炉&r, 耗时为原版一半, 每刻消耗2 FE.安装&2高炉升级模块&r或&a烟熏炉升级模块&r, 可切换到对应配方类型."
  ],
  "quest.4314E0DEC99B8C9C.title": "极速传送带",
  "quest.24394380B59A3DA0.quest_desc": [
    "没有存起来的能量就白白浪费了.",
    "",
    "建造&a充电器&r, 并逐步制作到&2V级电池&r.每阶电池都由前一阶合成, &2放电器&r则能将电池能量送回网络."
  ],
  "quest.4C97C7EB355F1A8C.quest_desc": [
    "每台基础机器都有更快的版本.",
    "",
    "建造&a高级动力炉&r, &2高级磨粉机&r和高级破碎机.磨粉机与破碎机速度提高至四倍, 每个配方消耗10 mB水, 并产生&2脏水&r."
  ],
  "quest.6A59069E389CBA24.title": "水晶生长室",
  "quest.4AD16D2958B25FFB.title": "自动合成器",
  "quest.5A08FA1A20258BB2.quest_desc": [
    "不用床也能跳过夜晚.",
    "",
    "建造&a时间控制器&r, 每次消耗8,388,608 FE,将时间设置到白天, 正午, 夜晚或午夜.时间只会向前推进."
  ],
  "quest.5A08FA1A20258BB2.title": "时间控制器",
  "quest.1B51F2E8350A3145.quest_desc": [
    "模组的各类方块可以用同一件工具配置.",
    "",
    "制作&a扳手&r, 可设置管道抽取面, 传送带斜坡方向和可配置变压器的各面."
  ],
  "quest.41381654B022CD0D.title": "放置与切割",
  "quest.4AD16D2958B25FFB.quest_desc": [
    "手动合成很快就跟不上生产规模.",
    "",
    "建造&a自动合成器&r.放入合成样板, 材料到齐就会制作.高级自动合成器可同时处理多个配方, 精英级则更快."
  ],
  "quest.694B3717341A77D5.quest_desc": [
    "最终线缆需要保持低温的导体.",
    "",
    "先组装&a冷却单元&r, 再用冷却单元, 结晶青金石, 充能合金板和充能金线组装&2超导体&r."
  ],
  "quest.11EABC139262D289.quest_desc": [
    "为单一物品提供大容量存储.",
    "",
    "建造&a微型物品筒仓&r, 可存单种物品50组, 只能通过漏斗, 传送带等自动化设备存取; 巨型筒仓则可存1,000组."
  ],
  "quest.65A01F46F7044328.quest_desc": [
    "模组所有机器都以框架为基础, 第一阶就是&a基础机器框架&r.",
    "",
    "制作&a基础机器框架&r.本整合包的配方中央需要&2钢锭&r, 可在&a合金炉&r中用一个铁锭和一个煤炭制作.",
    "",
    "基础机器框架也是&d电工&r的工作站.电工出售线缆绝缘体, 电池, 线缆和部分初期机器."
  ],
  "quest.06701D04327780C6.quest_desc": [
    "一台合成机, 多个配方.",
    "",
    "建造&a高级自动合成器&r.它能同时存放多个样板, 合成速度是基础版的两倍."
  ],
  "quest.537D4A1C121F9114.title": "精英电池箱",
  "quest.5A559FF1147D2459.title": "充电站",
  "quest.454517F5F0917F46.title": "太阳能板",
  "quest.65A01F46F7044328.title": "基础机器框架",
  "quest.1B95E11A97F6D2C6.title": "热力发电机",
  "quest.196DBB74F9A47B69.quest_desc": [
    "&e充能能源&r是一条完整科技路线, 从发电机, 线缆和加工机器, 一直发展到传送玩家, 改变天气的机器.",
    "",
    "从左到右逐级制作机器框架.每个新框架解锁下一批机器, 上下方任务分别介绍它解锁的设备.",
    "",
    "&e注意&r: 本整合包修改了部分内容: 移除燃煤引擎, 第一阶框架需要钢, 许多板, 线和粉末改由&eFTB材料&r提供."
  ],
  "quest.0004A2325D5DE642.quest_desc": [
    "基础级以上电路需要组装, 不能直接合成.",
    "",
    "建造&a组装机&r, 可制作高级电路, 处理单元, 太阳能电池, 以及后期框架需要的水晶矩阵."
  ],
  "quest.3C141E8FE709BDF2.title": "天气控制器",
  "quest.64D5A4564AB0C180.title": "感应熔炉",
  "quest.2A868E9D86980F2C.quest_desc": [
    "模组提供了自己的手册.",
    "",
    "制作&a充能能源手册&r, 手持它左键点击本模组方块, 即可打开对应页面.",
    "",
    "&e注意&r: 部分页面描述的是已被本整合包改动的内容, 例如燃煤引擎, 以及石英熔炼硅."
  ],
  "quest.3F44E3225E41C7CF.title": "精英机器框架",
  "quest.5C58946645097EBF.quest_desc": [
    "结晶青金石生长得很慢.",
    "",
    "在水晶生长室中培育&a结晶青金石&r.八个青金石需要128,000刻才能长成一个, 未升级时超过五个游戏日; 但用一个晶体再生只需32,000刻, 所以记得保留第一个.",
    "",
    "&e注意&r: 其提示建议开始前先在生长室安装两套VI级升级."
  ],
  "quest.3F44E3225E41C7CF.quest_desc": [
    "顶级框架需要昂贵合金.",
    "",
    "将结晶青金石, 水晶矩阵和高级合金制成&2结晶合金&r, 再消耗8,388,608 FE充能为&a充能合金&r, 用它们制作&a精英机器框架&r.",
    "",
    "&e注意&r: 充能器需要IV级或更好的能量容量升级模块, 才能容纳制作充能合金所需的能量."
  ],
  "quest.5A559FF1147D2459.quest_desc": [
    "不必再把工具一件件取下来充电.",
    "",
    "建造&a充电站&r, 它会为7格内所有玩家的物品充电.范围升级模块可进一步扩大距离."
  ],
  "quest.6AD61318102E2CEE.quest_desc": [
    "VII和VIII级升级以精英模块为基础.",
    "",
    "制作&a精英升级模块&r.VIII级速度升级将速度提高至40倍, 耗能提高至80倍; VIII级能量容量升级将储能和传输提高至80倍."
  ],
  "quest.39CF1A9F34B62EDD.title": "高级合金",
  "quest.52A6CCD14E5E5144.quest_desc": [
    "燃煤引擎被移除后, 初期能源来自熔岩或太阳能.",
    "",
    "建造&a热能发电机&r, 在侧面放熔岩.每个接触的静止熔岩源提供25 FE/t,流动熔岩提供15;六面都有熔岩时最高150 FE/t."
  ],
  "quest.3CAB8C8CA70E31C9.title": "植物生长室",
  "quest.7F452738E6DA6DE2.title": "闪电发电机",
  "quest.254F71CE27B713D8.title": "强化高级框架",
  "quest.2CE134BC4AFE943F.quest_desc": [
    "基础传送带每10刻使物品前进一步.",
    "",
    "制作&a高速物品传送带&r, 每6刻前进一步."
  ],
  "quest.6F21487103C2B864.title": "分析仪与配置器",
  "quest.2D9A1A4DBC4D54BC.title": "岩石与水",
  "quest.61B9CB144078F595.quest_desc": [
    "舍不得八百万FE的人才需要走路.",
    "",
    "建造两个&a传送器&r和一个&2传送器矩阵&r.用矩阵潜行右键点击目的地传送器进行绑定, 再把矩阵放进另一台, 站上去用红石或传送快捷键触发.",
    "",
    "每次传送消耗全部8,388,608 FE储能, 支持跨维度."
  ],
  "quest.2CC87ECDB76CCBD1.quest_desc": [
    "第三阶框架让生产真正快起来.",
    "",
    "用硬化框架, 两个高级合金, 硅和四个黄铜锭制作&a高级机器框架&r.",
    "",
    "在&2合金炉&r中, 锌和铜各一个锭合成一个黄铜锭.没有锌矿石, 锌来自磨粉玄武岩."
  ],
  "quest.0D6C804C2A6E9ECE.quest_desc": [
    "压模需要配合压印机使用.",
    "",
    "建造&a金属压印机&r.装入压模后, 可将金属板压成线, 棒或齿轮, 每次加工都会略微磨损压模.",
    "",
    "金属板由&2压缩机&r制作."
  ],
  "quest.627553EDEFCE9C01.quest_desc": [
    "这里的齿轮和棒不能直接在合成栏中制作.",
    "",
    "建造&a压模制造机&r, 将黏土制成压模坯并熔炼.&a齿轮压模&r和&2杆压模&r能让金属压印机生产下一阶框架所需的铁齿轮和铁棒.",
    "",
    "基础压模可用2,000次, 硬化, 高级和精英压模的耐久则高得多."
  ],
  "quest.5D5E354DBE1226B7.title": "水晶矩阵",
  "quest.763CFE19384B50BF.quest_desc": [
    "涡轮传送带每刻使物品前进一步.",
    "",
    "制作&a涡轮物品传送带&r.它需要结晶合金, 因此属于后期设备."
  ],
  "quest.454517F5F0917F46.quest_desc": [
    "太阳能板只需要露天和日光.",
    "",
    "制作并升级&a太阳能板&r到III级.每级都由前一级制作, 本整合包中I至VII级的峰值产能依次为每刻2,16,64,256,512,4,096和16,000 FE.",
    "",
    "&e注意&r: 月光升级模块可让它们在夜间继续工作."
  ],
  "quest.1B95E11A97F6D2C6.quest_desc": [
    "把熔岩泵进发电机, 不必再倒在周围.",
    "",
    "建造&a热力发电机&r并输入熔岩.本整合包中, 每桶熔岩提供10,000 FE,最高每刻消耗相当于500 FE的燃料."
  ],
  "quest.5A1884B152041DF2.title": "传送带",
  "quest.52A6CCD14E5E5144.title": "热能发电机",
  "quest.196DBB74F9A47B69.title": "充能能源",
  "quest.535CC5C59EEBAEF1.title": "管道与储罐",
  "quest.5A1884B152041DF2.quest_desc": [
    "传送带无需管道即可运输物品, 而且物品始终可见.",
    "",
    "制作&a物品传送带&r, &2传送带装载机&r和传送带分拣机.装载机从容器抽取物品放上带面, 传送带将物品送入朝向的目标, 分拣机则按过滤规则将物品送向左, 前或右.",
    "",
    "各等级还有分离器, 合并器和切换器可供配套."
  ],
  "quest.6CD01296F218E3A9.quest_desc": [
    "多数机器支持升级, 最便宜的升级也值得尽早安装.",
    "",
    "制作&a基础升级模块&r, 再加工成&2I级速度升级模块&r.速度I将速度提高至1.2倍, 耗能提高至1.4倍; 能量效率, 能量容量, 物品弹出和物品抽取模块也通过同样方式制作.",
    "",
    "升级需要手动放入机器的升级界面.更高等级则以高级, 强化和精英模块为基础."
  ],
  "quest.06701D04327780C6.title": "高级自动合成器",
  "quest.2CE134BC4AFE943F.title": "高速传送带",
  "quest.5FE464F00FF65F8E.title": "液态经验",
  "quest.2CC87ECDB76CCBD1.title": "高级机器框架",
  "quest.3C141E8FE709BDF2.quest_desc": [
    "随时下雨, 或永远放晴.",
    "",
    "建造&a天气控制器&r, 可切换晴天, 下雨或雷暴, 每次清空8,388,608 FE储能.持续时间升级模块延长天气持续时间, VI级可在持续供能时一直维持天气."
  ],
  "quest.2D9A1A4DBC4D54BC.quest_desc": [
    "水和熔岩变成方块, 方块又能变回流体.",
    "",
    "建造&a岩石固化器&r, &2岩石液化器&r和流体冷冻机.固化器用水和熔岩制作圆石, 石头和黑曜石, 液化器将石头熔成熔岩, 冷冻机则把水变成冰和雪."
  ],
  "quest.2A868E9D86980F2C.title": "充能能源手册",
  "quest.6A59069E389CBA24.quest_desc": [
    "有些材料只能培育.",
    "",
    "建造&a水晶生长室&r, 可生长紫水晶碎片, 紫水晶母岩和结晶青金石, 本整合包中还能培育&e矿石晶洞&r宝石的碎片和母岩.",
    "",
    "它每刻消耗1,024 FE,配方用时16,000至128,000刻, 尽早安装速度升级吧."
  ],
  "quest.763CFE19384B50BF.title": "涡轮传送带",
  "quest.24394380B59A3DA0.title": "充电与电池",
  "quest.11EABC139262D289.title": "物品筒仓",
  "quest.5D5E354DBE1226B7.quest_desc": [
    "下一阶框架需要充能水晶.",
    "",
    "用紫水晶, 钻石, 绿宝石和红石合金组装&a水晶矩阵&r, 再消耗524,288 FE充能为&2充能水晶矩阵&r."
  ],
  "quest.627553EDEFCE9C01.title": "压模",
  "quest.4726F0EF568479F8.title": "硬化机器框架",
  "quest.2D1B85CD83A93F5E.title": "超导电缆",
  "quest.4C97C7EB355F1A8C.title": "高级加工",
  "quest.3CAB8C8CA70E31C9.quest_desc": [
    "农场不一定需要农田.",
    "",
    "建造&a植物生长室&r.种子放种子槽, 土壤方块放土壤槽, 提供水和能量即可生长.",
    "",
    "土壤决定效率.耕地让生长速度变为1.5倍且耗能更少, 泥巴使耗水减半, 菌丝体让蘑菇生长速度翻倍.第三个槽放肥料可以进一步加快, 但耗能也会提高."
  ],
  "quest.64D5A4564AB0C180.quest_desc": [
    "合金炉燃烧燃料, &a感应熔炉&r则用能量处理同样的合金配方.",
    "",
    "建造&a感应熔炉&r, 合金加工时间减半, 每刻消耗64 FE."
  ],
  "quest.2D1B85CD83A93F5E.quest_desc": [
    "即使是充能水晶矩阵线缆, 每刻传输上限也只有2,097,152 FE.",
    "",
    "制作&a超导电缆&r, 每刻传输16,777,216 FE,是本模组线缆中的最高值.和其他线缆一样, 不同等级间只能通过变压器连接."
  ],
  "quest.1B51F2E8350A3145.title": "扳手",
  "quest.61FB33A5F7FACDB9.quest_desc": [
    "两种机器都能分解物品, 但用途不同.",
    "",
    "建造&a磨粉机&r和&2破碎机&r.磨粉机将矿石和锭磨成粉, 有概率产出额外副产物; 破碎机则把石头逐步处理成圆石, 沙砾和沙子.",
    "",
    "两者每刻消耗8 FE,高级版本随高级框架解锁.",
    "",
    "没有锌矿石可挖, 改用&2玄武岩&r磨粉: 产出黑石, 并有5%的概率额外得到&a锌粉&r, 高级磨粉机中为10%.半自磨机或打粉机也可处理."
  ]
