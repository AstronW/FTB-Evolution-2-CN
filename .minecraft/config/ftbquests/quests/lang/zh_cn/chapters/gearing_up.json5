{
  "quest.427682661459BB4F.title": "&b稳定附魔",
  "task.1B78C40E21D23DD0.title": "升级下界书架",
  "quest.0EE35D6E57FAD973.quest_subtitle": "存储附魔!",
  "quest.34644FD6DAAE8F0C.quest_desc": [
    "所有超出基础范围的锤子都需要核心.第一个&d冲击核心&r消耗一把下界合金锤, 之后每个核心都由前一个制作.",
    "",
    "冲击锤挖掘3×3×3,而非3×3."
  ],
  "task.1E99CDD9919D994A.title": "&a工匠卷轴",
  "quest.34644FD6DAAE8F0C.title": "&d下界合金的代价",
  "quest.6F16FFDCE6A35C31.title": "&b采矿工具",
  "quest.4BCEA2880B22CC55.title": "&6遗物",
  "quest.6F16FFDCE6A35C31.quest_desc": [
    "&b采矿工具&r是一把对着岩壁使用的电动激光钻.",
    "",
    "共有&aMK1&r至&dMK3&r三个等级, 真正丰富的功能来自&3改装台&r中安装的升级模块:",
    "",
    "- &2电池&r1至3级增加容量, &a效率&r1至5级降低能耗.",
    "- &a3×3&r和&a范围&r决定一次破坏多少方块.",
    "- &2时运&r和&a精准采集&r决定获得什么.",
    "- &a销毁杂物&r在挖掘时丢弃圆石和泥土.",
    "- &2照明放置器&r在身后放光源, 避免隧道刷怪.",
    "- &a冻结&r处理挖穿后遇到的水和熔岩."
  ],
  "quest.27E2F70FDEE0F003.title": "一个灵魂绑定护符",
  "quest.3D8CC5CFBD665D40.title": "&6Little Joys",
  "quest.4498E3F4B2DC24FC.quest_desc": [
    "要开始打造终极&e神化&r装备, 先战斗或探索, 收集&b宝石&r!",
    "",
    "&b宝石&r镶入&b词缀&r物品后, 会提供强力加成.",
    "",
    "在&2锻造台&r中将&b宝石&r与物品组合.物品必须有空的&a宝石镶孔&r.",
    "{@pagebreak}",
    "宝石镶入不同物品类型时, 提供不同加成, 也可在&a宝石切割台&r升级.",
    "",
    "&c独特宝石&r每件物品只能镶一个, 大多数其他宝石则能重复镶嵌, 叠加效果.",
    "",
    "击杀生物和首领, 可以获得多种&e神化&r&b宝石&r.",
    "{@pagebreak}",
    "&b宝石&r还可以用铁砧砸成&a宝石粉&r.",
    "",
    "&a宝石粉&r用途很多, 首先应制作&2回收台&r!"
  ],
  "task.601DC826C875D69F.title": "BEER修饰效果",
  "quest.17CD2138836B714A.quest_desc": [
    "有些箱子更容易找到遗物.",
    "",
    "- &a堡垒遗迹宝库&r: 65%的箱子有一件.",
    "- &2大型海底废墟&r: 45%.",
    "- &a林地府邸&r: 40%.",
    "",
    "刷扫可疑的沙子和沙砾, 约有6%的概率发现一件."
  ],
  "quest.23D4C14AE83B5C7A.quest_desc": [
    "&c宝箱怪&r在打开之前与箱子完全一样, 每只死亡都掉一件遗物.",
    "",
    "它们藏在y=-60至y=40的地下营地, 大约三分之一的箱子是宝箱怪."
  ],
  "task.77F4EF2435BBA602.title": "重置体能技能",
  "quest.722901B4259D8AEC.quest_desc": [
    "下一目标是将&a位阶&r升至60,&c量子化&r和&d阿卡那&r都到40,需要先解锁&5攀升&b世界层级&r.",
    "",
    "这需要升级&d灌注书架&r."
  ],
  "quest.4BDD9230BBA6C0A0.title": "生命之心的无限力量",
  "quest.4BCEA2880B22CC55.quest_desc": [
    "&e遗物&r是被动饰品, 主要从&a宝箱怪&r及世界箱子中找到, 而非合成.",
    "",
    "装入饰品槽就能生效, 以下几种值得留意:",
    "",
    "- &a云朵瓶&r: 二段跳.",
    "- &2脚蹼&r和&a水上漂鞋&r: 改善水中移动.",
    "- &a狂野之爪&r和&2掘地之爪&r: 攻击与挖掘速度.",
    "- &2生命水晶&r: 额外生命.",
    "- &a十字项链&r: 延长受伤无敌时间.",
    "- &2解毒容器&r: 清除负面效果.",
    "- &a持久牛肉&r和&2永恒牛排&r: 永不吃完.",
    "",
    "&7&o它们能与其他效果叠加, 每个箱子都看看.&r"
  ],
  "quest.4DF8D485A9EDD069.quest_desc": [
    "亲手击杀牛, 有0.2%的概率掉落&6持久牛肉&r, 食用永不消耗.",
    "",
    "烹饪为&6永恒牛排&r, 食物效果更好, 同样永不消耗."
  ],
  "quest.172FD7459907AADE.title": "重置远程技能",
  "task.7AFA5CC185A71520.title": "欢迎来到&e神化",
  "quest.3A7774F5F0FD174E.title": "升级书架",
  "quest.3900E67C8B833980.title": "&a工匠卷轴",
  "quest.00249E1AFEF0051A.title": "更好的移动方式",
  "quest.401680035DEE0D0A.quest_desc": [
    "本模组所有枪械共用&a子弹&r, 一组弹药就能供应整个收藏.",
    "",
    "用&a黑火药&r和金属制作, &a铁&r每次16发, &2铜&r只有4发.铁宽裕后就别再用铜.",
    "",
    "&7&o随身携带合成材料, 战斗中弹尽粮绝, 往往就是这些枪导致你丧命的方式.&r"
  ],
  "quest.750007D8FAA2EA03.quest_desc": [
    "游玩时两个数值会增长: &a等级&r来自经验, 绑定伙伴在外且距你32格内时, 获得你经验的一半; &a羁绊&r来自相处时间, 在外陪伴时每秒一点.",
    "",
    "在刷怪场刷经验会让学习速度降至十分之一, 移动三个区块外即可重置.",
    "",
    "每十分钟喂一次驯服物品, 获得羁绊提升.羁绊5解锁种族特殊能力, 15和30让定时能力触发频率分别翻倍和四倍.",
    "{@pagebreak}",
    "空手对它使用可打开背包, 背包属于你而非伙伴, 因此死亡或休息都不会丢东西, 羁绊提高还会解锁更多槽位.",
    "",
    "30级时羁绊界面开放&6转生&r, 伙伴降回1级并获得一颗星, 最多五颗, 保留羁绊和装备.死亡后护符五分钟复活它, 高羁绊时更快."
  ],
  "quest.26D7C5298D95C69A.quest_desc": [
    "制作&b珠宝&r时, &a环带材料&r单独也能提供效果或属性加成.",
    "",
    "主要用途则是通过品质倍率, 放大&a宝石&r效果.",
    "",
    "大多数原版宝石可用, 也可在JEI搜索&a#jewelry_band&r查看列表."
  ],
  "quest.7244D5DADCF0D7A2.quest_desc": [
    "&b水之过滤海洋书架&r最多装六本附魔书, 阻止对应附魔再次出现.",
    "",
    "&c诅咒附魔&r也有效!"
  ],
  "quest.3A53BB7A6B708966.title": "&c灌注下界书架",
  "quest.26B74124E89189F7.quest_desc": [
    "最终附魔等级的基础书架.",
    "",
    "除了需要&d灌注龙息&r, 末地书架其实相当便宜."
  ],
  "quest.4352595953CF7834.quest_desc": [
    "&eIron的武备与巧械&r栏中的两顶帽子有实际用途: &a牛仔帽&r在击杀时立即装填枪械, 触发有冷却; &2三角帽&r提高满弹匣第一发伤害.",
    "",
    "两者都从&a皮革帽子&r起步, 成本很低, 但占头部槽, 需要在头盔防护和效果之间取舍.",
    "",
    "&7&o对付人群戴牛仔帽, 一发强力开场决定胜负时戴三角帽.&r"
  ],
  "quest.4DE483256F9E1D4F.quest_desc": [
    "&a摘除符石&r移除物品上全部已镶&b宝石&r, 不伤害物品."
  ],
  "quest.375EB6B5189844BD.quest_desc": [
    "&c突变僵尸&r有150点生命, 倒地后会复起三次.倒下时保持燃烧, 或用打火石点燃尸体, 就不再复起, 必定掉落&a巨人之锤&r."
  ],
  "task.1074D584B5693F60.title": "任意伙伴装备",
  "quest.1A7186E64604523F.title": "&eIron的武备与巧械",
  "quest.565F0889EF67521D.quest_desc": [
    "七种伙伴各有获取方式.&a迷你玩家&r需要购买, 所有流浪商人都卖一个&a迷你玩家刷怪蛋&r, 32绿宝石, 每名商人限一次.",
    "",
    "放下后用金胡萝卜驯服, 每根三分之一概率.默认使用你的皮肤, 也可在羁绊界面的皮肤框输入其他玩家名.近距离挥舞你手中武器的副本, 六格外改用弓.",
    "",
    "羁绊5的帮手能力, 让可堆叠合成产物有5%概率翻倍.",
    "{@pagebreak}",
    "它是七种中成长最慢的, 做好长期培养准备.其他伙伴:",
    "- &a恐狼&r: 对任意狼使用金骨头.",
    "- &a霸王龙&r: 从可疑的沙子挖出霸王龙蛋, 等待孵化.",
    "- &a幼龙&r: 让熔岩流向已放置的龙蛋.",
    "- &a夜狐&r: 对狐狸使用幽匿块.",
    "- &a小魔怪&r: 先给兔子胡萝卜, 再在午夜后喂熟鸡肉.",
    "- &a短尾矮袋鼠&r: 在丛林野生."
  ],
  "quest.4352595953CF7834.title": "&d实用帽子",
  "quest.7313C557C45DCFAD.quest_desc": [
    "返还近战技能树已花费的技能点."
  ],
  "quest.31A91FBA7673D2B3.quest_desc": [
    "装备全套&2罕见&r或更高品质词缀装备, 再击杀一个&c神化入侵者&r.",
    "",
    "必须先解锁&a边境&r, 因此先完成FTB天际号.",
    "",
    "入侵者只在边境或更高层级生效时生成, 狩猎前先切换层级."
  ],
  "quest.59CBFA5583139A3B.title": "{\"text\":\"重铸台\",\"color\":\"#B900B9\"}",
  "quest.79A0CEB28D8EC670.title": "&6毁灭",
  "quest.67E71C9B1037A2C0.title": "&c骸骨盔甲",
  "task.46C4540DF9CFCF9E.title": "重置体能技能",
  "quest.565F0889EF67521D.title": "&a迷你玩家",
  "quest.044A192E503B766B.title": "给我修补一下!",
  "quest.718A5799ACCEFFF3.title": "&d分级刷怪笼符文",
  "quest.226E5BD0BEB1BA75.quest_desc": [
    "这些特殊书架提供特定加成, 例如增加100%&c量子化&r, 或移除&c量子化&r和&5阿卡那&r."
  ],
  "quest.2722C0E2E8993658.title": "&6100级附魔",
  "quest.268CC540E5B605A9.title": "&d获得启迪",
  "quest.18198810B4198724.title": "&a伙伴装备",
  "quest.59CBFA5583139A3B.quest_desc": [
    "[\"这座\",{\"text\":\"重铸台\",\"color\":\"#B900B9\"},\"是\",{\"text\":\"简易重铸台\",\"color\":\"#55FF55\"},\"的改良版, 能重铸所有品质, 包括\",{\"text\":\"神话\",\"color\":\"#EA6F14\"},\"和\",{\"text\":\"崇高\",\"color\":\"#FBD174\"},\"物品.\"]"
  ],
  "quest.54013FF4444B76EB.title": "最饰合你的心之项链",
  "quest.5382CB05500E49DE.quest_desc": [
    "将&a位阶&r提升至最高后, 就可以制作&z渡鸦附魔台&r.",
    "",
    "这种附魔台无需附近书架, 就能手动配置&a位阶&r, &c量子化&r和&d阿卡那&r数值."
  ],
  "quest.192EB03700278BE2.quest_desc": [
    "&d遗物苹果&r不只是一颗普通苹果.",
    "",
    "食用提供增益, 并立即治疗."
  ],
  "quest.26B74124E89189F7.title": "&d末地书架",
  "quest.0CF882A83FB8931D.title": "&3六发左轮",
  "quest.00A7C1FE54F86429.quest_desc": [
    "&e神化&r用三个新属性改造原版附魔, 配合可升级的发展路线, 实现高等级附魔.升级设施时, 需要管理这些数值:",
    "",
    "[\"\",{\"text\":\"位阶\",\"color\":\"green\"},\":附魔台的力量, 上限取决于书架等级及\",{\"text\":\"世界层级\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"011DBD2652E49B97\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"action\":\"show_text\",\"value\":\"前往世界层级任务\"}},\",决定可出现附魔的最高等级.\"]",
    "",
    "&c量子化&r: 高能附魔固有的混沌, 决定附魔随机性.",
    "",
    "&d阿卡那&r: 附魔的总体品质和数量, 决定稀有程度, 以及每次附上的魔咒数量."
  ],
  "quest.31A91FBA7673D2B3.title": "&b攀升",
  "quest.2722C0E2E8993658.quest_desc": [
    "完整附魔设施的中心.",
    "",
    "&d巨龙末地书架&r不提供其他属性, 但将&a位阶&r上限提高20,让你达到最高&6100&r.",
    "",
    "&d璀璨末地书架&r是最好的通用书架, 提供大量&c量子化&r和&5阿卡那&r."
  ],
  "quest.65DAC5AA05C91055.quest_desc": [
    "最高层级, 装备全套&5史诗&r或更高品质词缀装备, 击败&d末影龙&r.",
    "",
    "必须先解锁&d高峰&r.",
    "",
    "这里生物最强, 奖励也最好."
  ],
  "quest.5B8C8E2EC1DA1FF0.quest_desc": [
    "&b滑翔伞&r把坠落变为可控下降, 下落时手持即可滑翔, 避免摔落.",
    "",
    "滑翔消耗&a精力&r, &2精力容器&r每个增加五分之一圈, 最多10个.本包由&6黑市&r出售, 这位游商有时替代流浪商人出现.精魄和心之容器已禁用.",
    "",
    "持续滑翔约&c125秒&r就会耗尽耐久, 用&a皮革&r在铁砧修复.",
    "",
    "&7&o本包鞘翅也算滑翔伞, 可手持以相同方式使用.&r"
  ],
  "quest.7552BF792403EF44.quest_desc": [
    "&6精湛视界下界书架&r每个提供2条&3附魔线索&r, 而非1条."
  ],
  "quest.01D2CEAF59872C33.title": "&a宝石柜",
  "quest.183211CBBF56C4E1.title": "&d化合物X",
  "quest.0EE35D6E57FAD973.title": "&d魔咒图书馆",
  "quest.5B8C8E2EC1DA1FF0.title": "&b滑翔伞",
  "quest.0DA16C872BC27E21.title": "&c突变怪物",
  "quest.180F6058F80F1E1B.quest_desc": [
    "在&c突变苦力怕&r死亡前伤害过它, 它就会留下&a苦力怕爪牙蛋&r.破蛋有概率获得&a苦力怕残片&r: 充能蛋必掉, 普通蛋三分之一概率.",
    "",
    "放置60至100分钟, 会孵出驯服的苦力怕爪牙."
  ],
  "quest.4BBF090D430EC4A9.title": "&6遗物收藏家",
  "task.4544EA17F4CDD321.title": "理解词缀物品",
  "quest.26D7C5298D95C69A.title": "&a环带材料",
  "quest.6CB85481E967E81A.title": "&6建筑工具",
  "quest.3A53BB7A6B708966.quest_desc": [
    "注入魔力的书架, 解锁更多可能."
  ],
  "quest.2F50137C675E49F9.title": "&a扫描器",
  "quest.401680035DEE0D0A.title": "&a子弹",
  "quest.464AED8311A32476.title": "&f理解&a词缀&r物品",
  "quest.29513BD00064E27D.title": "重置采矿技能",
  "quest.31AF46B183F805E3.quest_desc": [
    "&6发条步枪&r是最高一级, 需要&6下界合金&r, 一套&a发条组件&r, &2漏斗&r和红石中继器, 因此要在首次下界之旅很久后才能制作.",
    "",
    "&a火绳枪&r同属发条等级, 但材料便宜得多, 想节省部件时可以选它.",
    "",
    "&7&o最好的改装件留给这里, 这把步枪的槽位比燧发枪更有价值.&r"
  ],
  "quest.427682661459BB4F.quest_desc": [
    "&c量子化&r为附魔判定增加随机性, 混沌最大时, 可能得到+100%或-100%力量.",
    "",
    "&b稳定性&r抵消负面影响, 保留全部收益, 消除坏处."
  ],
  "quest.26118B733B805236.title": "&7居所",
  "quest.2AFF075509A04B7E.quest_desc": [
    "穿全套&f普通&f或更高品质词缀盔甲, 手持一件词缀武器.",
    "",
    "解锁层级不会自动切换, 请打开层级界面, 手动启用&a边境&r.",
    "",
    "边境起, &c神化入侵者&r开始在世界生成."
  ],
  "task.1597C2CB4B03B2C2.title": "任意#artifacts:artifacts",
  "quest.30689B890F5E7A03.quest_desc": [
    "要继续提高&6位阶&r, 需要制作并灌注&3深暗书架&r, 还要达到高峰&b世界层级&r.",
    "",
    "这些书架可将&6位阶&r推到最高&a75&r.",
    "",
    "&z奥术宝藏深暗书架&r还能让附魔台产出&z宝藏型魔咒&r."
  ],
  "task.0F868488088CDEC1.title": "BEER",
  "quest.011DBD2652E49B97.quest_desc": [
    "[\"\",{\"text\":\"神化\",\"color\":\"yellow\"},\"具有\",{\"text\":\"世界层级\",\"color\":\"aqua\"},\"系统, 按下\",{\"keybind\":\"key.apotheosis.open_world_tier_select\",\"color\":\"yellow\",\"hover_event\":{\"action\":\"show_text\",\"value\":\"默认: CTRL + T\"}},\".\"]",
    "",
    "[\"你起初处于\",{\"text\":\"居所\",\"color\":\"#7E7E7E\"},\",获得第一件\",{\"text\":\"词缀物品\",\"color\":\"#55FF55\"},\"后开启, 并随模组发展解锁更多层级.\"]",
    "",
    "更高层级提高所有维度生物的属性和奖励, 同时降低&a位阶&r上限, 具体见层级菜单."
  ],
  "quest.23C3A724DE53F3B2.title": "重置魔法技能",
  "quest.24730AF0C707CF79.quest_desc": [
    "&c这是整合包特有玩法, 其他地方没有相关文档.",
    "",
    "给&a马&r装备&b滑翔伞&r, 它就成为&d飞马&r, 获得飞行, 像骑马一样操控即可.",
    "",
    "任何算作滑翔伞的物品都行, 包括&a鞘翅&r, 不过鞘翅较低的耐久只能让马飞约11分钟.",
    "",
    "骑乘飞行消耗滑翔伞耐久远慢于徒步滑翔.满耐久约&a62分钟&r, 而自己滑翔仅约两分钟.仍用&a皮革&r在铁砧修复.",
    "",
    "&7&o翅膀装上了, 马却不离地, 说明滑翔伞已无耐久.&r"
  ],
  "quest.38E0212362E87E99.title": "&d末影之手",
  "quest.4BBF090D430EC4A9.quest_desc": [
    "同时携带十件遗物, 任意十件都算, 允许重复.",
    "",
    "宝箱怪及前述宝箱, 是最快的收集方式."
  ],
  "quest.7E88C7654F281E43.quest_desc": [
    "[\"这张\",{\"text\":\"强化台\",\"color\":\"#EA6F14\"},\"是终局工作站, 用于强化物品的单个\",{\"text\":\"词缀\",\"color\":\"#55FFFF\"},\".\"]",
    "",
    "有两种用途:",
    "",
    "[\"第一, 升级已有\",{\"text\":\"词缀\",\"color\":\"#55FFFF\"},\",消耗两个\",{\"text\":\"强化符石\",\"color\":\"#EA6F14\"},\",将该\",{\"text\":\"词缀\",\"color\":\"#55FFFF\"},\"提高25%.具体提升取决于各个\",{\"text\":\"词缀\",\"color\":\"#55FFFF\"},\".\"]",
    "{@pagebreak}",
    "[\"第二, 重新随机一个\",{\"text\":\"词缀\",\"color\":\"#55FFFF\"},\",消耗一个\",{\"text\":\"强化符石\",\"color\":\"#EA6F14\"},\",将选中的\",{\"text\":\"词缀\",\"color\":\"#55FFFF\"},\"换为同类型的另一个, 左侧显示可选结果.\"]",
    "",
    "[\"这张\",{\"text\":\"强化台\",\"color\":\"#EA6F14\"},\"有两个输入槽, 上方放要进行\",{\"text\":\"强化\",\"color\":\"#FF55FF\"},\"的物品, 必须是\",{\"text\":\"词缀\",\"color\":\"#55FFFF\"},\"物品.下方放入\",{\"text\":\"强化符石\",\"color\":\"#EA6F14\"},\",用于\",{\"text\":\"强化\",\"color\":\"#FF55FF\"},\".\"]"
  ],
  "quest.27E2F70FDEE0F003.quest_desc": [
    "再进一步, &b灵魂项链&r容纳更多生命容器.每加一个&a魂心容器&r, 生命上限就继续提高.",
    "",
    "它还像&6不死图腾&r一样, 在你即将&c死亡&r时消耗一个&a魂心容器&r, 将其退回为&b蓝心容器&r."
  ],
  "quest.01D2CEAF59872C33.quest_desc": [
    "&d宝石柜&r存储并升级&b宝石&r.",
    "",
    "它直接升级自只能提升宝石的&a宝石切割台&r.",
    "",
    "升级&b宝石&r消耗&a宝石粉&r, 品质材料, 以及第二颗同品质&b宝石&r.品质越高, 升级&b宝石&r所需材料和粉末越多, 具体消耗见界面."
  ],
  "quest.44C341DE3BCD64CC.quest_desc": [
    "这个&d魔咒图书馆&r的升级版, 可储存最高31级的附魔数值.",
    "",
    "注意, 实际取出的附魔书仍受整合包正常等级上限限制."
  ],
  "quest.7244D5DADCF0D7A2.title": "&b过滤不想要的附魔",
  "quest.3EFAC6FC58219F86.title": "&6建筑棒",
  "quest.266D0151DF0A7BA5.quest_desc": [
    "&z精力之弓&r类似&b心之项链&r, 拥有独立的&2生命容器&r槽位.",
    "",
    "每个&2生命容器&r为弓增加&b1&r点伤害和拉弓速度."
  ],
  "quest.496903AB7E8A0A92.title": "&f欢迎使用&eIron's Gems \\&\\ Jewelry&r!",
  "quest.75BC832C835585E2.title": "&3机械加工部件",
  "quest.78BCE2A8F87EB08B.title": "&z友谊之剑",
  "quest.4BCA8A5C3F80D375.quest_desc": [
    "&a除名符石&r移除物品的词缀名称, 恢复普通物品名.",
    "",
    "例如, &d斩食人魔者恩道恩的御法者风袭焦靴&r会改名为&d焦靴&r."
  ],
  "quest.0CF882A83FB8931D.quest_desc": [
    "&a六发左轮&r是中级部件路线的第一把枪, 需要一套&2机械组件&r, 一个&a漏斗&r, 铁和原木.",
    "",
    "&a黑火药左轮&r同级, 用&2黑火药&r替代其中一个铁锭.在JEI中比较提示, 选择适合自己射速和装填习惯的."
  ],
  "quest.3D8CC5CFBD665D40.quest_desc": [
    "&eLittle Joys&r在游玩途中加入自动出现的小惊喜, 无需制作或建造, 只需留意.",
    "",
    "移动时附近地面会出现&a挖掘点&r, 挖开获得一点宝藏.",
    "",
    "&b钓鱼点&r是水面的冒泡区域, 向其中抛竿, 会钓出宝藏而非鱼.这与&3海蓝科技&r的&b幸运区域&r几乎相同, 但两者是独立系统, 都奖励留意水面的玩家.",
    "",
    "&6淘金潮&r和&a掉落潮&r在采矿, 破坏方块时触发, 散落额外掉落物供你收集.",
    "{@pagebreak}",
    "&3坠星&r偶尔划过, 接住获得祝福:",
    "",
    "- &a丰饶之星&r: 复制方块掉落.",
    "- &2繁荣之星&r: 为种下的植物施骨粉, 并让繁殖动物产双胞胎.",
    "- &a命运之星&r和&2宁静之星&r: 另外两种祝福.",
    "",
    "祝福强度随使用衰减, 从&7衰微&r, 到&f发光&f, &3璀璨&r及&6辉煌&r.",
    "",
    "&7&o不必刻意追逐, 都是日常活动之外的额外收获.&r"
  ],
  "quest.60FDF616DEDE5E73.title": "&b神化宝石&r!",
  "task.7730E1475241BC5B.title": "重置体能技能",
  "quest.67E71C9B1037A2C0.quest_desc": [
    "&c突变骷髅&r死亡碎成18块骨头, 6,000刻后消失前, 右击逐个拾起.一只正好做一套盔甲.",
    "",
    "头骨头盔为你射出的任意弓增加一级多重射击."
  ],
  "quest.4DF8D485A9EDD069.title": "&6永恒牛排",
  "quest.23C3A724DE53F3B2.quest_desc": [
    "返还魔法技能树已花费的技能点."
  ],
  "quest.180F6058F80F1E1B.title": "&c苦力怕残片",
  "quest.0DA16C872BC27E21.quest_desc": [
    "僵尸, 骷髅, 苦力怕或末影人偶尔以&c突变体&r生成, 体型更大, 有独特攻击和标志掉落.生成地点与原生物相同, 生成权重为其5%."
  ],
  "quest.54013FF4444B76EB.quest_desc": [
    "&2生命容器&r是模组最重要的部件, &2生命容器&r装入&a护符&r, 提高生命上限.",
    "",
    "每个&2生命容器&r增加一颗心, 最多叠加&b10&r个."
  ],
  "quest.37F99696A47264FD.quest_desc": [
    "本章介绍多种制作, 强化和附魔装备的方法, 为你的冒险做好准备!"
  ],
  "quest.17CD2138836B714A.title": "&6寻宝",
  "quest.03DB41A64E74FF33.title": "&b枪械改装件",
  "task.2E0873C81D7EC881.title": "任意枪械改装件",
  "quest.7E685EAD7FB60B45.quest_desc": [
    "&a回收台&r将词缀物品拆为对应品质材料:",
    "",
    "&#7E7E7E普通--神秘废金属",
    "&#55FF55罕见--陈旧布匹",
    "&#5454FC稀有--发光水晶碎片",
    "&#B900B9史诗--玄奥沙",
    "&#EA6F14神话--神铸珍珠",
    "&#FBD174崇高--奥利哈刚遗物",
    "",
    "&a回收台&r可从顶部或侧面输入, 底部取出, 实现自动化, 别弄丢物品!"
  ],
  "quest.3208AF90091D1B6B.quest_desc": [
    "&a简易重铸台&r为物品重新生成全新词缀.",
    "",
    "重铸不限于已带&b词缀&r的物品, 任意有效物品均可, 次数不限.",
    "",
    "&a简易重铸台&r最高重铸为&9稀有&r品质, 更高品质需要升级台子.",
    "{@pagebreak}",
    "重铸台有三个输入槽:",
    "",
    "中央放要重铸的物品, 左上放目标品质对应材料, 右下放作为重铸燃料的&a新生符石&r.",
    "",
    "每种品质有基础经验, 符石和材料消耗, 另外两种选项可将消耗翻倍或三倍."
  ],
  "quest.78BCE2A8F87EB08B.quest_desc": [
    "&z活力之剑&r类似&b心之项链&r, 拥有独立的&2生命容器&r槽位.",
    "",
    "每个&2生命容器&r为剑增加&e1&r点伤害."
  ],
  "quest.1A7186E64604523F.quest_desc": [
    "&eIron的武备与巧械&r提供黑火药枪械, 从粗糙的&a燧发枪&r到&6发条步枪&r, 都可用改装件改变射击方式.",
    "",
    "一切从&a黑火药&r开始, 木炭和红石每次合成两个; 还有加入多余&a火药&r的另一配方.",
    "",
    "&7&o枪需要弹药和手动装填, 带去战斗前先设置装填按键.&r"
  ],
  "quest.3EFAC6FC58219F86.quest_desc": [
    "&a建筑棒&r一次点击就能从物品栏取料, 铺一整行或一整面方块.",
    "",
    "等级包括&a超黏&r, &2铜&r, 铁, 钻石和下界合金, 作用范围逐级提高.",
    "",
    "&a模板&r改变建筑棒功能: &2破坏&r移除而非放置, 替换更换方块, 天使在空中建造, 不毁和电池维持运转."
  ],
  "quest.226E5BD0BEB1BA75.title": "&a杂项书架",
  "quest.44C341DE3BCD64CC.title": "&d亚历山大图书馆",
  "quest.172FD7459907AADE.quest_desc": [
    "返还远程技能树已花费的技能点."
  ],
  "quest.03DB41A64E74FF33.quest_desc": [
    "每把枪都有&b改装槽&r, 放入合成的改装件改变行为.手持枪械, 按&b打开枪械改装&r快捷键进入界面.",
    "",
    "功能涵盖枪械大部分特性: &a散弹&r增加每次子弹数量, &2钢芯&r和铅芯增伤, 燃烧尖端点火, 冰冻弹衣产生破片, 电压核心连锁闪电, 寻踪火药追踪, 反重力火药减小弹道下坠.",
    "",
    "&c工匠灾厄村民&r携带随机组合, 掉落&a黑火药&r和&2绿宝石&r.它们属于灾厄村民, 会出现在袭击和巡逻队中.",
    "",
    "&7&o占用槽位前先读提示, 有些改装会牺牲一项属性换取效果.&r"
  ],
  "task.247B79A552BA6CCE.title": "为冒险整装待发!",
  "quest.52FD0AD73FBCBE3D.title": "&a帽子",
  "quest.24730AF0C707CF79.title": "&d飞马",
  "quest.398AF8F202DDD6AB.title": "&e锤子合集",
  "quest.38E0212362E87E99.quest_desc": [
    "&c突变末影人&r濒死释放末影残片, 爆炸前右击认领, 再在8格内丢一颗末影之眼, 得到&d末影之手&r.",
    "",
    "最多传送256格, 耐久240,每份残片修复60."
  ],
  "quest.398AF8F202DDD6AB.quest_desc": [
    "&e锤子合集&r每次挖掘3×3区域, 大型锤子更广, 最高毁灭锤5×5×5.",
    "",
    "锤子耐久为0时停止工作, 而非损坏, 因此耗尽前修理.每份修复材料恢复三分之一耐久, 下界合金则全部恢复."
  ],
  "quest.2F50137C675E49F9.quest_desc": [
    "&a扫描器&r探测周围世界, 透过岩石显示发现的目标.",
    "",
    "单独没有功能, 需要&a模块&r告诉它寻找什么: &2常见矿石&r, 罕见矿石, 流体, 箱子, Lootr容器, 刷怪笼, 怪物, 动物, 或你指定的方块.",
    "",
    "&a范围模块&r扩大扫描."
  ],
  "quest.26118B733B805236.quest_desc": [
    "每个世界最初都处于&7居所&r, 拿到第一件&a词缀物品&r即解锁.",
    "",
    "[\"\",\"第一次按\",{\"keybind\":\"key.apotheosis.open_world_tier_select\",\"color\":\"yellow\",\"hover_event\":{\"action\":\"show_text\",\"value\":\"默认: CTRL + T\"}},\"打开层级界面再关闭, 就会自动启用居所.\"]",
    "",
    "更高各层级各有自己的解锁要求."
  ],
  "quest.3AA445DE64D8E77D.quest_desc": [
    "返还体能技能树已花费的技能点."
  ],
  "task.574369B60421C9FF.title": "&a环带材料",
  "quest.722901B4259D8AEC.title": "升级书架",
  "quest.4DE483256F9E1D4F.title": "&a摘除符石",
  "task.2A88734461D7A62C.title": "重置体能技能",
  "task.503BA084BF6FDC24.title": "任意#constructionstick:construction_sticks",
  "quest.31AF46B183F805E3.title": "&6发条步枪",
  "quest.266D0151DF0A7BA5.title": "&z多彩靶心",
  "quest.52FD0AD73FBCBE3D.quest_desc": [
    "有些生物生成时戴帽子, 击杀后会永久加入收藏, 可在帽子菜单佩戴.",
    "",
    "本包菜单键默认未绑定, 请在控制设置的Hats下设置."
  ],
  "quest.3A7774F5F0FD174E.quest_desc": [
    "下一阶段, 先达到&2边境&b世界层级&r, 再用升级书架将&a位阶&r提高到&a45&r.",
    "",
    "&c下界书架&r较容易制作, 主要提高&c量子化&r.",
    "",
    "&b海洋书架&r需要先钓些鱼, 主要提高&d阿卡那&r."
  ],
  "quest.3B4B61D505899B51.title": "&d传送石碑",
  "quest.4498E3F4B2DC24FC.title": "&a宝石",
  "quest.7552BF792403EF44.title": "&6精湛视界下界书架",
  "quest.750007D8FAA2EA03.title": "&6羁绊与星级",
  "quest.5A6151C5CBCBAAF4.quest_desc": [
    "&d心之项链&r容纳全部&2生命容器&r.",
    "",
    "把容器装进项链, 再装备到&e饰品槽&r.",
    "",
    "鼠标悬停时按Shift,可查看内部容器总量.",
    "",
    "基础项链最多提供&b40&r颗额外的心."
  ],
  "task.6B866D3A40E6B79C.title": "重置体能技能",
  "quest.183211CBBF56C4E1.quest_desc": [
    "&d化合物X&r将普通苦力怕, 末影人, 骷髅, 雪傀儡或僵尸变成突变体, 方便主动刷掉落, 而不必等生成.",
    "",
    "先喂发酵蛛眼, 猪也可以."
  ],
  "quest.5A6151C5CBCBAAF4.title": "心之项链",
  "task.74E6C34609E1C526.title": "回收材料",
  "quest.79A0CEB28D8EC670.quest_desc": [
    "&6毁灭核心&r是终点, 对应锤子一次清空5×5×5立方体, 每挥125块."
  ],
  "quest.192EB03700278BE2.title": "华丽苹果",
  "quest.011DBD2652E49B97.title": "&f神化世界层级",
  "task.1DDB96A415840B51.title": "遗物",
  "task.2C718A1A0353A93C.title": "升级海洋书架",
  "quest.00249E1AFEF0051A.quest_desc": [
    "&b心跳腰带&r是饰品, 装备提高移速, 跨步能力和跳跃高度.",
    "",
    "升级数值见下一页.",
    "{@pagebreak}",
    "&c红心心跳腰带&r: 跳高1.5格, 小幅加速.",
    "",
    "&6黄心心跳腰带&r: 跳高2格, 中等加速.",
    "",
    "&9蓝心心跳腰带&r: 跳高2.5格, 较快加速.",
    "",
    "&a绿心心跳腰带&r: 跳高3格, 大幅加速."
  ],
  "quest.1709DBEFF27D834B.title": "&d高峰",
  "task.1C0FFC5D4A1D00C7.title": "提取宝典",
  "quest.496903AB7E8A0A92.quest_desc": [
    "&eIron's Gems \\&\\ Jewelry&r专注将材料与&b珠宝&r组合, 为玩家提供特殊效果和属性.",
    "",
    "先制作&a珠宝饰品工作台&r, 制作基础&b珠宝&r, 更高级蓝图则需向&z商店&r购买.",
    "",
    "[\"完整兼容物品列表请查看\",{\"text\":\"珠宝GuideMe指南\",\"color\":\"aqua\",\"click_event\":{\"action\":\"custom\",\"id\":\"ftbquests:docs\",\"payload\":{\"location\":\"guideme,irons_jewelry:guide,irons_jewelry:index.md\"}},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开Iron's Jewelry GuideMe\"},\"underlined\":true},\".\"]"
  ],
  "quest.4BDD9230BBA6C0A0.quest_desc": [
    "&a微型心&r是&e心之容器&r的关键材料.",
    "",
    "- &c微型红心&r: 神化生物掉落.",
    "- &6微型黄心&r: 首领掉落.",
    "- &2微型绿心&r: 末影龙掉落.",
    "- &b微型蓝心&r: 合成制作.",
    "",
    "心也可食用, 按等级恢复生命.",
    "",
    "- &c红色&r: 每次10颗心.",
    "- &6黄色&r: 每次20颗心.",
    "- &a绿色&r: 每次30颗心.",
    "- &b蓝色&r: 每次40颗心."
  ],
  "quest.3B4B61D505899B51.quest_desc": [
    "&d传送石碑&r让你不必反复走相同的路.",
    "",
    "放置并命名&a传送石碑&r, 可从其他石碑传送回来.&2共享石碑&r连接所有同色共享石碑, 不论由谁放置.&a传送石台&r则只能向外传送, 不会成为目的地.",
    "{@pagebreak}",
    "远端没有石碑时, 可用卷轴.&a传送卷轴&r一次性使用, &2绑定卷轴&r记住一个目的地, &a返回卷轴&r送你到最近的已激活石碑.",
    "",
    "&a传送石&r可重复使用, 每次除经验外, 还消耗10,000耐久中的80点, 约可传送125次.",
    "",
    "&7&o村庄找到的石碑免费同调, 自己制作前先找找.&r"
  ],
  "quest.2E7EBD2A61897192.title": "&f随时更换附魔",
  "quest.6EE1C1B7FFB86C6C.title": "&a镶孔符石",
  "task.13E1E8B471826659.title": "符文",
  "quest.4A0A19E73680034F.title": "扩展书架附魔范围",
  "task.429479E851C28AC2.title": "任意#justhammers:hammer",
  "quest.469DBE287993C779.title": "&a燧发枪",
  "quest.2F2DC018DD6A2A23.title": "&a宝石",
  "task.6B8F6B75C6182427.title": "升级深暗书架",
  "quest.469DBE287993C779.quest_desc": [
    "&a燧发枪&r是第一把可制作的枪, 也是唯一不需要加工部件的, 只用铁, 原木, 黑火药和打火石.",
    "",
    "悬停枪械查看伤害, 装填时间, 弹药容量和改装槽.多发枪还显示射速, 这类单发枪则显示子弹速度."
  ],
  "quest.00A7C1FE54F86429.title": "&6附魔的秘密",
  "quest.4BCA8A5C3F80D375.title": "&a除名符石",
  "quest.4A0A19E73680034F.quest_desc": [
    "&e&lBEER&r&f(扩展书架附魔范围)让你修改附魔台搜索书架的范围:",
    "",
    "通常附魔台只检查周围5×5×3区域, 使用&e&lBEER&r后, 你可以:",
    "",
    "• 扩大X和Z宽度, 即水平范围",
    "• 增加Y高度, 即垂直范围",
    "• 用特殊物品调整这些尺寸",
    "• 创建超越原版限制的附魔设施",
    "",
    "",
    "{@pagebreak}",
    "&l&a如何使用&e&lBEER&r",
    "",
    "修改附魔台范围的方法:",
    "1. 主手持修饰物品",
    "2. 可选: 副手持特定物品, 以缩小范围",
    "3. 潜行(Shift)右击附魔台"
  ],
  "quest.7E685EAD7FB60B45.title": "&f认识&a回收台",
  "task.4B67D8495CB6403D.title": "&a宝石",
  "quest.37F99696A47264FD.title": "&f为冒险整装待发!",
  "quest.464AED8311A32476.quest_desc": [
    "深入&e神化&r前, 先了解什么是&b词缀&r!",
    "",
    "&b词缀&r是所有&e神化&r装备的核心.每个&b词缀&r类似附魔, 为附着的物品提供加成.",
    "{@pagebreak}",
    "探索世界可找到&b词缀&r物品, 效果随品质变化.地下洞穴或夜间随机出现的&e神化&r首领更常掉落.",
    "",
    "&b词缀&r分几种, 分别影响属性, 效果, 耐久及&b宝石镶孔&r, 后者在&b宝石&r部分介绍."
  ],
  "quest.2E7EBD2A61897192.quest_desc": [
    "随机附魔装备太多?使用&d拆解宝典&r, 拆毁物品并提取部分附魔.",
    "",
    "&d提取宝典&r也移除全部附魔, 但保留物品, 让你随时移除, 更换任意数量附魔.",
    "",
    "为特定工具寻找特定附魔时, 可制作只支持某类附魔的&d宝典&r."
  ],
  "quest.60FDF616DEDE5E73.quest_desc": [
    "&e神化&r将探索与战斗改造成更接近角色扮演游戏的体验.",
    "",
    "世界中的物品和生物可能带有特殊&b词缀&r, 变得更强, 有时获得特殊能力, 让玩法更加丰富!",
    "",
    "迷茫时可查&a暗影编年史&r, 即模组指南."
  ],
  "quest.3208AF90091D1B6B.title": "&a简易重铸台",
  "quest.044A192E503B766B.quest_desc": [
    "&a生命治疗创可贴&r像绷带, 按等级恢复生命, 有冷却, 依赖它救命时要小心.",
    "",
    "每级提高基础治疗量.",
    "",
    "&c红色&r: 每次1颗心.",
    "",
    "&6黄色&r: 每次3颗心.",
    "",
    "&9蓝色&r: 每次6颗心.",
    "",
    "&a绿色&r: 每次10颗心."
  ],
  "quest.268CC540E5B605A9.quest_desc": [
    "最终书架等级, 需要先灌注&d龙息&r.",
    "",
    "要求80&a位阶&r, 15至30&c量子化&r, 以及至少60&d阿卡那&r.",
    "",
    "&d阿卡那&r不足时, 可用蜡烛提供少量加成."
  ],
  "quest.6EE1C1B7FFB86C6C.quest_desc": [
    "&a镶孔符石&r增加&b词缀&r物品的&b宝石镶孔&r数量."
  ],
  "quest.5382CB05500E49DE.title": "&z渡鸦附魔台",
  "quest.30689B890F5E7A03.title": "&3深入探索",
  "quest.1709DBEFF27D834B.quest_desc": [
    "装备全套&9稀有&r或更高品质词缀装备, 击败&5凋灵&r.",
    "",
    "需先解锁&b攀升&r.",
    "",
    "若生物强过装备, 可在同一界面退回任意已解锁层级."
  ],
  "quest.75BC832C835585E2.quest_desc": [
    "更好的枪需要更好的内部部件, 共三级, 逐级合成.",
    "",
    "- &a简易机械组件&r: 制作大口径短铳和滑膛枪.",
    "- &2机械组件&r: 制作六发左轮和黑火药左轮.",
    "- &a发条组件&r: 制作火绳枪和发条步枪.",
    "",
    "每级消耗前一级, 因此升级前多备几套简易组件."
  ],
  "quest.6CB85481E967E81A.quest_desc": [
    "建筑棒负责成排铺设, &eBuilding Gadgets&r则负责形状和整座建筑.",
    "",
    "- &a建筑工具&r: 按可配置图案放置.",
    "- &a替换工具&r: 原地将方块换成其他方块.",
    "- &a破坏工具&r: 一次清空一片空间.",
    "- &a复制粘贴&r与&2剪切粘贴&r工具: 记录建筑, 在其他地点重建.",
    "",
    "&a模板管理器&r将记录保存为&2模板&r和红图, 一次设计正确, 任何地方都可复建."
  ],
  "quest.65DAC5AA05C91055.title": "&6巅峰",
  "quest.7E88C7654F281E43.title": "{\"text\":\"强化物品\",\"color\":\"#EA6F14\"}",
  "quest.7313C557C45DCFAD.title": "重置近战技能",
  "quest.718A5799ACCEFFF3.quest_desc": [
    "居所之后每个层级对应一枚符文, 共四种, 让&a神化刷怪笼&r超越基础升级.对刷怪笼使用即可应用.",
    "",
    "前三种依次需要更高一级品质装备的回收材料, 因此与层级同步.&a雷鸣&r符文在击败末影龙后, 于&6FTB制造机&r制作.",
    "",
    "- &a拓荒者&r: 每7.5至30秒生成7只.",
    "- &2旅人&r: 每5至20秒生成10只.",
    "- &a登山者&r: 每2.5至10秒生成13只.",
    "- &2雷鸣&r: 每秒16只.",
    "",
    "符文直接设定这些数值, 而非叠加, 因此对已升级的刷怪笼用较低符文, 反而会降级."
  ],
  "quest.2AFF075509A04B7E.title": "&a边境",
  "quest.3900E67C8B833980.quest_desc": [
    "&a工匠卷轴&r可作为战利品找到, 或从&z商店&r购买.",
    "",
    "手持&a工匠卷轴&r右击, 学习&b珠宝&r蓝图.",
    "",
    "有两种特殊&a工匠卷轴&r, 教你制作&6二元&r珠宝.",
    "",
    "它们同时获取&b金属&r和&d宝石&r属性, 总体品质也更高."
  ],
  "quest.18198810B4198724.quest_desc": [
    "每位伙伴一个装备槽, 每个种族有自己的装备.对已驯服伙伴使用物品即可装备, 并返还原装备, 羁绊界面有卸下按钮.",
    "",
    "休息和复活后装备保留, 解除羁绊时掉在伙伴脚边.",
    "{@pagebreak}",
    "- &a拳击手套&r: 霸王龙, 触及距离增加三格, 伤害增加两点.",
    "- &2龙之石板&r: 幼龙, 吐息变为陨石.",
    "- &a跑鞋&r: 夜狐, 快60%,迅捷步伐提供速度II.",
    "- &2电池&r: 小魔怪, 加速附近机器, 并电击旁边敌人.",
    "- &a短尾矮袋鼠零食&r: 短尾矮袋鼠, 有概率魅惑附近怪物, 使其互相战斗.",
    "- &2胸甲&r与&a狼铠&r: 迷你玩家和恐狼, 任意胸甲或狼铠均可, 永不磨损."
  ],
  "quest.2F2DC018DD6A2A23.quest_desc": [
    "&a宝石&r是大多数&b珠宝&r提供效果或属性的部分.",
    "",
    "不同&b珠宝&r受&a宝石&r影响不同, 制作前逐件仔细检查.",
    "",
    "大多数原版宝石可用, 也可在JEI搜索&a#jewelry_gem&r查看列表."
  ],
  "quest.29513BD00064E27D.quest_desc": [
    "返还采矿技能树已花费的技能点."
  ],
  "quest.0EE35D6E57FAD973.quest_desc": [
    "&6魔咒图书馆&r存储附魔, 积累足够低级附魔后, 还可创建更高级附魔书."
  ],
  "quest.23D4C14AE83B5C7A.title": "&6宝箱怪"
}
