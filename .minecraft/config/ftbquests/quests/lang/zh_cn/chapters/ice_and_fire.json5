{
  "quest.3C2D0FF5070F4CA0.quest_desc": [
    "九头蛇毒牙可以制作箭矢, 命中时使目标中毒, 并治疗你.",
    "",
    "九头蛇还有一种稀有掉落物--&a九头蛇心脏&r.放在快捷栏中会提供生命恢复, 伤势越重, 效果越强."
  ],
  "quest.59D1CB72B49F8A64.quest_desc": [
    "龙达到3阶后, 就能用刷子刷取龙鳞, 每次掉落一至两片.",
    "",
    "可刷次数等于龙的阶数, 因此3阶龙能刷三次.每喂一份龙食, 就会恢复一次刷取次数."
  ],
  "quest.5CB0CACC6679613C.title": "&6龙钢武器",
  "quest.21419B5F4A9B8F52.title": "&b海潮三叉戟",
  "task.5A07CBC8CAADEAD4.title": "任意龙钢龙铠",
  "quest.1E7EAA3C72E9575D.title": "&b龙歌长笛",
  "quest.3145BAAC2B937721.quest_desc": [
    "死亡蠕虫有小概率掉落虫卵, 投出后会孵化一只友方小蠕虫.",
    "",
    "驯服的蠕虫不会听从指令, 而是留在孵化地点附近, 攻击敌对生物, 不会伤害你和你的动物.&c巨型死亡蠕虫卵&r会孵化出体型四倍大的蠕虫."
  ],
  "quest.59D1CB72B49F8A64.title": "&a不战而获龙鳞",
  "quest.7298DEADC14C0ECB.quest_desc": [
    "龙骨箭的基础伤害为10,是普通箭的五倍, 值得为它消耗凋灵骨碎片.",
    "",
    "在龙靠近并向你喷吐前, 它是安全削弱龙的最佳手段."
  ],
  "quest.28BA1DC94EFADB96.quest_desc": [
    "手持驯龙杖右击龙, 可在游荡, 停留和护卫你之间切换.",
    "",
    "潜行右击可将龙当前站立位置设为家, 它会留在该点40格范围内.再次操作可清除家的位置.",
    "",
    "驯龙杖需要龙头骨, 在收获龙尸体的最后一步获得."
  ],
  "quest.2D6E3B320DCEA94C.title": "&6龙钢龙铠",
  "task.4291599847A334E8.title": "任意电龙蛋",
  "quest.50FBC8CB0EC453E1.title": "&d繁殖龙",
  "quest.23AF36E017614FD2.title": "&a养育龙",
  "quest.6DF54549C3A1524E.title": "&d电龙蛋",
  "task.1FF7100948FDC0BA.title": "任意精灵瓶",
  "quest.3C7FAE85D409147E.quest_desc": [
    "鸡蛇在热带草原守护鸡群, 与它对视的目标会受到凋零效果.",
    "",
    "盯回去就能驯服它.每次只短暂对视, 避免被凋零杀死, 持续尝试直到它屈服.驯服的鸡蛇会为你战斗, 喂种子可治疗, 右击可切换坐下, 跟随和巡逻."
  ],
  "quest.2D6E3B320DCEA94C.quest_desc": [
    "这是龙铠的最高等级.所有龙铠都用材料块而非锭制作, 因此一整套龙钢龙铠需要大量锻造."
  ],
  "quest.3C7FAE85D409147E.title": "&a鸡蛇",
  "task.67C29D0F495C864B.title": "任意龙骨工具",
  "quest.581254729749E4EF.title": "&d幻灵剑",
  "task.1818416AF26AB403.title": "任意龙钢胸甲",
  "quest.68F97A93A23A89C3.title": "&6龙鳞盔甲",
  "quest.74BC8197519FD53C.quest_desc": [
    "整套龙钢盔甲提供34点护甲值, 每件6点韧性, 并具有与龙鳞盔甲相同的额外龙息防护.",
    "",
    "仅胸甲就有2,560点耐久."
  ],
  "quest.1E9094CDA403E860.title": "&d精灵",
  "quest.606BCC9928F72DB4.quest_desc": [
    "将龙蛋放在下界岩上, 再点燃下界岩, 让龙蛋处于火焰中.火焰不会伤害火龙蛋.",
    "",
    "累计燃烧7,200刻(六分钟)后孵化.火熄灭时计时暂停, 重新点燃后继续."
  ],
  "quest.416EBE0C6067825E.quest_desc": [
    "食人妖很少见, 会在森林, 丘陵, 山地和积雪生物群系的地下生成.箭无法伤害它们, 因此必须近战.阳光会把食人妖变成石像, 但石像不会掉落任何东西.",
    "",
    "本包中食人妖不会掉落武器, 只掉落毛皮和獠牙.整套食人妖皮甲可减少70%的弹射物伤害."
  ],
  "quest.2A8D69C741D33C49.quest_desc": [
    "&a核心&r是锻炉的中央方块, 需要同元素的&3龙心&r制作.每具龙尸体只会提供一颗心脏.",
    "",
    "&a焰孔&r是龙喷吐的入口.锻炉的三种部件必须属于同一种元素."
  ],
  "task.6CF0F483D75B678A.title": "任意龙铠",
  "quest.416EBE0C6067825E.title": "&7食人妖皮甲",
  "task.2168DB0283CCD4AF.title": "任意龙血强化剑",
  "quest.78871F87322B3441.quest_desc": [
    "这是第一级龙类装备, 其中龙骨剑最重要, 因为龙血强化剑和幻灵剑都以它为基础."
  ],
  "quest.16D85C047B6EC329.title": "&c龙锻炉砖块",
  "quest.421C1C23DAD7CFBF.title": "&c驱动锻炉",
  "quest.43FF2B6CBA021F30.title": "&6龙钢",
  "task.160B4DB3DD6D2545.title": "任意死亡蠕虫甲壳胸甲",
  "quest.199022E0BC1A489E.quest_desc": [
    "&e冰火传说&r让世界充满龙与神话生物.探索章节介绍了如何寻找和战斗, 本章则接着介绍养育自己的龙, 锻造龙钢, 以及其他生物掉落物制成的装备.",
    "",
    "&a异兽手记&r是模组自带指南, 加入&2手稿&r可扩充内容.手稿可在龙的宝藏, 怪物巢穴和墓地箱子中找到.",
    "",
    "&7&o除非队伍在领地设置中允许生物破坏, 否则野生龙无法破坏已认领区块内的方块.驯服的龙永远不会破坏方块."
  ],
  "quest.1EF208E4A6356FB2.quest_desc": [
    "[\"潮卫盔甲需要海蟒鳞片, 以及击杀海马获得的\",{\"text\":\"闪亮的鳞片\",\"color\":\"green\"},\".探索章节的\",{\"text\":\"海蟒任务\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"action\":\"custom\",\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"269CA7E3614C0826\",\"page\":1}},\"hover_event\":{\"action\":\"show_text\",\"value\":{\"text\":\"前往任务\"}}},\"介绍了狩猎方法.\"]",
    "",
    "穿齐整套会获得水下呼吸, 而在水中或雨中时, 每件还会进一步提高力量效果."
  ],
  "task.22A76FF0060CCC9A.title": "任意冰龙蛋",
  "quest.2904099C745CCF6F.quest_desc": [
    "死亡蠕虫在沙漠沙地下穿行, 用舌头攻击.它们有沙褐, 苍白和血红三色, 甲壳可以制作带额外韧性的盔甲.",
    "",
    "舌头可制作&a死亡蠕虫手甲&r, 抽击目标造成3点伤害, 并将其拉向你."
  ],
  "quest.1E7EAA3C72E9575D.quest_desc": [
    "吹响长笛, 可以让128格内所有驯服的龙, 骏鹰和翼蚺降落到地面.",
    "",
    "飞行时记得随身带一支.没有长笛, 飞到高空游荡的龙很难叫回来."
  ],
  "quest.7B8CB30F669E60EC.title": "&c搭建锻炉",
  "quest.23AF36E017614FD2.quest_desc": [
    "龙每在已加载区块中度过完整一个游戏日, 就长大一天, 每份&a龙食&r再额外增加一天.龙食还会恢复20点饥饿值并治疗.",
    "",
    "两次喂龙食之间, 任意肉类都能填饱肚子, 冰龙也吃鱼.&a萎靡龙食&r会暂停龙的成长, 直到再次喂普通龙食.",
    "",
    "各阶段详情见下一页→",
    "{@pagebreak}",
    "- &a1阶, 第0天&r: 只能撕咬.空手右击可让它趴在你身上, 最多同时带三只.",
    "- &22阶, 第25天&r: 较弱的吐息.",
    "- &a3阶, 第50天&r: 足够大, 可以骑乘, 并获得冲锋攻击.",
    "- &24阶, 第75天&r: 成年, 可以繁殖.",
    "- &a5阶, 第100天&r: 体型最大, 也最稀有.驯服的龙到第128天停止生长."
  ],
  "quest.61BBA4CF0F6E67CA.title": "&7银制武器",
  "quest.46068E2E32224447.title": "&d精灵法杖",
  "task.294D4AB9D12DED49.title": "任意龙钢锭",
  "quest.2904099C745CCF6F.title": "&6死亡蠕虫甲壳",
  "task.6CFEF7AF3748B929.title": "任意潮卫胸甲",
  "quest.1EF208E4A6356FB2.title": "&b潮卫盔甲",
  "task.25B0EFE0B3192DFC.title": "任意龙锻炉核心",
  "quest.607D6416DFF2633D.quest_desc": [
    "龙血赋予龙骨剑对应的元素, 每种元素都能对其他类型的龙造成额外伤害.",
    "",
    "- &c炎&r: 点燃并击退目标, 对冰龙额外造成8点伤害.",
    "- &b霜&r: 冻结目标, 对火龙额外造成8点伤害.",
    "- &d霆&r: 用闪电攻击目标, 对火龙和冰龙额外造成4点伤害."
  ],
  "quest.4166A19810245A35.quest_desc": [
    "3阶龙足够大, 可以载人.空手右击即可骑上去.",
    "",
    "- &b跳跃&r: 起飞.",
    "- &bX&r: 下降.",
    "- &bR&r: 吐息.",
    "- &bG&r: 攻击.",
    "- &bF7&r: 切换镜头.",
    "",
    "以上是默认按键, 可在控制设置中更改.空手潜行右击打开龙的物品栏, 可在其中装备龙铠."
  ],
  "quest.74E84C98BFE95FDC.quest_desc": [
    "冰龙蛋必须放在水中.放进水方块后, 很快会冻结成&b冰封龙蛋&r.",
    "",
    "冻结后7,200刻(六分钟)孵化, 在此之前不要破坏方块."
  ],
  "task.24661216C039A688.title": "任意龙鳞胸甲",
  "quest.78871F87322B3441.title": "&6龙骨工具",
  "quest.74BC8197519FD53C.title": "&6龙钢盔甲",
  "quest.28BA1DC94EFADB96.title": "&6驯龙杖",
  "quest.7B1C963DF16730CC.quest_desc": [
    "翼蚺在丛林上空飞行.用弓将它射落, 在它再次起飞前骑上去, 并在它不断撕咬时坚持20秒.好盔甲会很有帮助.",
    "",
    "驯服的翼蚺是模组中最快的坐骑之一, 抬头爬升, 低头俯冲, 用曲奇繁殖.它们的羽毛可制作&a翼蚺羽箭&r, 以一阵强风击退生物."
  ],
  "quest.607D6416DFF2633D.title": "&c龙血强化剑",
  "task.7FB13EF06038583C.title": "任意龙锻炉焰孔",
  "quest.20ED696F76AE2271.title": "&d唤龙晶石",
  "quest.40E7F09D3A6B013E.quest_desc": [
    "手稿誊写桌可以为异兽手记增加页面.书放左侧, 手稿放底部, 每份手稿解锁一页.",
    "",
    "这些页面介绍本章各生物的栖息地, 掉落物, 以及可驯服生物的驯服方法."
  ],
  "task.4245160F4EED1CDD.title": "任意火龙蛋",
  "quest.3A7D120D05FE0839.quest_desc": [
    "海马是生活在海洋中的稀有无害生物.给它喂海带, 每份有三分之一概率驯服.",
    "",
    "驯服的海马可装备鞍, 马铠和箱子, 游泳远比行走快.用海晶砂繁殖."
  ],
  "quest.193816470731136F.title": "&6龙鳞与龙骨",
  "quest.3BC9C46AD0D3E05E.quest_desc": [
    "睡在龙穴中的4阶, 5阶成年雌龙, 收获心脏时必定同时提供一颗龙蛋.较年轻雌龙只有小概率掉蛋.",
    "",
    "龙蛋颜色决定其元素:",
    "- &c火&r: 红色, 绿色, 古铜色和灰色.",
    "- &b冰&r: 蓝色, 白色, 宝蓝色和银色.",
    "- &d电&r: 电蓝色, 紫晶色, 铜色和黑色.",
    "",
    "请亲自放置龙蛋, 孵出的龙会绑定到放置它的玩家."
  ],
  "task.5AA1487454ADA13C.title": "驯服一只海马",
  "task.2742F4B89D60D68E.title": "龙锻炉砖块",
  "task.34EAE68FB9C3D3FB.title": "任意龙蛋",
  "quest.46068E2E32224447.quest_desc": [
    "法杖消耗精灵尘作为弹药, 发射造成5点伤害并使目标浮空的能量弹.",
    "",
    "所需的&a精灵之翼&r是精灵的稀有掉落物."
  ],
  "quest.199022E0BC1A489E.title": "&6冰火传说",
  "quest.542B48C91528377D.title": "&6龙吟号角",
  "quest.219138696B238587.quest_desc": [
    "骏鹰在丘陵和山地游荡, 会攻击所有比它小的目标, 包括你.不断往它附近丢兔子脚, 直到它趴下, 就驯服成功了.",
    "",
    "潜行右击可以安装鞍, 箱子或&a骏鹰铠&r.用木棍切换坐下和游荡, 用兔肉煲繁殖."
  ],
  "task.2CD04B5475FDB41C.title": "驯服一条翼蚺",
  "quest.1E9094CDA403E860.quest_desc": [
    "精灵村庄位于森林和丛林.本包中的精灵不会偷你的东西.",
    "",
    "手持空&a广口瓶&r右击精灵可以捕获.瓶中精灵每个游戏日产出一个&d精灵尘&r, 留在瓶中直到你空手右击取出.",
    "",
    "在野生精灵附近丢蛋糕, 则可以与其交好.友好的精灵会跟随你, 并根据自身颜色提供效果."
  ],
  "quest.581254729749E4EF.quest_desc": [
    "幽灵在夜间出没于墓地, 箭和火焰会直接穿过它们.记得带银剑.",
    "",
    "它们有时会掉落&a灵锭&r, 是幻灵剑的关键材料.幻灵剑会发射能够穿透方块的旋转幽灵剑."
  ],
  "quest.7298DEADC14C0ECB.title": "&6龙骨长弓",
  "quest.6DF54549C3A1524E.quest_desc": [
    "电龙蛋需要露天和降雨.将蛋放在上方没有遮挡的户外, 等待天气转变.",
    "",
    "只有雨落在蛋上时才计时, 累计需要7,200刻(六分钟).沙漠, 热带草原和恶地从不下雨, 因此要先将龙蛋带离这些地方."
  ],
  "quest.5CB0CACC6679613C.quest_desc": [
    "龙钢武器保留锻造时的元素.",
    "",
    "- &c火&r: 点燃目标15秒, 并将其击退.",
    "- &b冰&r: 将目标冻结在冰块中.",
    "- &d电&r: 从目标向最多10只视野内的附近生物跳跃, 每次跳跃伤害减半."
  ],
  "quest.50FBC8CB0EC453E1.quest_desc": [
    "同元素的一公一母两条龙, 达到4阶或以上后即可繁殖.分别喂食对应的&a百合混合物(花火汤, 花霜酱或花电浆)&r, 雌龙就会产下一颗蛋.",
    "",
    "烈焰百合, 寒冰百合和闪电百合, 生长在各自对应龙巢所在的生物群系."
  ],
  "quest.68F97A93A23A89C3.quest_desc": [
    "龙鳞盔甲的颜色由所用龙鳞决定, 每件都提供额外的龙息防护.",
    "",
    "进入龙穴前先穿一整套.洞穴中的龙更老, 也比地表巢穴的龙强得多."
  ],
  "task.41694B451EB8EF5D.title": "驯服一只骏鹰",
  "quest.20ED696F76AE2271.quest_desc": [
    "用同元素的晶石右击自己的龙即可绑定, 在该维度任意位置使用已绑定晶石, 都能将龙传送到身边.",
    "",
    "即使龙所在区块已卸载, 也能找到它.将已绑定晶石单独合成, 可清除绑定."
  ],
  "quest.219138696B238587.title": "&a骏鹰",
  "quest.43FF2B6CBA021F30.quest_desc": [
    "运行中的锻炉会将铁和对应龙血锻造成&6龙钢&r.无法处理的物品会烧成灰烬或冻成霜凌, 因此投入前先查JEI.",
    "",
    "缺龙血?锻炉也能用同元素的龙鳞为玻璃瓶装入对应龙血."
  ],
  "quest.606BCC9928F72DB4.title": "&c火龙蛋",
  "quest.3145BAAC2B937721.title": "&6死亡蠕虫卵",
  "quest.61BBA4CF0F6E67CA.quest_desc": [
    "银制工具和武器对亡灵额外造成2点伤害.本包将所有模组的银视为同一种金属, 因此任意银锭都能用."
  ],
  "quest.2F9ED8F13B212606.title": "&7凋灵之骨",
  "quest.4166A19810245A35.title": "&a起飞",
  "quest.5F04C8F8D8DC7A89.title": "&a拟羊伪装",
  "quest.2A8D69C741D33C49.title": "&c核心与焰孔",
  "task.492DCC85FC641D92.title": "任意龙钢剑或斧",
  "quest.40E7F09D3A6B013E.title": "&a手稿誊写桌",
  "quest.3BACBE2AA1E0DB47.title": "&b龙铠",
  "task.1749F873BB9B1692.title": "任意唤龙晶石",
  "quest.2F9ED8F13B212606.quest_desc": [
    "所有龙骨工具和武器, 都用凋灵之骨代替木棍.",
    "",
    "- &a凋灵骷髅&r: 每只最多掉落一根, 但必须近战击杀.",
    "- &2鸡蛇&r: 每只最多掉落两根, 生成于热带草原."
  ],
  "quest.16D85C047B6EC329.quest_desc": [
    "&c龙锻炉&r利用活龙的吐息, 制作模组中最强的金属.火, 冰, 电各有对应的锻炉, 由砖块决定你要搭建哪一种.",
    "",
    "每座锻炉需要17个同元素砖块.砖块由龙鳞块制作, 因此一座锻炉需要大量龙鳞."
  ],
  "quest.542B48C91528377D.quest_desc": [
    "对自己的龙使用空号角, 即可将它收进其中, 再对方块使用号角即可放出.",
    "",
    "成年龙很难带着走, 因此这是在基地之间搬运巨龙的方便方法."
  ],
  "quest.193816470731136F.quest_desc": [
    "[\"收获龙的尸体可获得龙鳞和龙骨, 具体操作见\",{\"text\":\"收获巨龙战利品\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"id\":\"ftbquests:link\",\"payload\":{\"quest_id\":\"250945907CE6EA9D\",\"page\":1},\"action\":\"custom\"},\"hover_event\":{\"value\":{\"translate\":\"Go to Quest\"},\"action\":\"show_text\"}},\"任务.\"]",
    "",
    "- &a龙鳞&r: 为你制作盔甲, 以及龙锻炉砖块.",
    "- &2龙骨&r: 制作工具, 武器, 箭矢, 以及控制驯服龙的乐器.",
    "",
    "每颗&3龙心&r和每瓶龙血也都留好, &d龙锻炉&r两者都需要."
  ],
  "task.56CDA4231D09673D.title": "任意龙鳞",
  "task.3EFFA8F128E60783.title": "驯服一只鸡蛇",
  "quest.3BC9C46AD0D3E05E.title": "&6龙蛋",
  "quest.7B1C963DF16730CC.title": "&a翼蚺",
  "task.544B68CBF25BAEC1.title": "任意百合混合物(花火汤, 花霜酱或花电浆)",
  "quest.3BACBE2AA1E0DB47.quest_desc": [
    "龙铠有头, 颈, 身, 尾四个部件, 分别放进龙物品栏中对应的槽位.",
    "",
    "材质包括铁, 铜, 银, 金, 钻石, 下界合金和龙钢.银制龙铠接受任意银块."
  ],
  "quest.3C2D0FF5070F4CA0.title": "&a九头蛇毒箭",
  "quest.5F04C8F8D8DC7A89.quest_desc": [
    "穿全套伪装并潜行, 独眼巨人几乎看不见你.这是安全绕过它, 拿到宝藏的方法."
  ],
  "quest.74E84C98BFE95FDC.title": "&b冰龙蛋",
  "quest.21419B5F4A9B8F52.quest_desc": [
    "海潮三叉戟的伤害远高于原版三叉戟, 一次投掷还能贯穿多个敌人.",
    "",
    "海蟒长牙也能制作&a潮汐之箭&r, 它在水下不会减速, 仍能保持速度."
  ],
  "quest.7B8CB30F669E60EC.quest_desc": [
    "锻炉是一个3×3×3立方体, 逐层搭建.",
    "",
    "- &a底层和顶层&r: 四角放龙骨块, 其他五个位置放砖块.",
    "- &a中层&r: 中央放核心, 其中一侧的中间放焰孔, 其余位置填满砖块.",
    "",
    "焰孔前方要留出空地, 龙必须站在那里."
  ],
  "task.3ACB0049F0E9DBD5.title": "任意食人妖皮袄",
  "quest.421C1C23DAD7CFBF.quest_desc": [
    "只有同元素的龙向焰孔喷吐时, 锻炉才会运行.将驯服的龙留在前方, 或把野生龙拴在那里.",
    "",
    "&a铁链&r能将生物拴在墙方块上, 且无法挣断.不过, 龙会破坏大多数墙, 因此应拴在&a龙骨墙&r上.",
    "",
    "只要锻炉中还有可处理的材料, 龙就会持续喷吐."
  ],
  "quest.3A7D120D05FE0839.title": "&b海马"
}
