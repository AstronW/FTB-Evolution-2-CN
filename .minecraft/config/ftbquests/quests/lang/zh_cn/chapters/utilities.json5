{
  "quest.63911AFF147BA1FD.title": "&eUtilitarian",
  "quest.5FA54ADB7A454E2D.title": "&a猪猪发电",
  "quest.5A811E99C409699F.title": "&3熔炉工厂",
  "task.27AF0228A67846F4.title": "任意电梯",
  "quest.41392AB326D113C1.title": "&e新克隆",
  "quest.766ED9C3C575F83D.title": "&a火力全开",
  "task.3583C42F09BAD32B.title": "便携工作台",
  "quest.4EA93D8996CBCC6F.title": "&a天使方块",
  "quest.5CAF581D02976AD3.quest_desc": [
    "让闪电击中&c刺嗷方块&r, 就会将其变成&c诅咒刺嗷方块&r, 额外生成生物.这两种草方块都无法合成, 只能借助雷暴获得.",
    "",
    "看向一个这样的方块即可完成任务.雷暴期间, 可用带引雷附魔的三叉戟引来闪电."
  ],
  "quest.348DD697A85D7D46.quest_desc": [
    "&a压缩骨粉&r一次施加4份骨粉的效果.对完全成熟的作物使用时, 会替你收获并重新种植.",
    "",
    "&3超级压缩骨粉&r一次施加16份骨粉的效果, 还能让树苗长成大型树木.&2花农的骨粉&r会在草方块上生成最多5朵花, 范围为3格."
  ],
  "quest.78E9F521E6662D31.quest_desc": [
    "&6彩虹熔炉&r产生50,000 FE/t,但前提是每个等级都至少有一台熔炉正在作为发电机运行, 且所有这些熔炉的储能都未满.",
    "",
    "只有设为输出的面才会输出能量, 而且你只能拥有一台彩虹熔炉."
  ],
  "quest.5E261FCD7A5628D4.title": "&a增强组件",
  "quest.77F457502E8EC957.title": "&a电梯",
  "quest.28035DF778F7D517.quest_desc": [
    "无人机的能力取决于建造时使用的方块.",
    "",
    "- &a钻头&r: 放在正面, 无人机会飞到你正在开采的方块处协助挖掘.",
    "- &2发射器&r: 朝向前方, 可以向附近敌人射箭, 且不消耗箭.",
    "- &a仙人掌&r: 放在正面, 可以攻击敌对生物.岩浆块的效果相同.",
    "- &2磁石&r: 收集附近物品并送给你.",
    "- &a信标&r: 放在正面, 可以向敌人发射激光.",
    "- &2照明&r: 使用任意高亮度光源方块, 都会让无人机照亮周围."
  ],
  "quest.5E261FCD7A5628D4.quest_desc": [
    "增强组件会改变熔炉的工作方式.手持组件右键点击熔炉, 即可安装.",
    "",
    "- &a速度&r: 烹炼时间减半, 但燃料消耗加倍.",
    "- &2燃料效率&r: 同样的燃料能处理两倍物品, 但烹炼速度降低25%.",
    "- &a高炉&r: 仅处理高炉配方.",
    "- &2烟熏&r: 仅处理烟熏炉配方."
  ],
  "quest.5CAF581D02976AD3.title": "&c诅咒刺嗷方块",
  "quest.5FA54ADB7A454E2D.quest_desc": [
    "&a跑步机&r能为培育仓供能.它长两格, 像床一样放置.把它放在培育仓旁, 再将动物引到前面的方块上.",
    "",
    "猪产生16 FE/t,狼22,村民25,苦力怕80,末影人160.所有可用动物均可在JEI中查看.",
    "",
    "其他FE能源同样可以.本整合包中, 培育一个壳体需要102,400 FE."
  ],
  "quest.348DD697A85D7D46.title": "&a压缩骨粉",
  "quest.28035DF778F7D517.title": "&a无人机能力",
  "quest.26EADD4D46542B01.title": "&e模块化无人机",
  "quest.4ED6DB305986636C.quest_desc": [
    "完成的壳体会存放在&a壳体存放仓&r中.输入红石信号或FE后, 仓门就会打开.走进去选择壳体, 将意识转移过去.",
    "",
    "旧身体会留在原处, 并保留其携带的一切.每个壳体都有独立的物品栏和经验.",
    "",
    "在壳体中死亡, 会直接转移到另一个已完成的壳体.在原本身体中死亡则按普通死亡处理.存放仓消耗16 FE/t,断电20刻后, 仓内壳体就会死亡."
  ],
  "quest.766ED9C3C575F83D.quest_desc": [
    "&a发电机&r增强组件会将熔炉变成能源设备, 把燃料燃烧产生的热量转化为FE;安装期间, 熔炉无法冶炼.",
    "",
    "本整合包中无法合成它, 需要从&2熔炉袋&r中寻找.&6赌徒&r会在庄园和大理石城堡中以35硬币出售熔炉袋, 每袋包含一件随机熔炉物品.",
    "",
    "发电量取决于等级.&2铁熔炉&r产生40 FE/t,&6下界合金熔炉&r产生1,000 FE/t.同时安装&2高炉&r增强组件后, 可以燃烧宝石和金属锭, 每种提供固定能量; 数值见JEI中的Generator | Blasting分类.",
    "",
    "&e注意&r: 你必须先亲自打开过一个战利品箱, &6赌徒&r才会出售物品."
  ],
  "quest.63911AFF147BA1FD.quest_desc": [
    "&eUtilitarian&r包含许多小改进和实用方块.很多功能无需额外操作, 例如附近有怪物时也能睡觉, 砍树后树叶快速腐烂, 以及不会被踩坏的耕地.",
    "",
    "&a子沙&r是第一个值得制作的物品.种在上面的甘蔗和仙人掌能多长3格, 并获得5次额外生长刻."
  ],
  "quest.76429142123E3A8D.title": "&a愤怒的泥土",
  "quest.54FE9DA77DED738D.title": "&f实用工具",
  "quest.4EA93D8996CBCC6F.quest_desc": [
    "&a天使方块&r可以凭空放置, 无需相邻方块.用它搭建空中桥梁或悬浮平台最方便, 放下后可像普通方块一样向外延伸建造."
  ],
  "quest.26EADD4D46542B01.quest_desc": [
    "&e模块化无人机&r让你用普通方块建造个人无人机.放下&a无人机组装控制器&r, 在旁边用&2组装框架&r搭个平台, 再在上方建造无人机.",
    "",
    "按下控制器中的建造按钮, 整座结构就会缩成一台口袋无人机.装备在无人机槽中, 它就会跟随你, 无需燃料.一台无人机最多可用1,000个方块, 越重飞得越慢.",
    "",
    "&c记住控制器原本位于框架旁的哪个位置.&r以后拆解无人机时, 必须把控制器放回同一位置."
  ],
  "quest.509D7878283EC7AF.title": "&3离子推进器",
  "quest.78E9F521E6662D31.title": "&6彩虹熔炉",
  "quest.66BB02961DF43CB7.quest_desc": [
    "&a流体漏斗&r像普通漏斗一样工作, 但搬运的是流体, 每10刻执行一次.",
    "",
    "它能以很低的成本将机器输出罐中的流体送到下方储罐, 无需铺设管道."
  ],
  "quest.76429142123E3A8D.quest_desc": [
    "&a土泥&r会对站在上面的目标造成2点伤害, 适合用作简易刷怪场地板.",
    "",
    "草可以蔓延到土泥上, 将其变成同样会造成伤害的&c刺嗷方块&r."
  ],
  "quest.5A811E99C409699F.quest_desc": [
    "&3工厂&r增强组件会将熔炉变成多槽位工厂, 改为消耗能量而非燃料.它最多可同时处理六组物品, 熔炉等级越高, 可用槽位越多.",
    "",
    "铁熔炉和铜熔炉可存80,000 FE,金熔炉和银熔炉可存200,000 FE,更高等级均为1,000,000 FE."
  ],
  "quest.1A829C51143D3EDA.title": "&a升力",
  "quest.509D7878283EC7AF.quest_desc": [
    "&3离子推进器&r是最强的升力设备.由大量方块组成的大型无人机需要装几个, 才能跟得上你."
  ],
  "quest.4EB87209B1EB584E.title": "&d零点",
  "quest.3FA19D4AC45FB458.quest_desc": [
    "&e更多熔炉&r中的每种熔炉都比原版更快.提示中会显示烹炼时间, &6下界合金熔炉&r每件物品只需5刻.",
    "",
    "升级熔炉无需拆除.手持升级套件, 潜行右键点击已放置的熔炉, 就能提升一个等级, 且无需清空内部物品."
  ],
  "quest.21252D2D8461718A.title": "&a禁止推销",
  "quest.41392AB326D113C1.quest_desc": [
    "&e新克隆&r可以培育备用身体.建好壳体并存放起来, 当你在一个身体中死亡时, 就能在另一个身体中醒来.",
    "",
    "放置&a壳体培育仓&r, 上方留出一格空间, 再空手右键点击, 提供基因样本.",
    "",
    "&c采样会消耗20点生命, 相当于整条生命值, 并会导致死亡.&r请先吃金苹果, 或拿好不死图腾.即使你死了, 壳体仍会开始培育."
  ],
  "quest.2C1F53BD5651CE4B.title": "&a热量升级",
  "quest.2202B2620A3F90D7.quest_desc": [
    "&a便携工作台&r就是能随身携带的工作台.将其放入对应饰品槽, 再按打开便携式工具的快捷键, 即可从轮盘中选择工作站.",
    "",
    "关闭界面后, 合成栏中的物品会保留.切石机, 锻造台, 铁砧, 织布机, 砂轮和制图台也都有木棍上的便携版本."
  ],
  "quest.4EB87209B1EB584E.quest_desc": [
    "&d零点&r版本完全不需要能量.存放仓会永久保存壳体, 培育仓则能瞬间完成一个壳体.",
    "",
    "采样消耗的生命值不变, 记得备好金苹果."
  ],
  "quest.77F457502E8EC957.quest_desc": [
    "将两个&a电梯&r放在同一竖直线上, 就能在两者之间移动.站在电梯上跳跃可上升, 潜行可下降, 最远384格, 无需颜色相同.",
    "",
    "手持方块右键点击电梯, 可将它伪装成该方块; 空手右键则打开设置菜单."
  ],
  "quest.2C1F53BD5651CE4B.quest_desc": [
    "给每台熔炉补煤很麻烦, 因此&e更多熔炉&r允许你用能量加热它们.",
    "",
    "制作一个&a无线热能供应器&r并输入FE.再制作一个&a无线热能接收器&r, 放入发射器中进行绑定.将接收器放进熔炉燃料槽后, 熔炉就会消耗储存的能量工作.",
    "",
    "每次充能从1,000,000 FE储能中取出2,000 FE,足够完成一次冶炼; 安装&2燃料效率&r增强组件后则为两次.接收器不会被消耗, 且只适用于铁级及以上熔炉.",
    "",
    "&e注意&r: 两件物品在物品栏中显示相同名称.能放置的是&a无线热能供应器&r, 提示中会说明需要建立连接."
  ],
  "quest.3FA19D4AC45FB458.title": "&e更多熔炉",
  "quest.4ED6DB305986636C.title": "&a备用身体",
  "quest.0B239918FC4D92ED.quest_desc": [
    "&a个人缩放装置&r充能后可以改变玩家体型.",
    "",
    "右键打开界面, Shift右键进行缩小或放大."
  ],
  "quest.2202B2620A3F90D7.title": "&a便携式工具",
  "quest.54FE9DA77DED738D.quest_desc": [
    "本章汇集了让日常生活更方便的小模组.它们都不是独立的发展路线, 挑选需要的功能即可.",
    "",
    "右侧是熔炉, 左侧是&eUtilitarian&r, 下方是&e新克隆&r, 上方是&e模块化无人机&r.四个角的任务各介绍一种随时可用的独立工具."
  ],
  "quest.66BB02961DF43CB7.title": "&a流体漏斗",
  "quest.21252D2D8461718A.quest_desc": [
    "流浪商人总爱出现在基地正中央.&a禁止推销旗帜&r能让他们避开周围6个区块的范围.",
    "",
    "如果还想保留商人服务, 又不想让他们到处乱跑, 可以放置&a商人地毯&r, 让新到的商人直接出现在地毯上.陷阱版本则会在商人到达时杀死他们."
  ],
  "quest.1A829C51143D3EDA.quest_desc": [
    "无人机需要旋翼才能飞行.&a木制旋翼&r提供10点推力, &2高级旋翼&r提供25点, &3离子推进器&r提供40点.",
    "",
    "&c如果旋翼下方一格或两格内有无人机方块, 该旋翼就不会提供推力.&r请保持旋翼下方空间畅通."
  ]
}
