{
  "task.5E0907252C228A2D.title": "&a铀球&r或&a钚球&r",
  "quest.033F3D2427ED6F40.quest_desc": [
    "用红石关闭机器, 并提供比较器读数."
  ],
  "quest.7791DA964DA2A80D.quest_desc": [
    "在控制器中放入任意物品作为粒子.将一个直线&a导向环&r横向放在控制器正后方.",
    "",
    "导向环决定路径, 右击可增加45度转向.环间距不能超过粒子当前速度所允许的范围.&2直线型马达&r消耗能量, 在粒子每次经过时加速."
  ],
  "quest.030F1F8A4B0C1EBF.quest_desc": [
    "&a散热口&r从相邻最热部件抽取并散出热量, 邻接部件越热, 散热越强.",
    "",
    "&a热管&r从燃料棒吸热, 再分配给周围散热口, 让一根燃料棒能同时利用多个散热口."
  ],
  "quest.4A5FD3641E0A566E.quest_desc": [
    "&a反应堆能量端口&r放在外墙上, 本包中每个最多输出75,000 RF/t.",
    "",
    "&a反应堆红石端口&r可以阻止加入新燃料, 但已经燃烧的燃料球会先烧完.配合比较器可读取能量, 工作中的燃料棒数量或温度, 右击切换."
  ],
  "quest.033F3D2427ED6F40.title": "&f红石控制单元",
  "quest.39EFBD54020011EF.title": "&6涡轮燃料",
  "quest.6CE7FB30455E939E.quest_desc": [
    "3级之后的插件在&dFTB制造机&r中制作, 各等级段分别需要达成里程碑.",
    "",
    "- &b4和5级&r: 先建造原子锻造器, 需要&2精金板&r.",
    "- &b6和7级&r: 先击败凋灵, 需要&a永恒金属板&r.",
    "- &b8和9级&r: 先解放末地, 需要&2奥利哈刚板&r.",
    "",
    "每次升级都需要前一级插件, 加上两个同种普通插件.",
    "",
    "&e注意&r: 持有原子锻造器, 超级AI芯片, 海森堡补偿器或高级计算引擎, 也能解锁第一个等级段."
  ],
  "quest.7A26B0FFC0BCA275.quest_desc": [
    "将激光器变成炮塔, 安装一, 二, 三个插件时, 范围分别为4.5,16.5或64.5格."
  ],
  "quest.539458FB0A93BE4B.title": "&b框架放置器",
  "quest.1770A460E1FD7CC8.quest_desc": [
    "一条直线马达可以将粒子射向目标, 但用环形轨道累积速度更高效.",
    "",
    "慢速粒子需要紧密排列的导向环, 因此先用小环加速, 再通过红石开关将速度提高的粒子引入更大的环.",
    "",
    "最快的粒子无法急转弯, 每个90度转角前都应留出较长直线."
  ],
  "quest.091B8E814908DEDF.title": "&d原子锻造器",
  "quest.0A6E103A6945D11E.quest_desc": [
    "奥瑞科技的机器由合金制成, 而&a铸造器&r就是合金的来源.",
    "",
    "它需要三个核心.先放铸造器, 右击查看核心位置, 放好后再次右击完成组装.",
    "",
    "&e注意&r: 本包的铸造器用金而非琥珀金制作, 因此不需要先有合金."
  ],
  "quest.692DC36FB22620DB.quest_desc": [
    "发电机装上&a蒸汽锅炉插件&r后, 不再产生RF,而是将水煮成蒸汽: 原本每1 RF/t的发电量, 转为每刻0.2 mB蒸汽.",
    "",
    "这样, 燃料发电机每刻可产生1,638 mB蒸汽.从插件方块输入水并输出蒸汽, 两个储罐各容纳128桶.",
    "{@pagebreak}",
    "本包的&e巨型反应堆&r涡轮机, 在计入线圈和叶片前, 每mB蒸汽产生9 RF.因此, 一台装有锅炉的燃料发电机给涡轮供汽, 基础约14,700 RF/t;使用最好的线圈与叶片时, 可达约47,000 RF/t.每片叶片最多处理48 mB/t,因此至少需要35片.",
    "",
    "将涡轮资源端口设为输入, 即可接收蒸汽."
  ],
  "quest.107B36DF506002D4.quest_subtitle": "能源的终极答案",
  "quest.0C9CD2D8F10D750F.quest_desc": [
    "用已供电的激光器照射&2紫水晶簇&r, 采收的将是&a通量水晶&r, 而非紫水晶.照射紫水晶母岩时, 晶簇几乎每刻都会生长.",
    "",
    "通量水晶, 处理器和铂锭在装配器中制成&a磁通门&r, 后期机器几乎都需要它.",
    "",
    "&e资源蜜蜂&r的辐水晶蜜蜂也是另一种来源."
  ],
  "quest.030F1F8A4B0C1EBF.title": "&c散热口与热管",
  "quest.0BAF0C06F01C4E80.title": "&f机器适配器插件",
  "quest.738AAB7C13A1C2CF.quest_desc": [
    "每个插件可储备240刻的8倍速运行时间.用尽后, 机器会略微减速, 直到储备恢复."
  ],
  "quest.727FC1D9337AAD8C.quest_desc": [
    "激光照向任意能储能的方块时, 每刻向其中输入128 RF,忽略方块自身的输入上限.",
    "",
    "多个激光器照向同一方块时, 供能会相加.无法连接线缆的原子锻造器就是这样供能的.每个钷锭需要245,760 RF,一个激光器约96秒, 四个约24秒.",
    "",
    "奥术触媒和基岩层钻机也以相同方式供能."
  ],
  "quest.33E4C81B762892B2.title": "&e奥瑞科技",
  "quest.7F70D7907F8EBA66.quest_desc": [
    "无人机港通常只能在同一维度内运货.",
    "",
    "在发送端无人机港安装&a跨维度插件&r.用&2高级目标标识器&r记录接收港, 它会同时保存维度和坐标, 再对发送港使用.之后, 只要港中有物品, 无人机就会跨维度送货.",
    "",
    "击败凋灵后, 可在FTB制造机中制作此插件."
  ],
  "quest.68760266CAAF9F8C.title": "&f精准采集插件",
  "quest.535666E7CDE3BD43.title": "&f协同矩阵",
  "quest.1582865EA8A8091B.quest_desc": [
    "机器可用的插件面, 总是比你的想法先用完.&e奥瑞科技 Things&r能把多个插件的功能压进一个面.",
    "",
    "制作任意一种&a2级插件&r.它相当于两个同种普通插件, 之后每级再增加一个, 最高9级.速度, 效率, 辅助加工室和储能量都遵循此规则, 机器容量与适配器的传输速率则增长较慢.",
    "",
    "2级在工作台制作, 3级在&2装配器&r中制作, 均需要前一级加两个普通插件."
  ],
  "quest.7791DA964DA2A80D.title": "&f加速器配置",
  "quest.2765AC7C3E0350FE.title": "&9生成生物",
  "quest.06DA083C1726EE4C.title": "&f矿场插件",
  "task.200DC63D1223B179.title": "任意&a反应堆棒&r",
  "quest.68760266CAAF9F8C.quest_desc": [
    "让激光器和方块破坏器获得精准采集, 替代产量升级效果."
  ],
  "quest.1B20BEE2BE4476A7.quest_desc": [
    "&a赛博改造中心&r直接为你的身体安装植入体, 共29种, 包括飞行, 护甲, 触及距离和物品磁铁等.",
    "",
    "它需要十个核心.走进组装好的机器打开界面, 先研究改造, 再支付列出的能量和物品进行安装.",
    "{@pagebreak}",
    "[\"\",\"按住\",{\"keybind\":\"key.oritech.augment_screen\",\"color\":\"yellow\",\"hover_event\":{\"action\":\"show_text\",\"value\":\"默认: G\"}},\",将鼠标移到改造项目上, 松开即可切换启用状态.\"]",
    "",
    "&c警告&r: 中心存储全部已研究蓝图, 破坏后研究会丢失, 不过已安装的改造可用导入按钮重新扫描."
  ],
  "quest.2A0BE00CE5037684.quest_desc": [
    "两种方块可以让粒子加速器更好用.",
    "",
    "&a加速器磁场&r帮助粒子通过急弯.将其放在环内, 再用已记录加速器的&2高级目标标识器&r连接.每台加速器只有一个磁场生效.",
    "",
    "&a粒子加速器速度传感器&r在粒子超过设定速度时输出红石信号, 连接方式相同.加速器马达下方还可安装速度和效率升级插件.",
    "",
    "&e注意&r: 此版本的磁场不能帮助粒子转弯, 速度传感器也不会输出信号. 这是模组本身的缺陷, 请等更新修复后再建造它们."
  ],
  "quest.7F186F5B5630DB4A.quest_desc": [
    "&a燃料发电机&r是奥瑞科技的大功率燃烧设备, 本包中可用任意油类燃料产生8,192 RF/t.",
    "",
    "它需要17个核心, JEI列出了所有可用流体及各自的燃烧时长.",
    "",
    "单独使用时, 它就是不错的发电机; 装上蒸汽锅炉插件后, 则能成为更大系统的前半部分."
  ],
  "task.765414790D7CA99B.title": "&a粗镍&r",
  "quest.2ECAD5F752E445F1.title": "{\"text\":\"钷\",\"color\":\"#FCD205\"}",
  "quest.06DA083C1726EE4C.quest_desc": [
    "激光束宽度增加一格, 或让方块破坏器挖掘深度变为八倍."
  ],
  "quest.77C53FD36F7747EA.title": "&d速子",
  "quest.7F186F5B5630DB4A.title": "&c燃料发电机",
  "quest.22B83D03C6C3E61E.quest_desc": [
    "工作速度提高50%,但每次操作的能耗增加20%."
  ],
  "quest.539458FB0A93BE4B.quest_desc": [
    "逐块搭建方块破坏器的框架, 很快就会让人厌烦.",
    "",
    "用&a框架放置器&r潜行右击框架机器, 设置尺寸后, 它会使用你携带的框架方块自动建造."
  ],
  "quest.39BC89942A5CA7E1.title": "&f效率升级插件",
  "quest.036C11AC70835846.quest_desc": [
    "&a末影激光器&r可在最远128格外传输能量, 采矿和培育水晶.",
    "",
    "先用&2目标标识器&r记录方块, 再对激光器使用以瞄准, 激光束可以穿过玻璃.",
    "",
    "&c警告&r: 激光运行时若移除目标, 它会沿原方向继续挖掘."
  ],
  "quest.091B8E814908DEDF.quest_subtitle": "钷, 铀与终局芯片",
  "quest.535666E7CDE3BD43.quest_desc": [
    "工作速度提高75%,每次操作却只增加10%能耗."
  ],
  "quest.0E0B4F549B42AF63.title": "&a反应堆棒",
  "quest.77C53FD36F7747EA.quest_desc": [
    "高速碰撞会向随机方向抛出&d速子&r, 碰撞越强, 速子携带能量越多, 飞行距离也越远.",
    "",
    "&a速子吸收器&r将其转化为RF,每个可存1,000,000 RF,且只从背面输出.",
    "",
    "在碰撞点四周布置吸收器来接住散射速子.高能碰撞时放远一些, 让速子分散到多个吸收器上."
  ],
  "quest.143E07D2565798AB.title": "&b机器核心",
  "quest.10AD11B1A8306AC9.title": "&6精炼厂",
  "quest.6697F832067F1A9C.title": "&d末影电磁炮",
  "quest.0A92084D7043133A.quest_desc": [
    "&a插件&r安装在机器的特定面上, 改变工作方式.机器的插件界面会显示哪些面可以安装.",
    "",
    "&a机器扩展坞&r增加可用的安装面.机器能使用的扩展坞数量取决于核心品质, 因此更好的核心意味着更多插件.",
    "",
    "本包中, 插件效果以相加方式叠加."
  ],
  "quest.67D437F7F6220BB5.quest_desc": [
    "还没建涡轮机?&a蒸汽机&r也能消耗相同的蒸汽.",
    "",
    "储罐约69%满时效率最佳, 可将90%的蒸汽返还为水, 主机每侧最多可串联20台蒸汽机.",
    "",
    "最佳状态下每mB约产生29 RF,因此巨型反应堆涡轮机运行起来后, 蒸汽用在那里更值钱."
  ],
  "quest.7A26B0FFC0BCA275.title": "&f生物校位插件",
  "quest.2C0C63951FDED180.title": "&d粒子加速器",
  "quest.2A0BE00CE5037684.title": "&d加速器升级",
  "quest.3AC24F0B92156F55.quest_desc": [
    "通往终局所需的大多数部件, 都在&a装配器&r中制作.",
    "",
    "它最多接受四种输入, 只要有电, 有材料且输出有空间, 就会持续合成, 需要三个核心.",
    "",
    "有些部件也有手工配方, 但比装配器版本消耗更多材料."
  ],
  "quest.45B55DF3A6745291.title": "&6外骨骼喷气背包",
  "quest.24CE908ED60FD514.quest_desc": [
    "&a磨粉机&r完全不需要核心, 因此是第一台真正的机器.",
    "",
    "它将矿石磨成粉, 也能将植物加工成生物质能发电机所需的&2生物质&r.",
    "",
    "&e注意&r: 本包磨粉机用末影粉而非末影珍珠制作&2末影化合物&r, 每次8份; 粉碎工厂仍能将一颗珍珠加工为12份."
  ],
  "task.0AE9E3C1553154B6.title": "任意&a机器核心&r",
  "quest.10AD11B1A8306AC9.quest_desc": [
    "原油是较弱的燃料, &a精炼厂&r能将它分离成更好的产物.",
    "",
    "单独使用时, 它把原油分成重油, 石脑油和硫酸; 加入&2黏土催化剂&r后, 则能直接从原油制得柴油.",
    "{@pagebreak}",
    "重油加沙子也能精炼为柴油, 因此最初分离的产物不会浪费.",
    "",
    "&e注意&r: 精炼厂自身只能输出第一种流体.顶部最多叠放两个&a精炼厂罐室模块&r, 才能取出第二, 第三种产物."
  ],
  "quest.2AB2C3ABF3F0EC71.title": "&6第九级",
  "quest.45B2C8BD2ACBA46D.title": "&f设计反应堆",
  "quest.0F3EDB9AE592016B.title": "&f机器容量插件",
  "quest.39EFBD54020011EF.quest_desc": [
    "柴油不错, &a涡轮燃料&r更好.",
    "",
    "在装有流体处理插件的离心机中, 1,000 mB柴油加一个&2通量水晶&r, 可制成1,000 mB涡轮燃料.",
    "",
    "燃料发电机中, 每mB原油可产1,638 RF,柴油6,554 RF,涡轮燃料26,214 RF.每刻输出不变, 更好的燃料只是烧得更久."
  ],
  "quest.0A92084D7043133A.title": "&b机器定制",
  "quest.2D48306B1E2F72B8.title": "&6原油从哪里来",
  "quest.39BC89942A5CA7E1.quest_desc": [
    "每次操作的能耗减少约17%."
  ],
  "quest.50B7CA94F8BB6F58.quest_desc": [
    "&a离心机&r需要一个核心, 用于分离物品, 例如将碎块加工为矿石宝石, 或从红石中提取少量铀粉.",
    "",
    "安装&a流体处理插件&r后, 也能处理流体.本包中储罐容量为64桶, 后期还要用它将柴油加工为涡轮燃料."
  ],
  "quest.0E0B4F549B42AF63.quest_desc": [
    "&a燃料棒&r从顶部的&2燃料口&r一直延伸到地板, 燃烧从该端口投入的燃料球.",
    "",
    "单棒产生1次内部脉冲, 双联4次, 四联12次.相邻燃料棒还会互相激发脉冲, 产生更多能量和热量.",
    "",
    "&2中子反射器&r将脉冲反射回燃料棒, 效果相当于旁边又有一根棒."
  ],
  "quest.2DCC43735EC5F60F.title": "&a最初的电力",
  "quest.2ECAD5F752E445F1.quest_desc": [
    "&a钷&r只能由原子锻造器制作, 也是它成本最高的产物.",
    "",
    "它用于制作&2终极机器核心&r和钷工具.本包中钷战斧伤害为10.5,潜行时还能整棵伐树."
  ],
  "quest.7F186F5B5630DB4A.quest_subtitle": "任意油类燃料, 8,192 RF/t",
  "quest.2AB2C3ABF3F0EC71.quest_desc": [
    "一个9级插件, 在单个面上相当于九个普通插件.",
    "",
    "制作一个吧.除了&2奥利哈刚板&r, 还需要一个&a终极机器核心&r."
  ],
  "quest.17B369A4BF64EE98.title": "&6突破极限",
  "quest.6CE7FB30455E939E.title": "&b制造机等级段",
  "quest.2DCC43735EC5F60F.quest_desc": [
    "奥瑞科技的机器使用RF,第一种电源很简单.",
    "",
    "制作&a基础发电机&r, 它能以64 RF/t燃烧任意熔炉燃料, 一组煤炭就能支持早期机器.",
    "",
    "下一步是&2生物质能发电机&r.它需要一个核心, 产生256 RF/t,磨粉机制作的每份&a生物质&r可提供128,000 RF."
  ],
  "quest.107B36DF506002D4.title": "&5黑洞",
  "quest.0A6E103A6945D11E.title": "&a铸造器",
  "quest.17B369A4BF64EE98.quest_desc": [
    "&a奥术触媒&r能让附魔突破正常等级上限.",
    "",
    "放入已经达到正常最高等级的附魔书及目标物品, 物品每秒提升一级.超过正常上限后, 附魔书会消耗, 每级需要更多灵魂, 但没有等级上限.",
    "{@pagebreak}",
    "触媒最初可容纳50个灵魂, RF能提高容量.每增加一个灵魂空间, 需要持续供应20 RF/t,最简单的办法是用末影激光器照射触媒.",
    "",
    "&c警告&r: 触媒持有的灵魂连续三秒超出容量, 就会爆炸."
  ],
  "quest.2D48306B1E2F72B8.quest_desc": [
    "本包所有油都与奥瑞科技原油视为同一种流体, 因此都能用于精炼厂和燃料发电机.",
    "",
    "- &2油泉&r: 奥瑞科技原油在主世界各处生成, 沙漠神殿附近更多.",
    "- &eNautec&r: &2嗜脂菌&r菌落产出&a藻类脂质&r, 搅拌机可将1份脂质和250 mB盐水变成1,000 mB原油.",
    "- &e资源蜜蜂&r: 在深海通过钓蜂捕获的&2油蜜蜂&r, 其蜜脾离心后产出50 mB原油."
  ],
  "quest.67D437F7F6220BB5.title": "&7蒸汽机",
  "quest.456030ECDFA9CE3B.quest_desc": [
    "&a热量吸收器&r每刻从所有相邻部件各吸收16点热量, 因此被高温部件包围时效果最好.",
    "",
    "它需要冰, 浮冰或蓝冰, 通过正上方外层顶部的&a冷却剂端口&r输入.无论冷却多少个面, 耗冰量都相同."
  ],
  "quest.107B36DF506002D4.quest_desc": [
    "让速度超过15,000的粒子从轨道末端飞出, 撞进传送门方块, 就会撕开一个&5黑洞&r.",
    "",
    "两个火焰弹以超过5,000的总速度碰撞会制造下界传送门, 两个末影珍珠以超过15,000的总速度碰撞会制造末地传送门, 因此加速器能自行制造目标.",
    "{@pagebreak}",
    "黑洞会吞噬16格内的方块, 并杀死接触它的一切.每吞一个方块, 最多释放五束速子射线, 吸收器每接到一束就获得50,000 RF.",
    "",
    "用方块放置器不断喂圆石, 它就成了一座发电厂.",
    "{@pagebreak}",
    "&c警告&r: 触及范围内的东西都会被吞掉.本包中可以用合适工具开采黑洞, 它会掉落自身, 因此能够搬运.",
    "",
    "[\"\",{\"text\":\"黑洞\",\"color\":\"aqua\",\"underlined\":true,\"click_event\":{\"action\":\"custom\",\"id\":\"ftbquests:docs\",\"payload\":{\"location\":\"guideme,oritech:guide,oritech:black_hole_generator.md\"}},\"hover_event\":{\"action\":\"show_text\",\"value\":\"打开黑洞指南页面\"}},\"中展示了可运行的发电装置.\"]"
  ],
  "quest.036C11AC70835846.title": "&d末地之力",
  "quest.13DFA7B0975971B7.title": "&e奥瑞科技附魔",
  "quest.143E07D2565798AB.quest_desc": [
    "每种多方块机器都会在物品提示中列出所需&a机器核心&r数量.放下控制器, 再手持核心右击, 即可填入标记的位置.",
    "",
    "先制作一组第一或第二级核心, 任意等级都能装进任意机器, 因此现在用便宜核心就行.",
    "{@pagebreak}",
    "共有七级.机器品质为所有核心等级的平均值, 决定它能使用多少&2扩展坞&r.更好的核心本身不会加快机器."
  ],
  "quest.3AC24F0B92156F55.title": "&d装配器",
  "quest.3D9FFFF325533514.quest_desc": [
    "让激光器和方块破坏器获得时运, 最多三级; 还能让粉碎工厂的副产物翻倍."
  ],
  "quest.2765AC7C3E0350FE.quest_desc": [
    "&a刷怪器控制器&r会复制第一个走过它的生物, 再在下方&2刷怪器笼&r围成的空间中生成更多.笼子大小取决于生物体型.",
    "",
    "每次生成消耗的灵魂数为生物生命值的平方根.右击控制器可查看笼子尺寸和状态.",
    "",
    "&e注意&r: 末影龙, 冰火传说生物及本包受保护的生物无法复制."
  ],
  "quest.727FC1D9337AAD8C.title": "&d激光阵列",
  "quest.0F3EDB9AE592016B.quest_desc": [
    "增加2,000,000 RF储能和2,000 RF/t输入."
  ],
  "quest.3F75F781DE5123F4.title": "&d核反应堆",
  "quest.7F70D7907F8EBA66.title": "&b跨越维度",
  "quest.7F7AF4C047AF4EFE.title": "&b高效速度",
  "quest.1E649B7D09AB54F5.quest_desc": [
    "&a粉碎工厂&r让矿物加工更进一步.",
    "",
    "它将矿石分解为碎块及副产物, 再由&2离心机&r将碎块变成矿石宝石.需要七个核心, 具有五个插件槽.",
    "",
    "粉碎工厂安装&2产量升级插件&r后, 副产物翻倍."
  ],
  "quest.2588279A071E5A6B.title": "&9收集灵魂",
  "quest.778A876616D4638E.title": "&f粒子传感器",
  "quest.61BF4B18F713FECD.title": "&f辅助加工室",
  "quest.50B7CA94F8BB6F58.title": "&a旋转制胜",
  "quest.692DC36FB22620DB.title": "&b全速蒸汽",
  "quest.1B20BEE2BE4476A7.title": "&d赛博改造中心",
  "quest.4A5FD3641E0A566E.title": "&2能量与红石端口",
  "quest.24CE908ED60FD514.title": "&a粉碎时间到",
  "quest.2588279A071E5A6B.quest_desc": [
    "奥瑞科技的奥术机器使用&b灵魂&r运行.",
    "",
    "任意生物死在灵魂收集方块23格内, 就会向其发送灵魂.种在灵魂土上的&2灵魂之花&r收获后, 也会释放一个灵魂.",
    "",
    "奥术触媒和刷怪器控制器都能收集, 灵魂总会飞向最近且仍有空间的设备."
  ],
  "quest.456030ECDFA9CE3B.title": "&b热量吸收器",
  "quest.778A876616D4638E.quest_desc": [
    "弯曲导向环收到红石信号时, 会变成开关, 让粒子直行.",
    "",
    "&a粒子加速器传感器&r读取粒子速度, 比较器将其转换为信号, 最低为0,最高信号对应速度15,000.",
    "",
    "粒子速度过快无法转弯, 或找不到下一个导向环时, 就会脱轨飞进世界."
  ],
  "quest.091B8E814908DEDF.quest_desc": [
    "&a原子锻造器&r制造其他设备做不到的东西: 硅晶圆, 铀石, AI芯片和钷.",
    "",
    "需要八个核心, 完全不接受线缆.每次合成都由照射它的末影激光器供能, 配方时间每刻消耗1,024 RF.",
    "",
    "更多激光器照射, 就能更快合成.",
    "",
    "&e注意&r: 建造它也会解锁FTB制造机中的4和5级插件."
  ],
  "quest.738AAB7C13A1C2CF.title": "&f脉冲超频插件",
  "quest.3D9FFFF325533514.title": "&f产量升级插件",
  "quest.61BF4B18F713FECD.quest_desc": [
    "可同时多运行一个配方, 能耗增加50%."
  ],
  "quest.45B2C8BD2ACBA46D.quest_desc": [
    "反应堆是用&a反应堆墙壁&r围成的长方体, 每个方向最多16格, 控制面板和能量端口嵌入墙壁.",
    "",
    "内部每层布局必须相同.3×3×3也能工作, 但5×5×5才有空间配置冷却.",
    "",
    "双联和四联棒每个燃料球能产出更多能量, 但也更难冷却."
  ],
  "quest.22B83D03C6C3E61E.title": "&f速度升级插件",
  "quest.13DFA7B0975971B7.quest_desc": [
    "&a稳定附魔器&r逐级施加你选择的附魔, 最高达到正常上限.",
    "",
    "16格内需要存有灵魂的&a奥术触媒&r, 数量等于附魔铁砧消耗值加上等级.每一步消耗512 RF和一个灵魂.",
    "",
    "触媒单独使用时, 还能做到远不止这些的事情."
  ],
  "quest.7F7AF4C047AF4EFE.quest_desc": [
    "速度插件使机器更快, 也更耗电.&a高效速度插件&r保留加速效果, 同时降低额外能耗.",
    "",
    "在FTB制造机中, 将同级速度与效率插件组合, 但解锁进度比其材料晚一个阶段.2和3级需原子锻造器, 4和5级需击败凋灵, 6至9级需解放末地."
  ],
  "quest.0C9CD2D8F10D750F.title": "&c磁通门",
  "quest.1E649B7D09AB54F5.title": "&a粉碎工厂",
  "quest.0BAF0C06F01C4E80.quest_desc": [
    "增加500,000 RF储能和5,000 RF/t输入, 且插件方块自身可以连接线缆."
  ],
  "quest.3F75F781DE5123F4.quest_desc": [
    "&a核反应堆控制面板&r运行由你逐格设计的反应堆.",
    "",
    "燃料从原子锻造器起步, 将粗铀变成铀石, 再用装配器压制为铀球.",
    "{@pagebreak}",
    "本包反应堆更小也更强, 最大边长16格, 可存500,000,000 RF,每个能量端口输出75,000 RF/t.",
    "",
    "&c警告&r: 燃料棒热量过久保持在4,000以上, 就会熔毁, 反应堆越大, 爆炸越强."
  ],
  "quest.1770A460E1FD7CC8.title": "&f加速器设计",
  "quest.33E4C81B762892B2.quest_desc": [
    "&e奥瑞科技&r的设备以多方块形式建造, 每台机器由一个控制器和周围若干&2机器核心&r组成, 侧面的插件使它更快, 更省或更智能.",
    "",
    "烧炼一些&a镍锭&r.从第一个核心到反应堆, 几乎所有奥瑞科技机器都需要镍.",
    "",
    "&e注意&r: 本包不生成奥瑞科技自带矿石.镍, 铀和铂都来自整合包自己的矿石生成, 铂在主世界, 下界和末地都有."
  ],
  "quest.1582865EA8A8091B.title": "&b分级插件",
  "quest.6697F832067F1A9C.quest_desc": [
    "&a末影电磁炮&r是随身携带的激光器, 可存5,000,000 RF,发射的激光会伤害路径中的一切, 或开采命中的方块.",
    "",
    "另一种发射模式是爆炸弹.潜行右击, 在采矿与战斗之间切换.",
    "",
    "瞄准能储能的方块时, 激光会为其充能, 而不是破坏."
  ],
  "quest.2C0C63951FDED180.quest_desc": [
    "&a粒子加速器&r通过物品碰撞制造新材料: 煤粉变钻石, 通量水晶和辐镍晶变成过充水晶, 最高速碰撞还能制造下界之星.",
    "",
    "每种碰撞都有最低能量要求, 等于两个粒子速度之和.JEI列出了各自的产物.",
    "",
    "碰撞需要两个控制器向同一条轨道发射粒子."
  ],
  "quest.45B55DF3A6745291.quest_desc": [
    "&a外骨骼喷气背包&r提供创造模式飞行.",
    "",
    "装备在胸部槽且电量超过10,000 RF时, 起跳进入空中即可自由飞行.落地, 进入水下或电量过低都会关闭飞行, 直到再次满足条件并腾空.",
    "",
    "解放末地后可在FTB制造机中制作, 需要&2奥利哈刚板&r."
  ]
}
