    {
      "source_path": "kubejs/assets/ftb/lang/en_us.json",
      "output_path": ".minecraft/kubejs/assets/ftb/lang/zh_cn.json",
      "key": "ftb.shopkeeper.locked.broker_late",
      "en": "The Vault opens only for those who have freed the End. Complete the Free the End quest and return.",
      "zh": "宝库只为解放末地的人开放. 完成解放末地任务后再来吧."
    },
    {
      "source_path": "kubejs/assets/ftb/lang/en_us.json",
      "output_path": ".minecraft/kubejs/assets/ftb/lang/zh_cn.json",
      "key": "ftb.shopkeeper.locked.village_storage",
      "en": "Show me you know your way around storage. Craft a Copper Backpack or better, or any storage tier upgrade.",
      "zh": "让我看看你对存储的了解. 制作铜背包或更高级的背包, 或任意存储等级升级."
    },
    {
      "source_path": "kubejs/assets/ftb/lang/en_us.json",
      "output_path": ".minecraft/kubejs/assets/ftb/lang/zh_cn.json",
      "key": "ftb.shopkeeper.locked.village_tech",
      "en": "I only deal with fellow tinkerers. Craft anything from one of the tech mods, like FTB Industrial Contraptions, Oritech, Ender IO or Powah.",
      "zh": "我只和同道工匠做生意. 制作任意科技模组的物品, 例如FTB工业奇械, 奥瑞科技, 末影接口或 Powah."
    },
    {
      "source_path": "kubejs/assets/ftb/lang/en_us.json",
      "output_path": ".minecraft/kubejs/assets/ftb/lang/zh_cn.json",
      "key": "ftb.shopkeeper.locked.village_food",
      "en": "You look half starved. Eat something first, then we can talk about food.",
      "zh": "你看起来饿坏了. 先吃点东西, 我们再聊食物."
    },
    {
      "source_path": "kubejs/assets/ftb/lang/en_us.json",
      "output_path": ".minecraft/kubejs/assets/ftb/lang/zh_cn.json",
      "key": "ftb.shopkeeper.locked.village_apiarist",
      "en": "I only trade with fellow beekeepers. Catch a bee in a Bee Cage and my wares are yours.",
      "zh": "我只和养蜂同行交易. 用蜜蜂笼捕捉一只蜜蜂, 就能购买我的货物."
    },
    {
      "source_path": "kubejs/assets/ftb/lang/en_us.json",
      "output_path": ".minecraft/kubejs/assets/ftb/lang/zh_cn.json",
      "key": "ftb.shopkeeper.locked.fishmonger",
      "en": "Catch something with a fishing rod first. I only sell to people who fish.",
      "zh": "先用钓鱼竿钓点东西. 我只卖货给钓鱼人."
    },
    {
      "source_path": "kubejs/assets/ftb/lang/en_us.json",
      "output_path": ".minecraft/kubejs/assets/ftb/lang/zh_cn.json",
      "key": "ftb.shopkeeper.locked.wayfarer",
      "en": "I only trade with travelers. Carry a Warp Stone, a Warp, Return or Bound Scroll, a Nature's or Explorer's Compass, or a Paraglider.",
      "zh": "我只和旅行者交易. 请携带传送石, 传送卷轴, 返回卷轴, 绑定卷轴, 自然罗盘, 探险者罗盘或滑翔伞之一."
    },
    {
      "source_path": "kubejs/assets/ftb/lang/en_us.json",
      "output_path": ".minecraft/kubejs/assets/ftb/lang/zh_cn.json",
      "key": "ftb.shopkeeper.locked.jewler",
      "en": "Build yourself a Jewelcrafting Station and I'll show you my gems.",
      "zh": "先制作一座珠宝加工台, 我就给你看看我的宝石."
    },
    {
      "source_path": "kubejs/assets/ftb/lang/en_us.json",
      "output_path": ".minecraft/kubejs/assets/ftb/lang/zh_cn.json",
      "key": "ftb.shopkeeper.locked.beastmaster",
      "en": "Carry a Bestiary so I know you study the beasts, then come back.",
      "zh": "带上异兽手记, 让我知道你研究过这些异兽, 再来找我."
    },
    {
      "source_path": "kubejs/assets/ftb/lang/en_us.json",
      "output_path": ".minecraft/kubejs/assets/ftb/lang/zh_cn.json",
      "key": "ftb.shopkeeper.locked.gatekeeper",
