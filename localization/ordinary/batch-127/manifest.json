{
  "batch": "127",
  "namespace": "fzzy_config",
  "jar": ".minecraft/mods/fzzy_config-0.7.7+26.1+neoforge.jar",
  "language_path": "assets/fzzy_config/lang/en_us.json",
  "target": ".minecraft/kubejs/assets/fzzy_config/lang/zh_cn.json",
  "include_keys": [
    "fc.validated_field.color.r",
    "fc.validated_field.color.g",
    "fc.validated_field.color.b",
    "fc.validated_field.color.a",
    "fc.keybind.ctrl",
    "fc.keybind.ctrl.shift",
    "fc.keybind.ctrl.shift.alt",
    "fc.keybind.ctrl.alt",
    "fc.keybind.shift",
    "fc.keybind.shift.alt",
    "fc.keybind.alt",
    "fc.keybind.resetting",
